@inject HRPortal.Services.EnvironmentSettingsService SettingsService
@{
    var cfg = await SettingsService.GetAsync();
    var company = cfg.System;
    var isAdmin = User.HasClaim("IsAdmin", "1");
    var isPerformancePage = Context.Request.Path.StartsWithSegments("/Performance") || Context.Request.Path.StartsWithSegments("/PerformanceAdmin") || Context.Request.Path.StartsWithSegments("/PerformanceReports") || Context.Request.Path.StartsWithSegments("/PerformanceSelf");
    bool Can(string permission) => isAdmin || User.HasClaim("Permission", permission);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@company.PrimaryColor" />
    <title>@ViewData["Title"] - @company.ApplicationName</title>
    @if (!string.IsNullOrWhiteSpace(company.FaviconUrl))
    {
        <link rel="icon" href="@company.FaviconUrl" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/performance.css")" asp-append-version="true" />
</head>
<body class="@(isPerformancePage ? "performance-module" : "")" style="--navy:@company.PrimaryColor;--navy2:@company.SecondaryColor;">
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">@company.ShortName</div>
            <div class="brand-text">
                <strong>@company.ApplicationName</strong>
                <small>@company.OrganizationName</small>
            </div>
        </div>

        <nav class="nav" aria-label="منوی اصلی پورتال">
            <div class="nav-caption">داشبورد</div>
            <a href="/">داشبورد</a>

            @if (Can("Employees.View") || Can("Settings.View"))
            {
                <details class="nav-group" data-nav-group="base">
                    <summary class="nav-group-heading">اطلاعات پایه</summary>
                    <div class="nav-group-links">
                        @if (Can("Employees.View")) { <a href="/Employees">مدیریت کارکنان</a> }
                        @if (Can("Settings.View")) { <a href="/SystemSettings#announcement-categories">دسته‌بندی اطلاعیه‌ها</a> }
                    </div>
                </details>
            }
            @if (Can("Organization.View"))
            {
                <details class="nav-group" data-nav-group="organization">
                    <summary class="nav-group-heading">ساختار سازمانی</summary>
                    <div class="nav-group-links"><a href="/Organization">ساختار سازمانی</a></div>
                </details>
            }
            @if (Can("Users.Manage") || Can("Roles.Manage") || Can("Announcements.Manage"))
            {
                <details class="nav-group" data-nav-group="management">
                    <summary class="nav-group-heading">مدیریت سامانه</summary>
                    <div class="nav-group-links">
                        @if (Can("Users.Manage") || Can("Roles.Manage")) { <a href="/Users">مدیریت کاربران و نقش‌ها</a> }
                        @if (Can("Announcements.Manage")) { <a href="/Announcements">مدیریت اطلاعیه‌ها</a> }
                    </div>
                </details>
            }
            @if (isAdmin)
            {
                <details class="nav-group" data-nav-group="account">
                    <summary class="nav-group-heading">حساب مدیر</summary>
                    <div class="nav-group-links"><a href="/Account/ChangePassword">تغییر رمز مدیر</a></div>
                </details>
            }
            else if (User.HasClaim("UserType", "Employee"))
            {
                <details class="nav-group" data-nav-group="account">
                    <summary class="nav-group-heading">حساب کاربری</summary>
                    <div class="nav-group-links"><a href="/Account/PersonalPassword">رمز عبور شخصی</a></div>
                </details>
            }
            @if (Can("Settings.View"))
            {
                <details class="nav-group" data-nav-group="settings">
                    <summary class="nav-group-heading">تنظیمات سامانه</summary>
                    <div class="nav-group-links"><a href="/SystemSettings">تنظیمات سامانه</a></div>
                </details>
            }
            @if (Can("Payroll.View") || User.HasClaim("UserType", "Employee"))
            {
                <details class="nav-group" data-nav-group="services">
                    <summary class="nav-group-heading">خدمات کارکنان</summary>
                    <div class="nav-group-links">
                        @if (Can("Payroll.View")) { <a href="/Payroll/Payslip">فیش حقوقی</a> }
                        @if (User.HasClaim("UserType", "Employee")) { <a href="/PerformanceSelf">کارنامه ارزیابی عملکرد من</a> }
                        @if (Can("PersonnelOrder.View")) { <a href="/PersonnelOrder">حکم کارگزینی</a> }
                    </div>
                </details>
            }
            @if (Can("Performance.View") || Can("Performance.Manage") || Can("Performance.Reports"))
            {
                <details class="nav-group" data-nav-group="performance">
                    <summary class="nav-group-heading">ماژول ارزیابی عملکرد کارکنان</summary>
                    <div class="nav-group-links">
                        @if (Can("Performance.View")) { <a href="/Performance">داشبورد و ارزیابی کارکنان</a> }
                        @if (Can("Performance.Manage")) { <a href="/PerformanceAdmin">دوره‌ها، حوزه‌ها و سؤالات ارزیابی</a> }
                        @if (Can("Performance.Reports")) { <a href="/PerformanceReports">گزارش‌های مدیریتی ارزیابی</a> }
                    </div>
                </details>
            }
        </nav>  </nav>

        <div class="sidebar-foot">
            @(isAdmin ? "مدیر سامانه" : "کاربر کارکنان")
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div>
                <div class="topbar-caption">@company.ApplicationName</div>
                <h2>@ViewData["Title"]</h2>
            </div>
            <div class="user-box">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>@User.Identity.Name</span>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button class="link" type="submit">خروج</button>
                    </form>
                }
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>
                @(string.IsNullOrWhiteSpace(company.FooterText) ? company.ApplicationName : company.FooterText)
                @if (!string.IsNullOrWhiteSpace(company.OrganizationName))
                {
                    <span> | @company.OrganizationName</span>
                }
            </span>
            <span class="build-version">Build @HRPortal.BuildInfo.Number</span>
        </footer>
    </div>
</div>
<script src="@Url.Content("~/js/portal-navigation.js")" asp-append-version="true" defer></script>
@RenderSection("Scripts", required: false)
</body>
</html>