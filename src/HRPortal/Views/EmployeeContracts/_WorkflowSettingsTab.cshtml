@model HRPortal.Models.ContractRenewalWorkflowSettingsViewModel
@{
    var canManageEvaluation = (bool?)ViewBag.CanManageEvaluation ?? false;
    var activeTab = (string?)ViewBag.ActiveTab ?? "questions";
}
<section id="workflow-settings" class="contract-tab-panel @((!canManageEvaluation || activeTab == "workflow-settings") ? "active" : "")">
    <div class="card contract-settings-note">
        <strong>تنظیم مراحل ثابت گردش تمدید قرارداد</strong>
        <p>پس از ثبت درخواست، جایگاه تأییدکننده اطلاعات اولیه آن را بررسی می‌کند. سپس ارزشیابی پویا از رده سرپرستی به بالا و مطابق زنجیره واقعی ساختار سازمانی تا آخرین جایگاه پیش از مدیرعامل انجام می‌شود. پس از آن مراحل ثابت حراست، منابع انسانی و تصمیم نهایی مدیرعامل اجرا خواهند شد.</p>
        <p class="muted">در زنجیره ارزشیابی، اگر جایگاهی متصدی فعال نداشته باشد، سامانه به‌صورت خودکار از آن عبور می‌کند و پس از ثبت درخواست، عنوان جایگاه‌های خالی را به ثبت‌کننده اعلام می‌کند. این رفتار در گردش اختصاصی تمدید قرارداد ثابت است و از تنظیمات عمومی مراحل گردش کار تبعیت نمی‌کند.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert error">@Model.ErrorMessage</div>
    }

    <form method="post" action="/EmployeeContracts/SaveWorkflowSettings" class="card form-stack contract-settings-form">
        @Html.AntiForgeryToken()
        <label>جایگاه تأییدکننده اطلاعات اولیه درخواست *
            <select name="requestApprovalPositionId" required>
                <option value="">انتخاب جایگاه</option>
                @foreach (var p in Model.Positions)
                {
                    <option value="@p.Id" selected="@(Model.Settings.RequestApprovalPositionId == p.Id)">@p.Title — @p.RankType (@p.Code)</option>
                }
            </select>
            <small class="muted">پس از ثبت درخواست، این جایگاه اطلاعات را تأیید می‌کند یا برای اصلاح به ثبت‌کننده برمی‌گرداند.</small>
        </label>
        <label>جایگاه مدیر حراست *
            <select name="securityPositionId" required>
                <option value="">انتخاب جایگاه</option>
                @foreach (var p in Model.Positions)
                {
                    <option value="@p.Id" selected="@(Model.Settings.SecurityPositionId == p.Id)">@p.Title — @p.RankType (@p.Code)</option>
                }
            </select>
        </label>
        <label>جایگاه مدیر منابع انسانی و خدمات پشتیبانی *
            <select name="humanResourcesPositionId" required>
                <option value="">انتخاب جایگاه</option>
                @foreach (var p in Model.Positions)
                {
                    <option value="@p.Id" selected="@(Model.Settings.HumanResourcesPositionId == p.Id)">@p.Title — @p.RankType (@p.Code)</option>
                }
            </select>
        </label>
        <div class="contract-ceo-resolution">
            <strong>مسئول نهایی: مدیرعامل تعریف‌شده در ساختار سازمانی</strong>
            @if (Model.ChiefExecutiveEmployee is not null)
            {
                <p>@Model.ChiefExecutiveEmployee.FirstName @Model.ChiefExecutiveEmployee.LastName — شماره پرسنلی @Model.ChiefExecutiveEmployee.PersonnelNumber</p>
                <small class="muted">کارمند از طریق جایگاه سازمانی با رده مدیرعامل شناسایی می‌شود و انتخاب دستی ندارد.</small>
            }
            else
            {
                <p class="error-text">در نسخه نهایی ساختار باید دقیقاً یک گره فعال مدیرعامل وجود داشته باشد و به دقیقاً یک کارمند فعال اختصاص یابد.</p>
                <a href="/Employees">رفتن به مدیریت کارکنان</a>
            }
        </div>
        <div class="actions">
            <button class="btn btn-main" type="submit">ذخیره تنظیمات مراحل ثابت</button>
        </div>
    </form>
</section>
