@model HRPortal.Controllers.AccountController.LoginVm
@{Layout=null;}<html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ورود - پورتال جامع منابع انسانی</title><link rel="stylesheet" href="~/css/site.css"></head><body class="login-page"><div class="login-card"><div class="brand">پورتال جامع منابع انسانی</div><h2>ورود به سامانه</h2><p>شماره پرسنلی خود را وارد کنید. کد ورود به شماره همراه ثبت‌شده ارسال می‌شود.</p><form method="post">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@Model.returnUrl"><label>شماره پرسنلی<input name="PersonnelNumber" autofocus autocomplete="username"></label><button class="btn btn-main">ارسال کد ورود</button></form></div></body></html>