@model HRPortal.Controllers.AccountController.PersonalPasswordVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "رمز عبور شخصی";
    var isOtpSession = string.Equals(User.FindFirst("LoginMethod")?.Value, "Otp", StringComparison.OrdinalIgnoreCase);
}
<div class="narrow-page">
    <div class="page-head">
        <div>
            <h1>@(Model.HasExistingPassword ? "تغییر رمز عبور شخصی" : "تعیین رمز عبور شخصی")</h1>
            <p>رمز عبور شخصی برای ورودهای بعدی شما با نام کاربری (کد پرسنلی) استفاده می‌شود.</p>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert error">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <div class="card">
        <form method="post" class="form-stack">
            @Html.AntiForgeryToken()

            @if (Model.CurrentPasswordRequired)
            {
                <label>
                    رمز عبور فعلی
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
                </label>
            }
            else if (Model.HasExistingPassword && isOtpSession)
            {
                <div class="note">چون این بار با رمز یکبارمصرف وارد شده‌اید، برای تغییر رمز شخصی نیازی به وارد کردن رمز فعلی نیست.</div>
            }

            <label>
                رمز عبور شخصی جدید
                <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
            </label>

            <label>
                تکرار رمز عبور شخصی جدید
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
            </label>

            <div class="note">رمز عبور شخصی باید حداقل ۶ کاراکتر داشته باشد و می‌تواند فقط شامل عدد، فقط شامل حروف، ترکیبی از هر دو یا همراه با علامت‌ها باشد.</div>

            <div class="form-actions">
                <button class="btn btn-main" type="submit">ذخیره رمز شخصی</button>
                <a class="btn btn-outline" href="/">انصراف</a>
            </div>
        </form>
    </div>
</div>