@model HRPortal.Controllers.AccountController.LoginVm
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "ورود";
    var adminMode = string.Equals(Model.Mode, "admin", StringComparison.OrdinalIgnoreCase);
    var employeePasswordMode = string.Equals(Model.Mode, "employee-password", StringComparison.OrdinalIgnoreCase);
}
<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-logo">HR</div>
            <div><strong>پورتال جامع منابع انسانی</strong><span>سامانه خدمات کارکنان</span></div>
        </div>
        <div class="login-tabs">
            <button type="button" class="login-tab @(adminMode ? "" : "active")" data-mode="employee">ورود کارکنان</button>
            <button type="button" class="login-tab @(adminMode ? "active" : "")" data-mode="admin">ورود مدیر سامانه</button>
        </div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert error">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert error">@TempData["Error"]</div>
        }
        <div id="employeePanel" class="login-panel @(adminMode ? "hidden" : "")">
            <div class="auth-intro"><h1>ورود کارکنان</h1><p>روش ورود را انتخاب کنید.</p></div>
            <div class="login-tabs">
                <button type="button" class="login-tab @(employeePasswordMode ? "" : "active")" data-employee-login-mode="otp">رمز یکبارمصرف</button>
                <button type="button" class="login-tab @(employeePasswordMode ? "active" : "")" data-employee-login-mode="password">نام کاربری و رمز شخصی</button>
            </div>
            <div id="employeeOtpPanel" class="login-panel @(employeePasswordMode ? "hidden" : "")">
                <div class="auth-intro"><h2>ورود با رمز یکبارمصرف</h2><p>شماره پرسنلی را وارد کنید تا کد یکبارمصرف برای موبایل ثبت‌شده ارسال شود.</p></div>
                <form method="post" action="/Account/EmployeeLogin" class="login-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    <label>شماره پرسنلی<input name="PersonnelNumber" value="@Model.PersonnelNumber" autocomplete="username" inputmode="numeric" autofocus="@(!adminMode && !employeePasswordMode)" required /></label>
                    <button type="submit" class="btn btn-main btn-block">ارسال کد ورود</button>
                </form>
            </div>
            <div id="employeePasswordPanel" class="login-panel @(employeePasswordMode ? "" : "hidden")">
                <div class="auth-intro"><h2>ورود با رمز شخصی</h2><p>نام کاربری همان کد پرسنلی است.</p></div>
                <form method="post" action="/Account/EmployeePasswordLogin" class="login-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    <label>نام کاربری (کد پرسنلی)<input name="PersonnelNumber" value="@Model.PersonnelNumber" autocomplete="username" autofocus="@employeePasswordMode" required /></label>
                    <label>رمز عبور شخصی<input type="password" name="Password" autocomplete="current-password" required /></label>
                    <button type="submit" class="btn btn-main btn-block">ورود به سامانه</button>
                </form>
            </div>
        </div>
        <div id="adminPanel" class="login-panel @(adminMode ? "" : "hidden")">
            <div class="auth-intro"><h1>ورود مدیر سامانه</h1><p>نام کاربری و رمز عبور حساب مدیر سامانه را وارد کنید.</p></div>
            <form method="post" action="/Account/AdminLogin" class="login-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <label>نام کاربری<input name="Username" value="@Model.Username" autocomplete="username" autofocus="@adminMode" required /></label>
                <label>رمز عبور<input type="password" name="Password" autocomplete="current-password" required /></label>
                <button type="submit" class="btn btn-main btn-block">ورود مدیر</button>
            </form>
        </div>
        <div class="auth-note">کارکنان در هر ورود می‌توانند بین رمز یکبارمصرف و رمز شخصی انتخاب کنند.</div>
        <div class="login-build-version">Build @HRPortal.BuildInfo.Number</div>
    </div>
</div>
@section Scripts {
<script>
(function () {
    const tabs = document.querySelectorAll('.login-tab[data-mode]');
    const employeeTabs = document.querySelectorAll('.login-tab[data-employee-login-mode]');
    const employee = document.getElementById('employeePanel');
    const admin = document.getElementById('adminPanel');
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            const isAdmin = tab.dataset.mode === 'admin';
            tabs.forEach(function (x) { x.classList.toggle('active', x === tab); });
            employee.classList.toggle('hidden', isAdmin);
            admin.classList.toggle('hidden', !isAdmin);
        });
    });

    const otp = document.getElementById('employeeOtpPanel');
    const password = document.getElementById('employeePasswordPanel');
    employeeTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            const isPassword = tab.dataset.employeeLoginMode === 'password';
            employeeTabs.forEach(function (x) { x.classList.toggle('active', x === tab); });
            otp.classList.toggle('hidden', isPassword);
            password.classList.toggle('hidden', !isPassword);
        });
    });
})();
</script>
}
