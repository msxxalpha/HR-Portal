#contractScoreTotalBottom { color:#102b49; font-size:1.22rem; font-weight:900; font-variant-numeric:tabular-nums; }
.contract-score-input.is-invalid { border:1.5px solid #d36b6b !important; box-shadow:0 0 0 2px rgba(211,107,107,.16); background:#fffafa !important; }
