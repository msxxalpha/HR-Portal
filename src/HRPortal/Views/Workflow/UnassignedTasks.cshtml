@model List<HRPortal.Models.UnassignedWorkflowTaskRow>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "وظایف نیازمند تعیین مسئول";
    var employees = ViewBag.ActiveEmployees as List<HRPortal.Models.Employee> ?? [];
    var definitions = ViewBag.WorkflowDefinitions as List<HRPortal.Models.WorkflowDefinition> ?? [];
}
<div class="page-head">
    <div>
        <h1>وظایف نیازمند تعیین مسئول</h1>
        <p>وظایف باز فاقد جایگاه معتبر یا متصدی فعال؛ اصلاح تخصیص بدون حذف وظیفه و سوابق گردش کار.</p>
    </div>
    <a class="btn btn-outline" href="/Workflow/Inbox">بازگشت به کارتابل</a>
</div>
@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
<div class="workflow-stats">
    <div class="stat"><span>وظایف نیازمند پیگیری</span><strong>@Model.Count</strong></div>
    <div class="stat"><span>جایگاه ناموجود</span><strong>@Model.Count(x => x.ReasonCode == "PositionMissing")</strong></div>
    <div class="stat"><span>بدون متصدی فعال</span><strong>@Model.Count(x => x.ReasonCode == "NoActiveHolder")</strong></div>
    <div class="stat"><span>تخصیص نامعتبر</span><strong>@Model.Count(x => x.ReasonCode is "InvalidAssignment" or "EmployeeMissing")</strong></div>
</div>
<section class="card">
    <form method="get" class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));align-items:end">
        <label>جستجو<input type="search" name="q" value="@ViewBag.Search" placeholder="درخواست، متقاضی، مرحله یا جایگاه" /></label>
        <label>علت بلاتکلیفی
            <select name="reason">
                <option value="">همه علت‌ها</option>
                <option value="PositionMissing" selected="@(ViewBag.Reason as string == "PositionMissing")">جایگاه ناموجود</option>
                <option value="NoActiveHolder" selected="@(ViewBag.Reason as string == "NoActiveHolder")">بدون متصدی فعال</option>
                <option value="InvalidAssignment" selected="@(ViewBag.Reason as string == "InvalidAssignment")">تخصیص جایگاه نامعتبر</option>
                <option value="EmployeeMissing" selected="@(ViewBag.Reason as string == "EmployeeMissing")">کارمند مستقیم نامعتبر</option>
            </select>
        </label>
        <label>نوع گردش کار
            <select name="workflowId">
                <option value="">همه گردش‌ها</option>
                @foreach (var item in definitions)
                {
                    <option value="@item.Id" selected="@(ViewBag.WorkflowId?.ToString() == item.Id.ToString())">@item.Title</option>
                }
            </select>
        </label>
        <label>مرحله
            <input type="search" name="step" value="@ViewBag.Step" placeholder="عنوان مرحله" />
        </label>
        <label>جایگاه
            <input type="search" name="position" value="@ViewBag.Position" placeholder="عنوان یا کد جایگاه" />
        </label>
        <label>از تاریخ ایجاد
            <input type="date" name="createdFrom" value="@ViewBag.CreatedFrom" />
        </label>
        <label>تا تاریخ ایجاد
            <input type="date" name="createdTo" value="@ViewBag.CreatedTo" />
        </label>
        <button class="btn btn-main" type="submit">اعمال فیلتر</button>
    </form>
</section>
<section class="card">
    <div class="section-head"><h3>فهرست وظایف باز</h3><span class="muted">@Model.Count مورد</span></div>
    @if (Model.Count == 0)
    {
        <div class="empty">وظیفه بلاتکلیف مطابق فیلترهای انتخابی یافت نشد.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>گردش / درخواست</th><th>درخواست‌کننده</th><th>مرحله</th><th>جایگاه</th><th>تاریخ ایجاد</th><th>علت</th><th>تعیین مسئول</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.WorkflowTitle</strong><div class="muted">@item.EntityType #@item.EntityId</div><div class="muted">شناسه وظیفه: @item.TaskId</div></td>
                        <td>@item.RequesterName</td>
                        <td>@item.StepTitle</td>
                        <td>@item.PositionTitle<div class="muted">@item.PositionCode</div></td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                        <td><span class="badge badge-warning">@item.Reason</span></td>
                        <td>
                            <form method="post" action="/Workflow/ReassignUnassignedTask" class="form-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.TaskId" />
                                <select name="employeeId" required>
                                    <option value="">انتخاب کارمند فعال</option>
                                    @foreach (var employee in employees)
                                    {
                                        <option value="@employee.Id">@employee.FirstName @employee.LastName (@employee.PersonnelNumber)</option>
                                    }
                                </select>
                                <button class="btn btn-main btn-sm" type="submit">واگذاری</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
