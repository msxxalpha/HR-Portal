@model List<HRPortal.Models.ServiceRequestReportTypeItem>
@{
    ViewData["Title"] = "گزارش‌ها و داشبورد درخواست‌ها";
    var reportTypes = Model ?? new List<HRPortal.Models.ServiceRequestReportTypeItem>();
}
<div class="outsourced-page outsourced-reports-catalog">
    <div class="outsourced-hero">
        <div class="outsourced-hero-icon">▥</div>
        <div>
            <span>خدمات کارکنان / ماژول درخواست‌ها</span>
            <h1>گزارش‌ها و داشبورد درخواست‌ها</h1>
            <p>گزارش‌ها بر اساس نوع درخواست دسته‌بندی شده‌اند. با اضافه شدن فرایندهای جدید، داشبورد اختصاصی هر نوع درخواست در همین صفحه در دسترس قرار می‌گیرد.</p>
        </div>
    </div>

    @if (reportTypes.Count == 0)
    {
        <section class="outsourced-list-card outsourced-empty">
            <h3>در حال حاضر داشبوردی برای نمایش وجود ندارد.</h3>
        </section>
    }
    else
    {
        @foreach (var category in reportTypes.GroupBy(x => x.Category).OrderBy(x => x.Key))
        {
            <section class="outsourced-list-card request-report-category">
                <div class="outsourced-list-head">
                    <div>
                        <small>دسته‌بندی گزارش‌ها بر اساس حوزه</small>
                        <h2>@category.Key</h2>
                    </div>
                    <strong>@category.Count() نوع درخواست</strong>
                </div>
                <div class="request-report-type-grid">
                    @foreach (var item in category.OrderBy(x => x.Title))
                    {
                        <a class="request-report-type-card" href="@item.Url">
                            <span class="request-report-type-icon">@item.Icon</span>
                            <span class="request-report-type-category">@item.Category</span>
                            <strong>@item.Title</strong>
                            <p>@item.Description</p>
                            <span class="request-report-type-open">مشاهده داشبورد <b>←</b></span>
                        </a>
                    }
                </div>
            </section>
        }
    }
</div>
