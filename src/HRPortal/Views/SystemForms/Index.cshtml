@model List<HRPortal.Models.SystemFormDefinition>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "مدیریت فرم‌ها";
}
<div class="page-head">
    <div><h1>مدیریت فرم‌ها</h1><p>ثبت فرم‌های عملیاتی و تعیین نوع اجرای آن‌ها؛ فرم‌های اختصاصی از موتور گردش کار عمومی مستقل می‌مانند.</p></div>
</div>
@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
<section class="card">
    <div class="section-head"><h3>فرم‌های ثبت‌شده در سامانه</h3></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>کد سیستمی</th><th>عنوان فرم</th><th>نوع پیاده‌سازی</th><th>فعال</th><th>توضیحات</th><th>عملیات</th></tr></thead>
            <tbody>
            @foreach (var form in Model)
            {
                <tr>
                    <td>@form.Code</td><td>@form.Title</td>
                    <td>
                        <form method="post" action="/SystemForms/Save" class="form-stack">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@form.Id" />
                            <input type="hidden" name="code" value="@form.Code" />
                            <input type="hidden" name="title" value="@form.Title" />
                            <select name="implementationType" disabled="@(form.ImplementationType == "Custom")">
                                <option value="Custom" selected="@(form.ImplementationType == "Custom")">اختصاصی و مستقل</option>
                                <option value="GenericWorkflow" selected="@(form.ImplementationType == "GenericWorkflow")">قابل اتصال به گردش کار عمومی</option>
                                <option value="Standalone" selected="@(form.ImplementationType == "Standalone")">ساده و مستقل</option>
                            </select>
                            @if (form.ImplementationType == "Custom") { <input type="hidden" name="implementationType" value="Custom" /> }
                            <label class="check-chip"><input type="checkbox" name="isActive" value="true" checked="@form.IsActive" /> فعال</label>
                            <input type="hidden" name="description" value="@form.Description" />
                            <button class="btn btn-outline btn-sm" type="submit">ذخیره وضعیت</button>
                        </form>
                        @if (form.ImplementationType == "Custom") { <small class="muted">این فرم با منطق اختصاصی اجرا می‌شود و قابل اتصال به موتور عمومی نیست.</small> }
                    </td>
                    <td>@(form.IsActive ? "فعال" : "غیرفعال")</td>
                    <td>@form.Description</td>
                    <td>
                        <form method="post" action="/SystemForms/Save" class="form-stack">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@form.Id" />
                            <input type="hidden" name="code" value="@form.Code" />
                            <input type="hidden" name="implementationType" value="@form.ImplementationType" />
                            <input type="hidden" name="isActive" value="@form.IsActive.ToString().ToLowerInvariant()" />
                            <label>عنوان<input name="title" value="@form.Title" required maxlength="200" /></label>
                            <label>توضیحات<input name="description" value="@form.Description" maxlength="1000" /></label>
                            <button class="btn btn-outline btn-sm" type="submit">ذخیره عنوان</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="muted">فرم تمدید قرارداد ارزشیابی به‌صورت اختصاصی اجرا می‌شود. برای فرم ساده جدید ابتدا باید فرم عملیاتی آن پیاده‌سازی و ثبت شود؛ ثبت در این فهرست به‌تنهایی فرم اجرایی ایجاد نمی‌کند.</p>
</section>
<section class="card form-stack">
    <h3>ثبت فرم جدید</h3>
    <form method="post" action="/SystemForms/Save" class="form-stack">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="0" />
        <div class="grid-2">
            <label>کد سیستمی (ثابت و یکتا)<input name="code" required maxlength="100" placeholder="TravelRequest" /></label>
            <label>عنوان فرم<input name="title" required maxlength="200" /></label>
            <label>نوع پیاده‌سازی<select name="implementationType"><option value="Standalone">ساده و مستقل</option><option value="GenericWorkflow">قابل اتصال به گردش کار عمومی</option></select></label>
            <label class="check-chip"><input type="checkbox" name="isActive" value="true" checked /> فعال</label>
        </div>
        <label>توضیحات<textarea name="description" rows="2" maxlength="1000"></textarea></label>
        <button class="btn btn-main" type="submit">ثبت فرم</button>
    </form>
</section>
