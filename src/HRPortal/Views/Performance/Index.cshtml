@model HRPortal.Controllers.PerformanceController.DashboardVm
@using HRPortal.Modules.Performance
@{
    ViewData["Title"] = "ماژول ارزیابی عملکرد کارکنان";
    var canEvaluate = User.HasClaim("IsAdmin", "1") || User.HasClaim("Permission", PerformanceModule.EvaluatePermission);
}
<h2>داشبورد ارزیابی عملکرد کارکنان</h2>
<p class="text-muted">اطلاعات کارکنان و هویت ارزیاب از پورتال منابع انسانی دریافت می‌شود؛ ارزیابی‌های ثبت‌شده در دوره‌های بسته فقط قابل مشاهده هستند.</p>
@if (TempData["Result"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<section class="card p-3 mb-3">
    <form method="get" action="/Performance" class="d-flex align-items-center flex-wrap gap-2">
        <label for="performance-period">دوره ارزیابی</label>
        <select id="performance-period" name="periodId" class="form-select" onchange="this.form.submit()">
            @foreach (var period in Model.Periods)
            {
                <option value="@period.Id" selected="@(period.Id == Model.Selected?.Id)">@period.Title — @(PerformanceService.IsEditable(period, DateTime.Now) ? "باز" : "بسته")</option>
            }
        </select>
        <button class="btn btn-outline-primary" type="submit">نمایش</button>
    </form>
</section>

@if (Model.Selected is null)
{
    <div class="card p-4">هنوز دوره ارزیابی تعریف نشده است. مدیر سامانه می‌تواند دوره و تخصیص ارزیاب را در مدیریت ماژول ایجاد کند.</div>
}
else
{
    <div class="row g-3 mb-3 perf-metric-grid">
        <div class="col-md-3"><div class="card p-3"><small>تعداد افراد تخصیص‌یافته</small><h3>@Model.TotalAssignments</h3></div></div>
        <div class="col-md-3"><div class="card p-3"><small>مجموع سقف امتیازات</small><h3>@Model.TotalMax.ToString("N2")</h3></div></div>
        <div class="col-md-3"><div class="card p-3"><small>امتیاز استفاده‌شده</small><h3>@Model.TotalScore.ToString("N2")</h3></div></div>
        <div class="col-md-3"><div class="card p-3"><small>مجموع امتیاز کسرشده</small><h3>@Model.Deducted.ToString("N2")</h3></div></div>
    </div>
    @if (canEvaluate && PerformanceService.IsEditable(Model.Selected, DateTime.Now) && Model.TotalAssignments > 0)
    {
        <form method="post" action="/Performance/QuickEvaluateAll" class="mb-3"
              onsubmit="return confirm('همه افراد فاقد ارزیابی با سقف کامل امتیازدهی می‌شوند؛ امتیازهای قبلی تغییری نخواهد کرد. ادامه می‌دهید؟');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="periodId" value="@Model.Selected.Id" />
            <button type="submit" class="btn btn-primary">ارزیابی سریع تمام افراد فاقد امتیاز</button>
        </form>
    }
    <div class="card p-3">
        <h3>افراد تحت ارزیابی</h3>
        <form method="get" action="/Performance" class="d-flex align-items-center gap-2 flex-wrap mb-2">
            <input type="hidden" name="periodId" value="@Model.Selected.Id" />
            <input class="form-control" name="q" value="@Model.Search" placeholder="جست‌وجوی نام، پرسنلی یا رده..." />
            <select class="form-select" name="pageSize" onchange="this.form.submit()">
                <option value="25" selected="@(Model.PageSize==25)">25 ردیف</option>
                <option value="50" selected="@(Model.PageSize==50)">50 ردیف</option>
                <option value="75" selected="@(Model.PageSize==75)">75 ردیف</option>
                <option value="100" selected="@(Model.PageSize==100)">100 ردیف</option>
            </select>
            <button class="btn btn-outline-primary" type="submit">جست‌وجو</button>
            <span>تعداد: @Model.FilteredCount</span>
        </form>
        @{var totalPages = Math.Max(1,(int)Math.Ceiling(Model.FilteredCount/(double)Model.PageSize));}
        @await Html.PartialAsync("_PerformancePagination", (Model.Page,totalPages,Model.PageSize,Model.Search,"/Performance", (int?)Model.Selected.Id))
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>شماره پرسنلی</th><th>نام و نام خانوادگی</th><th>رده ارزیابی</th><th>امتیاز نهایی</th><th>سقف امتیاز</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                <tbody>
                @foreach(var row in Model.Rows)
                {
                    <tr>
                        <td>@row.PersonnelNumber</td>
                        <td>@row.EmployeeName</td>
                        <td>@row.Position</td>
                        <td>@row.Score.ToString("N2")</td>
                        <td>@row.MaxScore.ToString("N2")</td>
                        <td>@(row.EvaluationId.HasValue ? "ارزیابی‌شده" : "ثبت‌نشده")</td>
                        <td><a class="btn btn-sm btn-outline-primary" href="/Performance/Form?periodId=@Model.Selected.Id&amp;employeeId=@row.EmployeeId">@(row.EvaluationId.HasValue ? "جزئیات" : "ارزیابی")</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_PerformancePagination", (Model.Page,totalPages,Model.PageSize,Model.Search,"/Performance", (int?)Model.Selected.Id))
        @if (Model.TotalAssignments == 0) { <p>هیچ کارمندی در این دوره به حساب شما برای ارزیابی تخصیص داده نشده است.</p> }
    </div>
}
