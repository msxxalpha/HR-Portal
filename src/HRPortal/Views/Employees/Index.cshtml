@model IEnumerable<HRPortal.Models.Employee>
@{ViewData["Title"]="مدیریت کارکنان";}
<div class="page-head"><div><h1>مدیریت کارکنان</h1><p>ثبت، ویرایش، غیرفعال‌سازی، فیلتر، مرتب‌سازی و تبادل اکسل</p></div><div class="actions"><a class="btn btn-main" href="/Employees/Create">+ کارمند جدید</a><a class="btn btn-outline" href="/Employees/Import">ورود از اکسل</a><a class="btn btn-outline" href="/Employees/Export?q=@ViewBag.Q&status=@ViewBag.Status">خروجی اکسل</a></div></div>
<form class="filterbar" method="get"><input name="q" value="@ViewBag.Q" placeholder="جستجو: پرسنلی، کد ملی، نام، موبایل"><select name="status"><option value="">همه وضعیت‌ها</option><option selected="@(ViewBag.Status=="فعال")">فعال</option><option selected="@(ViewBag.Status=="غیرفعال")">غیرفعال</option></select><button class="btn btn-main">اعمال فیلتر</button></form>
@if(TempData["Error"]!=null){<div class="alert error">@TempData["Error"]</div>}
<div class="table-wrap"><table><thead><tr><th>شماره پرسنلی</th><th>نام و نام خانوادگی</th><th>کد ملی</th><th>موبایل</th><th>جنسیت</th><th>واحد</th><th>اداره</th><th>بخش</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.PersonnelNumber</td><td>@e.FirstName @e.LastName</td><td>@e.NationalId</td><td>@e.Mobile</td><td>@e.Gender</td><td>@e.OrganizationUnit?.Title</td><td>@e.OrganizationDepartment?.Title</td><td>@e.OrganizationSection?.Title</td><td><span class="badge">@e.Status</span></td><td><a href="/Employees/Edit/@e.Id">ویرایش</a> @if(e.Status=="فعال"){<form class="inline" method="post" action="/Employees/Deactivate/@e.Id">@Html.AntiForgeryToken()<button class="link danger">غیرفعال</button></form>}</td></tr>}</tbody></table></div>