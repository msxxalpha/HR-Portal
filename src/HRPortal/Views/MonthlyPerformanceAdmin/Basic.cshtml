@model HRPortal.Models.MonthlyPerformanceBasicVm
@{
 Layout="~/Views/Shared/_Layout.cshtml";
 ViewData["Title"]="اطلاعات پایه ارزیابی عملکرد";
}
<link rel="stylesheet" href="~/css/monthly-performance.css" asp-append-version="true" />
<div class="mp">
<section class="mp-hero"><div><h1>اطلاعات پایه ارزیابی عملکرد</h1><p>مدیریت حوزه‌های ارزیابی و مشاهده ساختار سازمانی جاری</p></div>
<div class="mp-head-actions"><a class="btn btn-outline" href="/MonthlyPerformanceAdmin/Periods">دوره‌های ارزیابی</a><a class="btn btn-outline" href="/MonthlyPerformanceAdmin/Ranks">رده‌های پستی</a><a class="btn btn-outline" href="/MonthlyPerformanceAdmin/Questions">بانک سؤالات</a></div>
</section>
@if(TempData["Success"]!=null){<div class="mp-success">@TempData["Success"]</div>}
@if(TempData["Error"]!=null){<div class="mp-error">@TempData["Error"]</div>}
<div class="mp-tabs"><a class="@(Model.Tab=="units"?"current":"")" href="/MonthlyPerformanceAdmin/Basic?tab=units">واحدهای سازمانی</a>
<a class="@(Model.Tab!="units"?"current":"")" href="/MonthlyPerformanceAdmin/Basic?tab=domains">حوزه‌های ارزیابی</a></div>
@if(Model.Tab=="units"){
<section class="mp-card">
<div class="mp-toolbar"><div><h2>واحدها و گره‌های ساختار سازمانی نهایی‌شده</h2><p class="mp-note">کدها از ساختار اصلی خوانده می‌شوند و در نسخه قابل‌ویرایش همان ساختار قابل اصلاح هستند.</p></div>
<div class="mp-controls"><input class="mp-search" placeholder="جستجو..." /><a class="btn btn-outline" href="/Organization">ویرایش ساختار سازمانی</a>
<a class="btn btn-outline" href="/MonthlyPerformanceAdmin/Export?tab=units">خروجی Excel</a></div></div>
<div class="mp-table-wrap"><table class="mp-filter-table"><thead><tr><th>کد واحد</th><th>عنوان</th><th>رده</th><th>واحد بالادست</th><th>وضعیت</th></tr></thead>
<tbody>@foreach(var n in Model.Units){<tr><td>@n.Code</td><td>@n.Title</td><td>@n.RankType</td><td>@(Model.Units.FirstOrDefault(x=>x.Id==n.ParentId)?.Title??"ریشه")</td><td>@(n.IsActive?"فعال":"غیرفعال")</td></tr>}</tbody></table></div>
</section>
}else{
<section class="mp-card">
<h2>تعریف حوزه ارزیابی</h2><p class="mp-note">حوزه‌ها برای گروه‌بندی سؤالات و تحلیل عملکرد به تفکیک موضوع استفاده می‌شوند.</p>
<form method="post" action="/MonthlyPerformanceAdmin/SaveDomain" class="mp-controls">
@Html.AntiForgeryToken()<input type="hidden" name="id" value="0"/>
<label class="mp-field">کد حوزه<input name="code" maxlength="50" placeholder="ساخت خودکار" /></label>
<label class="mp-field">عنوان حوزه<input name="title" required maxlength="200" /></label>
<label class="mp-field">ترتیب<input name="sortOrder" type="number" step="1" value="10" /></label>
<input type="hidden" name="isActive" value="true"/>
<button class="btn btn-main" type="submit">افزودن حوزه</button>
</form></section>
<section class="mp-card">
<div class="mp-toolbar"><h2>حوزه‌های ارزیابی</h2>
<div class="mp-controls"><input class="mp-search" placeholder="فیلتر..." /><a class="btn btn-outline" href="/MonthlyPerformanceAdmin/Export?tab=domains">خروجی Excel</a></div></div>
<div class="mp-table-wrap"><table class="mp-filter-table"><thead><tr><th>کد</th><th>عنوان</th><th>ترتیب</th><th>فعال</th><th>ثبت تغییرات</th></tr></thead>
<tbody>@foreach(var d in Model.Domains){<tr>
<td><form method="post" action="/MonthlyPerformanceAdmin/SaveDomain" id="dom-@d.Id">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@d.Id"/></form><input form="dom-@d.Id" name="code" value="@d.Code" required maxlength="50" /></td>
<td><input form="dom-@d.Id" name="title" value="@d.Title" required maxlength="200" /></td>
<td><input form="dom-@d.Id" name="sortOrder" type="number" step="1" value="@d.SortOrder"/></td>
<td><input form="dom-@d.Id" name="isActive" type="checkbox" value="true" checked="@d.IsActive" /></td>
<td><button form="dom-@d.Id" class="btn btn-outline btn-sm" type="submit">ذخیره</button></td></tr>}
</tbody></table></div></section>
}
</div>
<script src="~/js/monthly-performance-table.js" asp-append-version="true"></script>
