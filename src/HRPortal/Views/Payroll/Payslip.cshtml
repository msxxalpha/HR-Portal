@{ViewData["Title"]="فیش حقوقی";}<div class="page-head"><div><h1>فیش حقوقی</h1><p>شماره پرسنلی از کاربر واردشده به سامانه دریافت می‌شود.</p></div></div><div class="card"><form method="post" asp-action="GeneratePayslip" class="report-filter">@Html.AntiForgeryToken()<label>سال / ماه (مثلاً ۱۴۰۵/۰۶)<input name="yearMonth" value="@ViewBag.YearMonth" required></label><label>شماره پرسنلی<input value="@ViewBag.PersonnelNumber" readonly></label><button class="btn btn-main">مشاهده فیش حقوقی</button></form></div>@if(ViewBag.Message!=null){<div class="alert error">@ViewBag.Message</div>}@if(ViewBag.ReportUrl!=null){<div class="report-frame"><iframe src="@ViewBag.ReportUrl" title="گزارش فیش حقوقی"></iframe></div>}else{<div class="card empty">پس از تنظیم Report Server و مسیر گزارش، گزارش در این قسمت نمایش داده می‌شود.</div>}