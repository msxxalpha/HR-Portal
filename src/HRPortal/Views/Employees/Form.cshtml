@model HRPortal.Controllers.EmployeesController.FormVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var edit = Model.Employee.Id > 0;
    ViewData["Title"] = edit ? "ویرایش کارمند" : "کارمند جدید";
}
<div class="page-head">
    <div><h1>@ViewData["Title"]</h1><p>اطلاعات شناسایی و ارتباطی کارمند</p></div>
    <a class="btn btn-outline" href="/Employees">بازگشت</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error">
    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }
    </div>
}

<form method="post" action="/Employees/@(edit ? "Edit" : "Create")" class="employee-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Employee.Id" />

    <section class="card employee-info-card employee-core-card">
        <div class="employee-section-heading">
            <span class="employee-section-mark">01</span>
            <div><h3>اطلاعات هویتی و ارتباطی</h3><p>شناسه‌های اصلی و راه‌های ارتباط با کارمند · موارد دارای * اجباری هستند</p></div>
        </div>
        <div class="grid-3">
            <label>شماره پرسنلی *<input name="PersonnelNumber" value="@Model.Employee.PersonnelNumber" required autocomplete="off" /></label>
            <label>شناسه *<input name="Identifier" value="@Model.Employee.Identifier" required autocomplete="off" /></label>
            <label>کد ملی *<input name="NationalId" value="@Model.Employee.NationalId" required inputmode="numeric" autocomplete="off" /></label>
            <label>نام *<input name="FirstName" value="@Model.Employee.FirstName" required /></label>
            <label>نام خانوادگی *<input name="LastName" value="@Model.Employee.LastName" required /></label>
            <label>شماره موبایل *<input name="Mobile" value="@Model.Employee.Mobile" required inputmode="tel" autocomplete="tel" /></label>
            <label>جنسیت *
                <select name="Gender" required>
                    <option value="">انتخاب کنید</option>
                    <option value="مرد" selected="@(Model.Employee.Gender == "مرد")">مرد</option>
                    <option value="زن" selected="@(Model.Employee.Gender == "زن")">زن</option>
                </select>
            </label>
            <label>نام پدر<input name="FatherName" value="@Model.Employee.FatherName" /></label>
            <label>ایمیل<input name="Email" value="@Model.Employee.Email" type="email" /></label>
        </div>
    </section>

    <section class="card employee-info-card employee-personal-card">
        <div class="employee-section-heading">
            <span class="employee-section-mark">02</span>
            <div><h3>اطلاعات فردی و سجلی</h3><p>اطلاعات تکمیلی شناسنامه‌ای و خانوادگی · تکمیل همه فیلدها اختیاری است</p></div>
        </div>
        <div class="grid-3">
            <label>تاریخ تولد
                <div class="jalali-date-input">
                    <input type="text" id="birthDatePersian" name="birthDatePersian" data-jalali-date value="@Model.BirthDateJalali" autocomplete="off" inputmode="numeric" placeholder="۱۳۷۰/۰۱/۰۱" />
                    <button type="button" class="btn btn-outline jalali-date-open" data-jalali-trigger aria-label="انتخاب تاریخ تولد">تقویم</button>
                </div>
            </label>
            <label>شماره شناسنامه<input name="BirthCertificateNumber" value="@Model.Employee.BirthCertificateNumber" maxlength="30" autocomplete="off" /></label>
            <label>محل صدور<input name="BirthCertificateIssuePlace" value="@Model.Employee.BirthCertificateIssuePlace" maxlength="150" /></label>
            <label>وضعیت تأهل
                <select name="MaritalStatus">
                    <option value="">انتخاب نشده</option>
                    <option value="مجرد" selected="@(Model.Employee.MaritalStatus == "مجرد")">مجرد</option>
                    <option value="متاهل" selected="@(Model.Employee.MaritalStatus == "متاهل")">متاهل</option>
                </select>
            </label>
            <label>تعداد اولاد<input type="number" name="ChildrenCount" value="@Model.Employee.ChildrenCount" min="0" max="30" step="1" inputmode="numeric" /></label>
            <label class="employee-wide-field">آدرس
                <textarea name="Address" rows="2" maxlength="1000">@Model.Employee.Address</textarea>
            </label>
        </div>
    </section>

    <section class="card employee-info-card employee-work-card">
        <div class="employee-section-heading">
            <span class="employee-section-mark">03</span>
            <div><h3>اطلاعات شغلی، استخدامی و بیمه</h3><p>اطلاعات رابطه استخدامی، مهارت‌ها و پوشش بیمه‌ای · تکمیل همه فیلدها اختیاری است</p></div>
        </div>
        <div class="grid-3">
            <label>تاریخ استخدام
                <div class="jalali-date-input">
                    <input type="text" id="hireDatePersian" name="hireDatePersian" data-jalali-date value="@Model.HireDateJalali" autocomplete="off" inputmode="numeric" placeholder="۱۳۹۵/۰۷/۰۱" />
                    <button type="button" class="btn btn-outline jalali-date-open" data-jalali-trigger aria-label="انتخاب تاریخ استخدام">تقویم</button>
                </div>
            </label>
            <label>وضعیت نظام وظیفه
                <select name="MilitaryServiceStatus">
                    <option value="">انتخاب نشده</option>
                    @foreach (var value in new[] { "انجام داده", "معاف", "غیبت", "در حال انجام", "خرید خدمت" })
                    {
                        <option value="@value" selected="@(Model.Employee.MilitaryServiceStatus == value)">@value</option>
                    }
                </select>
            </label>
            <label>شماره بیمه<input name="InsuranceNumber" value="@Model.Employee.InsuranceNumber" maxlength="50" autocomplete="off" /></label>
            <label>نوع شغل<input name="JobType" value="@Model.Employee.JobType" maxlength="100" placeholder="مانند اداری، تولیدی، فنی، خدماتی" /></label>
            <label class="employee-wide-field">مهارت
                <textarea name="Skill" rows="2" maxlength="1000" placeholder="مهارت‌ها، تخصص‌ها و گواهینامه‌های مرتبط">@Model.Employee.Skill</textarea>
            </label>
            <label>سمت / پست سازمانی
                <input type="search" id="positionFilter" placeholder="جست‌وجوی کد یا عنوان پست..." autocomplete="off" />
                <select name="PositionTitle" id="positionSelect">
                    <option value="">بدون سمت مشخص‌شده</option>
                    @foreach (var p in Model.Positions)
                    {
                        <option value="@p.Title" data-active="@p.IsActive.ToString().ToLowerInvariant()"
                                data-search="@($"{p.Code} {p.Title} {p.JobFamily} {p.Grade}")"
                                selected="@(Model.Employee.PositionTitle == p.Title)">
                            @p.Title (@p.Code)@(p.IsActive ? "" : " - غیرفعال / عنوان قبلی")
                        </option>
                    }
                </select>
                <small class="muted">برای تخصیص یا تغییر سمت، یک پست فعال انتخاب کنید. سمت‌های غیرفعال فقط برای حفظ اطلاعات قبلی نمایش داده می‌شوند.</small>
            </label>
            <label>رده پستی برای ارزیابی عملکرد
                <select name="PerformanceRankId">
                    <option value="">تعیین خودکار از سمت، پایه شغلی یا ساختار سازمانی</option>
                    @foreach (var rank in Model.PerformanceRanks)
                    {
                        <option value="@rank.Id" selected="@(Model.Employee.PerformanceRankId == rank.Id)">@rank.Title (@rank.Code)</option>
                    }
                </select>
                <small class="muted">برای جلوگیری از اختصاص سؤالات رده مدیریتی به کارشناسان مستقر در همان گره، رده ارزیابی هر فرد را در صورت نیاز صریحاً انتخاب کنید.</small>
            </label>
            <label class="inline-check">ارزیاب عملکرد ماهانه
                <input type="checkbox" name="IsPerformanceEvaluator" value="true" checked="@Model.Employee.IsPerformanceEvaluator" />
                <small class="muted">با فعال‌سازی این گزینه، نقش «ارزیاب عملکرد» نیز به کاربر اختصاص داده می‌شود؛ دامنه ارزیابی همچنان بر اساس ساختار سازمانی کنترل خواهد شد.</small>
            </label>
            <label class="inline-check">غیرقراردادی
                <input type="checkbox" id="isNonContractual" name="isNonContractual" value="true" checked="@(Model.Employee.EmploymentType == "غیرقراردادی")" />
            </label>
            <label>تاریخ پایان قرارداد
                <div class="jalali-date-input">
                    <input type="text" id="contractEndDatePersian" name="contractEndDatePersian" data-jalali-date
                           value="@(Model.Employee.ContractEndDate.HasValue ? HRPortal.Services.PersianDateService.Format(Model.Employee.ContractEndDate.Value) : "")"
                           autocomplete="off" placeholder="۱۴۰۵/۱۲/۲۹"
                           disabled="@(Model.Employee.EmploymentType == "غیرقراردادی")" />
                    <button type="button" class="btn btn-outline jalali-date-open" id="contractDatePickerButton" data-jalali-trigger
                            aria-label="باز کردن تقویم شمسی" aria-haspopup="dialog"
                            disabled="@(Model.Employee.EmploymentType == "غیرقراردادی")">تقویم</button>
                </div>
            </label>
            <label>وضعیت استخدام
                <select name="Status">
                    <option value="فعال" selected="@(Model.Employee.Status != "غیرفعال")">فعال</option>
                    <option value="غیرفعال" selected="@(Model.Employee.Status == "غیرفعال")">غیرفعال</option>
                </select>
            </label>
        </div>
    </section>

    <style>
        .employee-info-card{position:relative;overflow:hidden;border:1px solid #dbe5ef;border-radius:18px;margin-bottom:18px;padding:22px 24px}
        .employee-info-card:before{content:"";position:absolute;inset:0 0 auto;height:4px;background:var(--employee-accent)}
        .employee-core-card{--employee-accent:linear-gradient(90deg,#183a5b,#3976a8);background:linear-gradient(145deg,#fff,#f5f9fd)}
        .employee-personal-card{--employee-accent:linear-gradient(90deg,#5550a5,#8a78c9);background:linear-gradient(145deg,#fff,#f8f7fd)}
        .employee-work-card{--employee-accent:linear-gradient(90deg,#9a6a23,#d2a34f);background:linear-gradient(145deg,#fff,#fcf9f2)}
        .employee-section-heading{display:flex;align-items:center;gap:13px;margin-bottom:20px}
        .employee-section-heading h3{margin:0 0 5px;color:#17324d;font-size:1.05rem}
        .employee-section-heading p{margin:0;color:#64748b;font-size:.82rem}
        .employee-section-mark{width:42px;height:42px;display:grid;place-items:center;border-radius:12px;background:#e7eff8;color:#173b60;font-weight:800}
        .employee-personal-card .employee-section-mark{background:#eeebfa;color:#5d56a2}
        .employee-work-card .employee-section-mark{background:#f8efd9;color:#96651c}
        .employee-info-card label{min-width:0}
        .employee-info-card input,.employee-info-card select,.employee-info-card textarea{box-sizing:border-box;width:100%}
        .employee-wide-field{grid-column:span 2}
        .employee-info-card textarea{resize:vertical;min-height:68px}
        @@media(max-width:700px){.employee-wide-field{grid-column:span 1}.employee-info-card{padding:17px}}
    </style>

    <div class="card">
        <div class="section-head"><div><h3>ساختار سازمانی</h3><span class="muted">اداره و بخش متناسب با انتخاب والد فیلتر می‌شوند.</span></div></div>
        <div class="grid-3">
            <label>واحد سازمانی
                <select name="OrganizationUnitId" id="unitSelect">
                    <option value="">انتخاب واحد</option>
                    @foreach (var n in Model.Units)
                    {
                        @if (Model.Employee.OrganizationUnitId == n.Id)
                        {
                            <option value="@n.Id" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
            <label>اداره سازمانی
                <select name="OrganizationDepartmentId" id="departmentSelect">
                    <option value="">انتخاب اداره</option>
                    @foreach (var n in Model.Departments)
                    {
                        @if (Model.Employee.OrganizationDepartmentId == n.Id)
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
            <label>بخش سازمانی
                <select name="OrganizationSectionId" id="sectionSelect">
                    <option value="">انتخاب بخش</option>
                    @foreach (var n in Model.Sections)
                    {
                        @if (Model.Employee.OrganizationSectionId == n.Id)
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
        </div>
        <div class="grid-2">
            <label>جایگاه سازمانی ویژه (مدیرعامل)
                <select name="OrganizationPositionId">
                    <option value="">بدون جایگاه ویژه</option>
                    @foreach (var n in Model.SpecialPositions)
                    {
                        <option value="@n.Id" selected="@(Model.Employee.OrganizationPositionId == n.Id)">@n.Title (@n.Code)</option>
                    }
                </select>
                <small class="muted">این گزینه فقط برای تعیین مدیرعامل استفاده می‌شود. در میان کارکنان فعال، این رده فقط به یک نفر قابل اختصاص است.</small>
            </label>
        </div>
    </div>

    <div class="form-actions"><button class="btn btn-main" type="submit">@(edit ? "ذخیره تغییرات" : "ثبت کارمند")</button></div>
</form>

@section Scripts {
<script>
(function(){
    const positionFilter = document.getElementById('positionFilter');
    const positionSelect = document.getElementById('positionSelect');
    positionFilter.addEventListener('input', function () {
        const term = this.value.trim().toLocaleLowerCase();
        Array.from(positionSelect.options).forEach(function (opt, index) {
            if (index === 0) { opt.hidden = false; return; }
            const haystack = (opt.dataset.search || opt.textContent || '').toLocaleLowerCase();
            opt.hidden = !!term && !haystack.includes(term);
        });
    });

    const unit = document.getElementById('unitSelect');
    const department = document.getElementById('departmentSelect');
    const section = document.getElementById('sectionSelect');

    function filterChildren(parentSelect, childSelect) {
        const parentId = parentSelect.value;
        Array.from(childSelect.options).forEach(function(opt, index){
            if (index === 0) { opt.hidden = false; return; }
            // Keep the persisted value visible even if it belongs to an older revision.
            const saved = opt.selected && opt.value !== '';
            const show = saved || (!!parentId && opt.dataset.parentId === parentId);
            opt.hidden = !show;
        });
    }

    function resetInvalidSelection(select) {
        if (select.selectedOptions.length && select.selectedOptions[0].hidden)
            select.value = "";
    }

    function refresh() {
        filterChildren(unit, department);
        // Initial render must never discard assignments loaded from the database.
        filterChildren(department, section);
    }

    unit.addEventListener('change', function(){
        filterChildren(unit, department);
        department.value = "";
        section.value = "";
        filterChildren(department, section);
    });

    department.addEventListener('change', function(){
        section.value = "";
        filterChildren(department, section);
    });

    const nonContractual = document.getElementById('isNonContractual');
    const contractDate = document.getElementById('contractEndDatePersian');
    const contractDateButton = document.getElementById('contractDatePickerButton');
    function updateContractDateAvailability() {
        const disabled = nonContractual.checked;
        contractDate.disabled = disabled;
        contractDateButton.disabled = disabled;
        if (disabled) contractDate.value = '';
    }
    nonContractual.addEventListener('change', updateContractDateAvailability);
    updateContractDateAvailability();

    refresh();
})();
</script>
}
