@model HRPortal.Models.WorkflowManagementViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var defaultHierarchyStopRank = Model.RankTitles.Contains("معاونت") ? "معاونت" : Model.RankTitles.FirstOrDefault();
    ViewData["Title"] = "مدیریت گردش کار";
    var selected = Model.SelectedDefinition;
}
<div class="page-head">
    <div><h1>مدیریت گردش کار</h1><p>تعریف گردش کار و تخصیص مراحل به جایگاه‌های ساختار سازمانی.</p></div>
</div>
<div class="note">برای تخصیص به جایگاهی که مسئول آن را در فرم انتخاب می‌کند: ابتدا مرحله تصمیم‌گیرنده را بسازید و یک فیلد از نوع «انتخاب جایگاه سازمانی فعال» با کد مشخص (مثلاً SpecialistPosition) به آن اضافه کنید؛ سپس مرحله بعدی را با نوع تخصیص «جایگاه انتخاب‌شده در فرم همین مرحله» بسازید و همان کد را در تنظیمات آن وارد کنید. موتور، آخرین مقدار معتبر آن فیلد را می‌خواند و وظیفه را به متصدیان جایگاه انتخابی می‌سپارد. برای مسیرهای چندشاخه نیز از مسیرهای شرطی استفاده کنید. مسیر زنجیره‌ای بالادستی همچنان تنظیم جداگانه خود را دارد.</div>
@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }

<div class="workflow-management-grid">
<section class="card">
    <div class="section-head"><h3>گردش کارها</h3></div>
    @foreach (var item in Model.Definitions)
    {
        <a class="workflow-definition-item @(selected?.Id == item.Id ? "selected" : "")" href="/Workflow/Manage?id=@item.Id">
            <strong>@item.Title</strong><span>@item.Code · نسخه @item.Version · @item.Steps.Count مرحله · @(item.IsActive ? "فعال" : "غیرفعال") · @(string.IsNullOrWhiteSpace(item.FormCode) ? "بدون اتصال به فرم" : "فرم: " + item.FormCode)</span>
        </a>
    }
    <hr />
    <h3>گردش کار جدید</h3>
    <form method="post" action="/Workflow/SaveDefinition" class="form-stack">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="0" />
        <label>کد <input name="Code" required maxlength="100" placeholder="LeaveRequest" /></label>
        <label>عنوان <input name="Title" required maxlength="200" /></label>
        <label>فرم عملیاتی<select name="FormCode" required><option value="">انتخاب فرم فعال با قابلیت گردش کار</option>@foreach (var form in Model.AvailableForms) { <option value="@form.Code">@form.Title</option> }</select></label>
        <label>توضیحات <textarea name="Description" rows="3"></textarea></label>
        <label class="toggle-card compact-toggle"><span class="toggle-text"><strong>فعال</strong></span><span class="switch-control"><input type="checkbox" name="IsActive" value="true" checked /><span class="switch-slider"></span></span></label>
        <button class="btn btn-main" type="submit">ایجاد گردش کار</button>
    </form>
</section>
<section class="card">
@if (selected is null)
{
    <div class="empty">یک گردش کار را انتخاب کنید یا گردش کار جدید بسازید.</div>
}
else
{
    <div class="section-head"><div><h3>@selected.Title</h3><span class="muted">@selected.Code · نسخه @selected.Version</span></div>
        <form method="post" action="/Workflow/DeleteDefinition" onsubmit="return confirm('این گردش کار فقط در صورت استفاده‌نشدن حذف می‌شود. ادامه می‌دهید؟');">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@selected.Id" />
            <button class="btn btn-outline btn-sm danger" type="submit">حذف گردش کار</button>
        </form>
    </div>
    <div class="alert info">اگر گردش کار قبلاً در درخواست‌ها استفاده شده باشد، ابتدا «ذخیره مشخصات» را بزنید تا نسخه جدید و مستقل ساخته شود؛ سپس مراحل و فیلدهای نسخه جدید را ویرایش کنید. نسخه‌های قدیمی و سوابقشان تغییر نمی‌کنند. فرم‌های سازگار که در کد سامانه پیاده‌سازی شده‌اند، به‌صورت خودکار در فهرست فرم‌ها ظاهر می‌شوند؛ نیازی به ثبت دستی فرم در اطلاعات پایه نیست.</div>
    <form method="post" action="/Workflow/SaveDefinition" class="form-stack workflow-definition-edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@selected.Id" />
        <div class="grid-2"><label>کد<input name="Code" value="@selected.Code" required /></label><label>عنوان<input name="Title" value="@selected.Title" required /></label><label>فرم عملیاتی<select name="FormCode"><option value="">بدون اتصال (تعریف قدیمی)</option>@foreach (var form in Model.AvailableForms) { <option value="@form.Code" selected="@(selected.FormCode == form.Code)">@form.Title</option> }</select></label></div>
        <label>توضیحات<textarea name="Description" rows="2">@selected.Description</textarea></label>
        <label class="toggle-card compact-toggle"><span class="toggle-text"><strong>فعال</strong></span><span class="switch-control"><input type="checkbox" name="IsActive" value="true" @(selected.IsActive ? "checked" : "") /><span class="switch-slider"></span></span></label>
        <button class="btn btn-main btn-sm" type="submit">ذخیره مشخصات</button>
    </form>
    <hr />
    <div class="section-head"><div><h3>مراحل</h3><span class="muted">تخصیص می‌تواند ثابت، زنجیره‌ای، درخواست‌کننده یا بر اساس جایگاه انتخاب‌شده در یک مرحله قبلی باشد.</span></div></div>
    @foreach (var step in selected.Steps.OrderBy(x => x.SortOrder))
    {
            var approveTransition = step.OutgoingTransitions.FirstOrDefault(x => x.Action == "Approve" && string.IsNullOrWhiteSpace(x.ConditionFieldCode));
            var returnTransition = step.OutgoingTransitions.FirstOrDefault(x => x.Action == "Return" && string.IsNullOrWhiteSpace(x.ConditionFieldCode));
            var rejectTransition = step.OutgoingTransitions.FirstOrDefault(x => x.Action == "Reject" && string.IsNullOrWhiteSpace(x.ConditionFieldCode));
        <details class="workflow-step-card workflow-step-collapsible">
            <summary class="workflow-step-head">
                <span class="workflow-step-summary-main">
                    <strong>@(step.SortOrder). @step.Title</strong>
                    <span>@step.Code · @(step.AssignmentType == "Hierarchy" ? "زنجیره جایگاه‌های بالاتر" : step.AssignmentType == "Requester" ? "درخواست‌کننده" : step.AssignmentType == "Employee" ? "کارمند مشخص" : step.OrganizationNode?.Title ?? "بدون جایگاه")</span>
                    @if (step.AssignmentType == "Hierarchy") { <span class="badge">مرحله زنجیره‌ای</span> }
                </span>
                <span class="workflow-step-toggle-label">نمایش تنظیمات مرحله</span>
            </summary>
            <form method="post" action="/Workflow/SaveStep" class="form-stack workflow-step-editor" data-stage-editor>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@step.Id" />
                <input type="hidden" name="WorkflowDefinitionId" value="@selected.Id" />
                <div class="grid-2">
                    <label>کد مرحله<input name="Code" value="@step.Code" required maxlength="100" /></label>
                    <label>عنوان مرحله<input name="Title" value="@step.Title" required maxlength="200" /></label>
                    <label>ترتیب نمایش<input name="SortOrder" type="number" min="1" step="1" value="@step.SortOrder" required /></label>
                    <label>نوع تخصیص مرحله
                        <select name="AssignmentType" class="assignment-type">
                            <option value="Position" selected="@(step.AssignmentType == "Position")">جایگاه سازمانی ثابت</option>
                            <option value="Hierarchy" selected="@(step.AssignmentType == "Hierarchy")">زنجیره جایگاه‌های بالاتر از کارمند</option>
                            <option value="Requester" selected="@(step.AssignmentType == "Requester")">درخواست‌کننده (برای بازگشت جهت اصلاح)</option>
                            <option value="FieldPosition" selected="@(step.AssignmentType == "FieldPosition")">جایگاه انتخاب‌شده در فرم همین مرحله</option>
                            <option value="Employee" selected="@(step.AssignmentType == "Employee")">کارمند مشخص</option>
                        </select>
                    </label>
                    <label class="assignment-position">جایگاه سازمانی
                        <select name="OrganizationNodeId"><option value="">انتخاب جایگاه</option>
                            @foreach (var p in Model.Positions) { <option value="@p.Id" selected="@(step.OrganizationNodeId == p.Id)">@p.Title — @p.RankType</option> }
                        </select>
                    </label>
                    <label class="assignment-employee">کارمند مسئول
                        <select name="AssignedEmployeeId"><option value="">انتخاب کارمند فعال</option>
                            @foreach (var employee in Model.AvailableEmployees) { <option value="@employee.Id" selected="@(step.AssignedEmployeeId == employee.Id)">@employee.FirstName @employee.LastName — @employee.PersonnelNumber</option> }
                        </select>
                    </label>
                    <label class="assignment-field-code">کد فیلد انتخاب جایگاه
                        <input name="AssignmentFieldCode" value="@step.AssignmentFieldCode" maxlength="100" placeholder="SelectedPosition" />
                        <small>کد فیلد «انتخاب جایگاه سازمانی فعال» در یکی از مراحل قبلی.</small>
                    </label>
                    <label class="assignment-hierarchy">توقف مسیر پویا در رده
                        <select name="HierarchyStopRankType">
                            <option value="__BeforeCEO__" selected="@(step.HierarchyStopRankType == "__BeforeCEO__")">تا آخرین جایگاه زنجیره پیش از مدیرعامل</option>
                            @foreach (var rank in Model.RankTitles) { <option value="@rank" selected="@(step.HierarchyStopRankType == rank)">@rank</option> }
                        </select>
                    </label>
                    <label>نحوه تخصیص
                        <select name="AssignmentMode">
                            <option value="Any" selected="@(step.AssignmentMode != "All")">هر یک از متصدیان جایگاه</option>
                            <option value="All" selected="@(step.AssignmentMode == "All")">همه متصدیان جایگاه</option>
                        </select>
                    </label>
                    <label class="check-chip"><input type="checkbox" name="IsFinalStep" value="true" checked="@step.IsFinalStep" /> مرحله نهایی<input type="hidden" name="IsFinalStep" value="false" /></label>
                </div>
                <div class="actions">
                    <label class="check-chip"><input type="checkbox" name="AllowApprove" value="true" checked="@step.AllowApprove" /> تأیید<input type="hidden" name="AllowApprove" value="false" /></label>
                    <label class="check-chip"><input type="checkbox" name="AllowReject" value="true" checked="@step.AllowReject" /> رد<input type="hidden" name="AllowReject" value="false" /></label>
                    <label class="check-chip"><input type="checkbox" name="AllowReturn" value="true" checked="@step.AllowReturn" /> برگشت<input type="hidden" name="AllowReturn" value="false" /></label>
                    <label class="check-chip"><input type="checkbox" name="RequireCommentOnReject" value="true" checked="@step.RequireCommentOnReject" /> توضیح رد اجباری<input type="hidden" name="RequireCommentOnReject" value="false" /></label>
                    <label class="check-chip"><input type="checkbox" name="RequireCommentOnReturn" value="true" checked="@step.RequireCommentOnReturn" /> توضیح برگشت اجباری<input type="hidden" name="RequireCommentOnReturn" value="false" /></label>
                    <button class="btn btn-main btn-sm" type="submit">ذخیره مشخصات مرحله</button>
                </div>
            </form>
            <form method="post" action="/Workflow/SaveStepRules" class="form-stack workflow-stage-rules">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@step.Id" /><input type="hidden" name="definitionId" value="@selected.Id" />
                <div class="grid-2">
                    <label class="hierarchy-vacancy-setting">سیاست برخورد با جایگاه خالی
                        <small class="muted">این تنظیم فقط برای مرحله‌ای با نوع تخصیص «زنجیره جایگاه‌های بالاتر» فعال است.</small>
                        <select name="hierarchyVacancyPolicy" class="vacancy-policy" data-step="@step.Id" @(step.AssignmentType == "Hierarchy" ? "" : "disabled")>
                            <option value="Skip" selected="@(step.HierarchyVacancyPolicy == "Skip")">عبور از جایگاه خالی و ادامه مسیر</option>
                            <option value="Stop" selected="@(step.HierarchyVacancyPolicy == "Stop")">توقف گردش کار تا تعیین متصدی</option>
                            <option value="Substitute" selected="@(step.HierarchyVacancyPolicy == "Substitute")">ارجاع به جایگاه جانشین</option>
                        </select>
                    </label>
                    <label class="vacancy-substitute" data-step="@step.Id" style="display:@(step.HierarchyVacancyPolicy == "Substitute" ? "block" : "none")">
                        جایگاه جانشین
                        <select name="hierarchySubstitutePositionId">
                            <option value="">انتخاب جایگاه جانشین</option>
                            @foreach (var p in Model.Positions) { <option value="@p.Id" selected="@(step.HierarchySubstitutePositionId == p.Id)">@p.Title — @p.RankType</option> }
                        </select>
                    </label>
                </div>
                <div class="actions"><label class="check-chip"><input type="checkbox" name="allowEditPreviousData" value="true" checked="@step.AllowEditPreviousData" /> اجازه ویرایش اطلاعات مراحل قبلی در این مرحله</label><label class="check-chip"><input type="checkbox" name="requireNotes" value="true" checked="@step.RequireNotes" /> ثبت ملاحظات در این مرحله اجباری باشد</label><button class="btn btn-outline btn-sm" type="submit">ذخیره تنظیمات مرحله</button></div>
            </form>
            <div class="workflow-step-actions">
                <div class="workflow-route-heading"><h4>مسیرهای اصلی گردش کار</h4><span class="muted">برای برگشت مستقیم به ثبت‌کننده فرم، گزینه «شروع‌کننده فرم» را انتخاب کنید؛ نیازی به تعریف مرحله جداگانه نیست.</span></div>
                <div class="workflow-route-grid">
                    <form method="post" action="/Workflow/SaveTransition" class="transition-form workflow-route-card route-approve">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="stepId" value="@step.Id" /><input type="hidden" name="definitionId" value="@selected.Id" />
                        <input type="hidden" name="action" value="Approve" />
                        <label><strong>تأیید به مرحله</strong>
                            <select name="toStepId">
                                <option value="" selected="@(approveTransition?.ToStepId is null)">پایان گردش کار</option>
                                @foreach (var target in selected.Steps.Where(x => x.Id != step.Id).OrderBy(x => x.SortOrder))
                                { <option value="@target.Id" selected="@(approveTransition?.ToStepId == target.Id)">@(target.SortOrder + " - " + target.Title)</option> }
                            </select>
                        </label>
                        <button class="btn btn-outline btn-sm" type="submit">ذخیره مسیر تأیید</button>
                    </form>
                    <form method="post" action="/Workflow/SaveTransition" class="transition-form workflow-route-card route-return">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="stepId" value="@step.Id" /><input type="hidden" name="definitionId" value="@selected.Id" />
                        <input type="hidden" name="action" value="Return" />
                        <label><strong>برگشت به</strong>
                            <select name="toStepId">
                                <option value="" selected="@(returnTransition is null || (returnTransition.ToStepId is null && returnTransition.Title != HRPortal.Services.WorkflowService.ReturnToRequesterTransitionTitle))">وضعیت برگشت / خاتمه برگشت</option>
                                <option value="__REQUESTER__" selected="@(returnTransition?.Title == HRPortal.Services.WorkflowService.ReturnToRequesterTransitionTitle)">برگشت مستقیم به شروع‌کننده فرم</option>
                                <optgroup label="بازگشت به مراحل گردش کار">
                                    @foreach (var target in selected.Steps.Where(x => x.Id != step.Id).OrderBy(x => x.SortOrder))
                                    { <option value="@target.Id" selected="@(returnTransition?.ToStepId == target.Id && returnTransition?.Title != HRPortal.Services.WorkflowService.ReturnToRequesterTransitionTitle)">@(target.SortOrder + " - " + target.Title)</option> }
                                </optgroup>
                            </select>
                        </label>
                        <button class="btn btn-outline btn-sm" type="submit">ذخیره مسیر برگشت</button>
                    </form>
                    <form method="post" action="/Workflow/SaveTransition" class="transition-form workflow-route-card route-reject">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="stepId" value="@step.Id" /><input type="hidden" name="definitionId" value="@selected.Id" />
                        <input type="hidden" name="action" value="Reject" />
                        <label><strong>رد به مرحله</strong>
                            <select name="toStepId">
                                <option value="" selected="@(rejectTransition?.ToStepId is null)">پایان و رد درخواست</option>
                                @foreach (var target in selected.Steps.Where(x => x.Id != step.Id).OrderBy(x => x.SortOrder))
                                { <option value="@target.Id" selected="@(rejectTransition?.ToStepId == target.Id)">@(target.SortOrder + " - " + target.Title)</option> }
                            </select>
                        </label>
                        <button class="btn btn-outline btn-sm" type="submit">ذخیره مسیر رد</button>
                    </form>
                </div>
                <details class="workflow-conditional-routes">
                    <summary>افزودن یا مدیریت مسیرهای شرطی (زیر مسیرهای اصلی)</summary>
                    @foreach (var route in step.OutgoingTransitions.Where(x => !string.IsNullOrWhiteSpace(x.ConditionFieldCode)).OrderBy(x => x.Id))
                    {
                        <div class="transition-form conditional-route-item">
                            <span>اگر «@route.ConditionFieldCode» @route.ConditionOperator «@route.ConditionValue» ← @(route.ToStep?.Title ?? "پایان")</span>
                            <form method="post" action="/Workflow/DeleteTransition" class="inline" onsubmit="return confirm('این مسیر شرطی حذف شود؟');">
                                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@route.Id" /><input type="hidden" name="definitionId" value="@selected.Id" />
                                <button class="btn btn-outline btn-sm danger" type="submit">حذف مسیر</button>
                            </form>
                        </div>
                    }
                    <form method="post" action="/Workflow/SaveTransition" class="transition-form workflow-conditional-editor">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="stepId" value="@step.Id" /><input type="hidden" name="definitionId" value="@selected.Id" />
                        <label>هنگام عملیات <select name="action"><option value="Approve">تأیید</option><option value="Reject">رد</option><option value="Return">برگشت</option></select></label>
                        <label>اگر فیلد <select name="conditionFieldCode" required><option value="">انتخاب فیلد</option>@foreach (var field in step.Fields.OrderBy(x => x.SortOrder)){<option value="@field.Code">@field.Title (@field.Code)</option>}</select></label>
                        <label>شرط <select name="conditionOperator"><option value="Equals">برابر باشد با</option><option value="NotEquals">برابر نباشد با</option><option value="Contains">شامل عبارت باشد</option><option value="IsEmpty">خالی باشد</option><option value="NotEmpty">خالی نباشد</option></select></label>
                        <label>مقدار <input name="conditionValue" maxlength="4000" placeholder="مثلاً واحد فنی" /></label>
                        <label>به مرحله <select name="toStepId" required><option value="">انتخاب مرحله مقصد</option>@foreach (var target in selected.Steps.Where(x => x.Id != step.Id).OrderBy(x => x.SortOrder)){<option value="@target.Id">@(target.SortOrder + " - " + target.Title)</option>}</select></label>
                        <button class="btn btn-outline btn-sm" type="submit">افزودن مسیر شرطی</button>
                    </form>
                    <p class="muted">مسیرهای شرطی به ترتیب ثبت بررسی می‌شوند. در صورت برقرار نبودن هیچ شرطی، مسیر تأیید عادی این مرحله اجرا می‌شود.</p>
                </details>
                <div class="workflow-stage-footer">
                    <form method="post" action="/Workflow/DeleteStep" class="inline" onsubmit="return confirm('مرحله انتخاب‌شده و مسیرهای ورودی/خروجی مرتبط حذف می‌شوند؛ ترتیب مراحل باقی‌مانده به‌صورت خودکار بازتنظیم می‌شود. ادامه می‌دهید؟');">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@step.Id" /><input type="hidden" name="definitionId" value="@selected.Id" /><button class="btn btn-outline btn-sm danger" type="submit">حذف مرحله</button>
                    </form>
                </div>
            </div>
            <div class="workflow-stage-fields">
                <h4>فیلدهای فرم این مرحله</h4>
                <p class="muted">این فیلدها هنگام رسیدن درخواست به این مرحله قابل ورود هستند؛ مراحل بعدی به‌صورت پیش‌فرض فقط خواندنی‌اند و می‌توان برای هر مرحله اجازه ویرایش اطلاعات قبلی را فعال کرد.</p>
                @foreach (var field in step.Fields.OrderBy(x => x.SortOrder))
                {
                    <form method="post" action="/Workflow/SaveStepField" class="form-stack workflow-field-editor">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@field.Id" />
                        <input type="hidden" name="WorkflowStepId" value="@step.Id" />
                        <div class="grid-2">
                            <label>کد فیلد<input name="Code" value="@field.Code" required maxlength="100" /></label>
                            <label>عنوان نمایشی<input name="Title" value="@field.Title" required maxlength="200" /></label>
                            <label>نوع فیلد<select name="FieldType">
                                <option value="Text" selected="@(field.FieldType == "Text")">متن کوتاه</option>
                                <option value="TextArea" selected="@(field.FieldType == "TextArea")">متن چندخطی</option>
                                <option value="Number" selected="@(field.FieldType == "Number")">عدد</option>
                                <option value="Date" selected="@(field.FieldType == "Date")">تاریخ</option>
                                <option value="Select" selected="@(field.FieldType == "Select")">انتخاب از فهرست</option>
                                <option value="PositionPicker" selected="@(field.FieldType == "PositionPicker")">انتخاب جایگاه سازمانی فعال</option>
                                <option value="Checkbox" selected="@(field.FieldType == "Checkbox")">بله/خیر</option>
                            </select></label>
                            <label>ترتیب نمایش<input name="SortOrder" type="number" value="@field.SortOrder" /></label>
                            <label>حداکثر طول<input name="MaxLength" type="number" min="1" max="4000" value="@field.MaxLength" /></label>
                            <label class="check-chip"><input type="checkbox" name="IsRequired" value="true" checked="@field.IsRequired" /> تکمیل این فیلد اجباری است</label>
                        </div>
                        <label>گزینه‌ها (هر گزینه در یک خط؛ مخصوص نوع انتخابی)<textarea name="Options" rows="3">@field.Options</textarea></label>
                        <label>راهنمای ورود اطلاعات<textarea name="HelpText" rows="2">@field.HelpText</textarea></label>
                        <div class="actions"><button class="btn btn-outline btn-sm" type="submit">ذخیره فیلد</button></div>
                    </form>
                    <form method="post" action="/Workflow/DeleteStepField" class="inline" onsubmit="return confirm('این فیلد حذف شود؟');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@field.Id" />
                        <input type="hidden" name="definitionId" value="@selected.Id" />
                        <button class="btn btn-outline btn-sm danger" type="submit">حذف فیلد @field.Title</button>
                    </form>
                }
                <details>
                    <summary>افزودن فیلد جدید</summary>
                    <form method="post" action="/Workflow/SaveStepField" class="form-stack">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="0" />
                        <input type="hidden" name="WorkflowStepId" value="@step.Id" />
                        <div class="grid-2">
                            <label>کد فیلد<input name="Code" required maxlength="100" placeholder="technicalComment" /></label>
                            <label>عنوان نمایشی<input name="Title" required maxlength="200" placeholder="نظر کارشناسی" /></label>
                            <label>نوع فیلد<select name="FieldType"><option value="Text">متن کوتاه</option><option value="TextArea">متن چندخطی</option><option value="Number">عدد</option><option value="Date">تاریخ</option><option value="Select">انتخاب از فهرست</option><option value="PositionPicker">انتخاب جایگاه سازمانی فعال</option><option value="Checkbox">بله/خیر</option></select></label>
                            <label>ترتیب نمایش<input name="SortOrder" type="number" value="10" /></label>
                            <label>حداکثر طول<input name="MaxLength" type="number" min="1" max="4000" /></label>
                            <label class="check-chip"><input type="checkbox" name="IsRequired" value="true" /> تکمیل این فیلد اجباری است</label>
                        </div>
                        <label>گزینه‌ها (هر گزینه در یک خط؛ مخصوص نوع انتخابی)<textarea name="Options" rows="3"></textarea></label>
                        <label>راهنمای ورود اطلاعات<textarea name="HelpText" rows="2"></textarea></label>
                        <button class="btn btn-main btn-sm" type="submit">افزودن فیلد</button>
                    </form>
                </details>
            </div>
        </details>
    }
    <hr />
    <h3>افزودن مرحله</h3>
    <form method="post" action="/Workflow/SaveStep" class="form-stack workflow-new-step-editor" data-stage-editor>
        @Html.AntiForgeryToken()
        <input type="hidden" name="WorkflowDefinitionId" value="@selected.Id" />
        <div class="grid-2">
            <label>کد مرحله<input name="Code" required placeholder="Supervisor" maxlength="100" /></label>
            <label>عنوان مرحله<input name="Title" required placeholder="بررسی سرپرست" maxlength="200" /></label>
            <label>ترتیب<input name="SortOrder" type="number" min="1" step="1" value="@(selected.Steps.Count == 0 ? 10 : selected.Steps.Max(x => x.SortOrder) + 10)" /></label>
            <label>نوع تخصیص مرحله
                <select name="AssignmentType" class="assignment-type">
                    <option value="Position">جایگاه سازمانی ثابت</option><option value="Hierarchy">زنجیره جایگاه‌های بالاتر از کارمند</option>
                    <option value="Requester">درخواست‌کننده (برای بازگشت جهت اصلاح)</option><option value="FieldPosition">جایگاه انتخاب‌شده در فرم همین مرحله</option><option value="Employee">کارمند مشخص</option>
                </select>
            </label>
            <label class="assignment-position">جایگاه سازمانی<select name="OrganizationNodeId"><option value="">انتخاب جایگاه</option>@foreach (var p in Model.Positions){<option value="@p.Id">@p.Title — @p.RankType</option>}</select></label>
            <label class="assignment-employee">کارمند مسئول<select name="AssignedEmployeeId"><option value="">انتخاب کارمند فعال</option>@foreach (var employee in Model.AvailableEmployees){<option value="@employee.Id">@employee.FirstName @employee.LastName — @employee.PersonnelNumber</option>}</select></label>
            <label class="assignment-field-code">کد فیلد انتخاب جایگاه<input name="AssignmentFieldCode" maxlength="100" placeholder="SelectedPosition" /><small>این کد باید با فیلد «انتخاب جایگاه سازمانی فعال» در یکی از مراحل قبلی یکسان باشد.</small></label>
            <label class="assignment-hierarchy">توقف مسیر پویا در رده<select name="HierarchyStopRankType"><option value="__BeforeCEO__">تا آخرین جایگاه زنجیره پیش از مدیرعامل</option>@foreach (var rank in Model.RankTitles){<option value="@rank" selected="@(rank == defaultHierarchyStopRank)">@rank</option>}</select></label>
            <label>نحوه تخصیص<select name="AssignmentMode"><option value="Any">هر یک از متصدیان جایگاه</option><option value="All">همه متصدیان جایگاه</option></select></label>
            <label class="check-chip"><input type="checkbox" name="IsFinalStep" value="true" /> مرحله نهایی<input type="hidden" name="IsFinalStep" value="false" /></label>
        </div>
        <div class="actions"><label class="check-chip"><input type="checkbox" name="AllowApprove" value="true" checked /> تأیید<input type="hidden" name="AllowApprove" value="false" /></label><label class="check-chip"><input type="checkbox" name="AllowReject" value="true" checked /> رد<input type="hidden" name="AllowReject" value="false" /></label><label class="check-chip"><input type="checkbox" name="AllowReturn" value="true" checked /> برگشت<input type="hidden" name="AllowReturn" value="false" /></label><label class="check-chip"><input type="checkbox" name="RequireCommentOnReject" value="true" checked /> توضیح رد اجباری<input type="hidden" name="RequireCommentOnReject" value="false" /></label><label class="check-chip"><input type="checkbox" name="RequireCommentOnReturn" value="true" /> توضیح برگشت اجباری<input type="hidden" name="RequireCommentOnReturn" value="false" /></label></div>
        <button class="btn btn-main" type="submit">افزودن مرحله</button>
    </form>
}
</section>
</div>

<style>
.workflow-step-collapsible { padding: 0; overflow: hidden; }
.workflow-step-collapsible > summary { list-style: none; cursor: pointer; user-select: none; }
.workflow-step-collapsible > summary::-webkit-details-marker { display: none; }
.workflow-step-summary-main { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; min-width: 0; }
.workflow-step-toggle-label { margin-inline-start: auto; color: #64748b; font-size: .82rem; white-space: nowrap; }
.workflow-step-toggle-label::after { content: "＋"; display: inline-flex; margin-inline-start: .55rem; font-size: 1.1rem; font-weight: 700; }
.workflow-step-collapsible[open] > summary { border-bottom: 1px solid #e2e8f0; margin-bottom: 1rem; }
.workflow-step-collapsible[open] .workflow-step-toggle-label::after { content: "−"; }
.workflow-step-collapsible > :not(summary) { margin-inline: 1rem; }
.workflow-step-collapsible > .workflow-stage-fields { margin-bottom: 1rem; }
.workflow-step-actions { display: flex; flex-direction: column; gap: 1rem; }
.workflow-route-heading h4 { margin: 0 0 .35rem; }
.workflow-route-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; align-items: stretch; }
.workflow-route-card { border: 1px solid #dbe3ee; border-radius: 12px; padding: .85rem; background: #f8fafc; display: flex; flex-direction: column; justify-content: space-between; gap: .75rem; min-width: 0; }
.workflow-route-card label { display: flex; flex-direction: column; gap: .5rem; }
.workflow-route-card select { width: 100%; min-width: 0; }
.workflow-route-card.route-approve { border-top: 3px solid #64748b; }
.workflow-route-card.route-return { border-top: 3px solid #d97706; }
.workflow-route-card.route-reject { border-top: 3px solid #b91c1c; }
.workflow-conditional-routes { border: 1px dashed #cbd5e1; border-radius: 10px; padding: .8rem; background: #fff; }
.workflow-conditional-routes > summary { cursor: pointer; font-weight: 600; color: #334155; }
.workflow-conditional-editor { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: .85rem; }
.workflow-stage-footer { display: flex; justify-content: flex-end; border-top: 1px solid #e2e8f0; padding-top: .8rem; }
@@media (max-width: 950px) { .workflow-route-grid { grid-template-columns: 1fr; } .workflow-conditional-editor { grid-template-columns: 1fr; } }
@@media (max-width: 650px) { .workflow-step-summary-main { flex-direction: column; align-items: flex-start; gap: .25rem; } .workflow-step-toggle-label { margin-inline-start: 0; } }
</style>

@section Scripts {
<script>
(function(){
 document.querySelectorAll('[data-stage-editor]').forEach(function(form){
   const type=form.querySelector('.assignment-type');
   if(!type)return;
   const position=form.querySelector('.assignment-position');
   const employee=form.querySelector('.assignment-employee');
   const fieldCode=form.querySelector('.assignment-field-code');
   const hierarchy=form.querySelector('.assignment-hierarchy');
   function sync(){
     const value=type.value;
     if(position)position.style.display=value==='Position'?'':'none';
     if(employee)employee.style.display=value==='Employee'?'':'none';
     if(fieldCode)fieldCode.style.display=value==='FieldPosition'?'':'none';
     if(hierarchy)hierarchy.style.display=value==='Hierarchy'?'':'none';
   }
   type.addEventListener('change',sync);sync();
 });
 document.querySelectorAll('.vacancy-policy').forEach(function(select){
   const step=select.dataset.step;
   const target=document.querySelector('.vacancy-substitute[data-step="'+step+'"]');
   function update(){if(target)target.style.display=select.value==='Substitute'?'':'none';}
   select.addEventListener('change',update);update();
 });
})();
</script>
}
