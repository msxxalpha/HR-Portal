@model HRPortal.Models.ContractRenewalWorkflowSettingsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تنظیم مراحل ثابت گردش کار تمدید قرارداد";
}
<div class="page-head">
    <div>
        <h1>تنظیم مراحل ثابت گردش کار تمدید قرارداد</h1>
        <p>تعیین جایگاه حراست و منابع انسانی و انتخاب حساب مدیرعامل</p>
    </div>
    <a class="btn btn-outline" href="/EmployeeContracts/BasicInformation">بازگشت به اطلاعات پایه</a>
</div>
@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error">@foreach (var error in ViewData.ModelState.Values.SelectMany(x => x.Errors)) { <div>@error.ErrorMessage</div> }</div>
}
<div class="contract-tabs" role="tablist" aria-label="اطلاعات پایه قراردادها">
    <a class="contract-tab" href="/EmployeeContracts/BasicInformation" role="tab">پرسش‌های ارزشیابی عملکرد کارکنان</a>
    <a class="contract-tab active" href="/EmployeeContracts/WorkflowSettings" role="tab" aria-selected="true">جایگاه‌های ثابت گردش کار</a>
</div>
<div class="card contract-settings-note">
    <strong>توجه</strong>
    <p>مراحل پویا از آخرین نسخه نهایی ساختار سازمانی ساخته می‌شوند و تا بالاترین جایگاه زیر مدیرعامل ادامه پیدا می‌کنند. تنظیمات این صفحه فقط برای سه مرحله ثابت پس از ارزیابی است.</p>
</div>
<form method="post" action="/EmployeeContracts/SaveWorkflowSettings" class="card form-stack contract-settings-form">
    @Html.AntiForgeryToken()
    <label>جایگاه مدیر حراست *
        <select name="securityPositionId" required>
            <option value="">انتخاب جایگاه</option>
            @foreach (var p in Model.Positions)
            {
                <option value="@p.Id" selected="@(Model.Settings.SecurityPositionId == p.Id)">@p.Title — @p.RankType (@p.Code)</option>
            }
        </select>
    </label>
    <label>جایگاه مدیر منابع انسانی و خدمات پشتیبانی *
        <select name="humanResourcesPositionId" required>
            <option value="">انتخاب جایگاه</option>
            @foreach (var p in Model.Positions)
            {
                <option value="@p.Id" selected="@(Model.Settings.HumanResourcesPositionId == p.Id)">@p.Title — @p.RankType (@p.Code)</option>
            }
        </select>
    </label>
    <label>کاربر مدیرعامل *
        <select name="ceoEmployeeId" required>
            <option value="">انتخاب کارمند مدیرعامل</option>
            @foreach (var e in Model.ActiveEmployees)
            {
                <option value="@e.Id" selected="@(Model.Settings.CeoEmployeeId == e.Id)">@e.FirstName @e.LastName — @e.PersonnelNumber — @e.PositionTitle</option>
            }
        </select>
        <small class="muted">در مدل فعلی ساختار سازمانی، مدیرعامل رده مستقلی از نوع گره سازمانی نیست؛ بنابراین وظیفه نهایی به حساب کاربری این کارمند اختصاص پیدا می‌کند.</small>
    </label>
    <div class="actions">
        <button class="btn btn-main" type="submit">ذخیره تنظیمات مسیر ثابت</button>
        <a class="btn btn-outline" href="/EmployeeContracts/Renewal">بازگشت به تمدید قرارداد</a>
    </div>
</form>