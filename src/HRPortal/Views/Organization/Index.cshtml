@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ساختار سازمانی";
    var revisions = ViewBag.Revisions as List<HRPortal.Models.OrganizationStructureRevision> ?? [];
    var editable = (bool?)ViewBag.IsEditable ?? false;
    var revisionId = (int?)ViewBag.RevisionId ?? 0;
    var treeJson = (string?)ViewBag.TreeJson ?? "[]";
    var companyName = (string?)ViewBag.CompanyName ?? "شرکت";
    var isAdmin = User.HasClaim("IsAdmin", "1");
}
<div class="page-head">
    <div>
        <h1>ساختار سازمانی</h1>
        <p>مدیریت ساختار به‌صورت درختی، بازنگری، افزودن، ویرایش، حذف و جابجایی نودها</p>
        <p class="muted">برای گردش کار پویا، «مدیرعامل» را در ریشه درخت تعریف کنید و معاونت‌ها را زیر آن قرار دهید. در هر نسخه فقط یک گره مدیرعامل مجاز است و باید به دقیقاً یک کارمند فعال تخصیص داده شود.</p>
    </div>
    <div class="actions">
        @if (editable && isAdmin)
        {
            <form method="post" action="/Organization/DeleteDraft" onsubmit="return confirm('تمام گره‌ها و تاریخچه این پیش‌نویس به‌طور کامل حذف شود؟ این عملیات قابل بازگشت نیست.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="revisionId" value="@revisionId" />
                <button class="btn btn-outline danger" type="submit">حذف کامل پیش‌نویس</button>
            </form>
        }
        @if (editable)
        {
            <form method="post" action="/Organization/Finalize">
                @Html.AntiForgeryToken()
                <input type="hidden" name="revisionId" value="@revisionId" />
                <button class="btn btn-main" type="submit">اتمام بازنگری و نهایی‌سازی</button>
            </form>
        }
    </div>
</div>

@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }

<div class="split">
    <section class="card">
        <div class="section-head">
            <div><h3>نسخه‌های ساختار</h3><span class="muted">نسخه جاری و سوابق بازنگری</span></div>
        </div>

        @if (!editable)
        {
            <div class="note">
                برای مدیر سامانه، در صورت نداشتن نسخه کاری، یک نسخه قابل ویرایش از ساختار جاری به‌صورت خودکار ایجاد می‌شود. نسخه‌های نهایی تاریخی فقط برای مشاهده هستند.
            </div>
        }

        <form method="post" action="/Organization/NewRevision" class="revision-create-form">
            @Html.AntiForgeryToken()
            <label>تاریخ اجرای نسخه
                <input name="effectiveDate" value="@HRPortal.Services.PersianDateService.Format(DateTime.Today)" placeholder="۱۴۰۵/۰۷/۰۵" required />
            </label>
            <label>عنوان بازنگری
                <input name="title" placeholder="مثلاً ساختار پیشنهادی ۱۴۰۵" required />
            </label>
            <label>یادداشت
                <textarea name="notes" placeholder="توضیحات بازنگری"></textarea>
            </label>
            <button class="btn btn-outline" type="submit">ایجاد نسخه بازنگری</button>
        </form>

        <div class="revision-list">
            @foreach (var dayGroup in revisions.GroupBy(r => r.EffectiveDate.Date).OrderByDescending(g => g.Key))
            {
                <div class="revision-day-group">
                    <div class="revision-day-heading">بازنگری‌های تاریخ @HRPortal.Services.PersianDateService.Format(dayGroup.Key)</div>
                    @foreach (var r in dayGroup.OrderByDescending(x => x.FinalizedAt).ThenByDescending(x => x.CreatedAt))
                    {
                        <a class="revision @(revisionId == r.Id ? "selected" : "")" href="/Organization?revisionId=@r.Id">
                            <strong>@r.Title</strong>
                            <span>@r.RevisionCode</span>
                            <span>@(r.IsFinalized ? "نهایی" : "در حال بازنگری")</span>
                        </a>
                    }
                </div>
            }
        </div>
    </section>

    <section class="card tree-card">
        <div class="section-head">
            <div>
                <h3>ساختار سازمانی - @companyName</h3>
                <span class="muted">
                    @(revisionId > 0 ? $"{ViewBag.RevisionTitle} | تاریخ اجرا: {ViewBag.EffectiveDate}" : "هنوز نسخه‌ای برای ساخت انتخاب نشده است")
                </span>
            </div>
            @if (editable)
            {
                <span class="badge">قابل ویرایش</span>
            }
            else
            {
                <span class="badge badge-neutral">فقط مشاهده</span>
            }
        </div>

        @if (revisionId > 0)
        {
            <div class="tree-help">
                <span>کلیک روی فلش: باز/بسته کردن</span>
                <span>کلیک راست: افزودن، ویرایش و حذف</span>
                <span>نگه‌داشتن کلیک چپ: کشیدن و رها کردن نود</span>
                <span>برای جابجایی، نود را روی نود مقصد یا ریشه رها کنید</span>
            </div>

            <div id="organizationTree" class="organization-tree" role="tree" aria-label="ساختار سازمانی" data-editable="@editable.ToString().ToLowerInvariant()"></div>
        }
        else
        {
            <div class="empty tree-empty">
                یک نسخه بازنگری ایجاد کنید تا ساخت درخت را آغاز کنید.
            </div>
        }
    </section>
</div>

<div class="card">
    <div class="section-head"><div><h3>تاریخچه تغییرات</h3><span class="muted">@ViewBag.ChangeCount تغییر ثبت‌شده برای نسخه انتخابی</span></div></div>
    @if (revisionId > 0)
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>نوع</th><th>کد</th><th>شرح</th><th>زمان</th></tr></thead>
                <tbody>
                @{
                    var revisionForLog = revisions.FirstOrDefault(x => x.Id == revisionId);
                }
                @if (revisionForLog?.Changes?.Any() == true)
                {
                    foreach (var change in revisionForLog.Changes.OrderByDescending(x => x.ChangedAt))
                    {
                        <tr><td>@change.ChangeType</td><td>@change.EntityCode</td><td>@change.Description</td><td>@change.ChangedAt.ToLocalTime()</td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="empty">تغییری ثبت نشده است.</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (editable)
{
    <div id="nodeModal" class="modal-backdrop hidden">
        <div class="modal-card">
            <div class="modal-head">
                <div><h3 id="nodeModalTitle">افزودن گره</h3><span id="nodeModalSubtitle">مشخصات گره سازمانی</span></div>
                <button type="button" class="modal-close" id="closeNodeModal">×</button>
            </div>
            <form id="nodeForm" class="form-stack">
                @Html.AntiForgeryToken()
                <input type="hidden" id="nodeId" />
                <input type="hidden" id="nodeParentId" />

                <div class="grid-2">
                    <label>عنوان گره *
                        <input id="nodeTitle" required />
                    </label>
                    <label>کد * <span class="muted">(پیشنهاد خودکار؛ قابل ویرایش)</span>
                        <input id="nodeCode" maxlength="100" required autocomplete="off" />
                        <small class="muted">برای گره جدید کد یکتا خودکار پیشنهاد می‌شود؛ پیش از ذخیره می‌توانید آن را تغییر دهید.</small>
                    </label>
                    <label>رده *
                        <select id="nodeRank" required></select>
                    </label>
                    <label>ترتیب نمایش
                        <input id="nodeSortOrder" type="number" value="0" />
                    </label>
                    <label class="wide">متصدی / مسئول این جایگاه
                        <select id="nodePositionHolder">
                            <option value="">بدون متصدی مشخص‌شده</option>
                        </select>
                        <small class="muted">برای ارزشیابی تمدید قرارداد، متصدی هر جایگاه از این فهرست مشخص می‌شود؛ مسیر به‌صورت خودکار تمام والدها را تا پیش از مدیرعامل طی می‌کند.</small>
                    </label>
                    <label class="inline-check">فعال
                        <input id="nodeActive" type="checkbox" checked />
                    </label>
                    <label class="wide">توضیحات
                        <textarea id="nodeNotes"></textarea>
                    </label>
                </div>

                <div id="nodeModalError" class="alert error hidden"></div>
                <div class="form-actions">
                    <button class="btn btn-outline" type="button" id="cancelNode">انصراف</button>
                    <button class="btn btn-main" type="submit">ذخیره</button>
                </div>
            </form>
        </div>
    </div>

    <div id="treeContextMenu" class="tree-context-menu hidden" role="menu">
        <button type="button" data-menu-action="create">افزودن زیرگره</button>
        <button type="button" data-menu-action="edit">ویرایش گره</button>
        <button type="button" data-menu-action="delete" class="danger">حذف گره</button>
    </div>
}

@section Scripts {
<script>
(function () {
    const editable = @editable.ToString().ToLowerInvariant();
    const revisionId = @revisionId;
    const companyName = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(companyName))";
    const nodes = @Html.Raw(treeJson);
    const organizationRanks = @Html.Raw((string?)ViewBag.OrganizationRankJson ?? "[]");
    const positionHolderEmployees = @Html.Raw((string?)ViewBag.PositionHolderEmployeesJson ?? "[]");
    const treeHost = document.getElementById("organizationTree");

    if (!revisionId || !treeHost) return;

    const token = document.querySelector('#nodeModal input[name="__RequestVerificationToken"]')?.value || "";
    const menu = document.getElementById("treeContextMenu");
    const state = { menuNodeId: null };

    const dataById = new Map();
    const childrenByParent = new Map();

    nodes.forEach(function (node) {
        const id = String(node.data.id);
        dataById.set(id, node.data);
        const parent = node.parent === "root" ? null : String(node.data.parentId || "");
        if (!childrenByParent.has(parent)) childrenByParent.set(parent, []);
        childrenByParent.get(parent).push(node.data);
    });

    function sortChildren(list) {
        return (list || []).slice().sort(function (a, b) {
            const ao = Number(a.sortOrder || 0);
            const bo = Number(b.sortOrder || 0);
            return ao - bo || String(a.title).localeCompare(String(b.title), "fa");
        });
    }

    function createElement(tag, className, text) {
        const el = document.createElement(tag);
        if (className) el.className = className;
        if (text != null) el.textContent = text;
        return el;
    }

    function buildTree() {
        treeHost.innerHTML = "";

        const rootLi = createElement("li", "org-tree-item org-tree-root");
        rootLi.dataset.nodeId = "root";

        const rootRow = createElement("div", "org-tree-row");
        rootRow.dataset.nodeId = "root";
        rootRow.setAttribute("role", "treeitem");

        const rootCaret = createElement("button", "org-tree-caret", "⌄");
        rootCaret.type = "button";
        rootCaret.title = "باز/بسته کردن";
        rootRow.appendChild(rootCaret);
        rootRow.appendChild(createElement("span", "org-tree-icon", "▦"));
        rootRow.appendChild(createElement("span", "org-tree-title", "ساختار سازمانی - " + companyName));
        rootRow.appendChild(createElement("span", "org-tree-rank root-rank", "ریشه"));
        rootLi.appendChild(rootRow);

        const rootChildren = createElement("ul", "org-tree-children");
        rootChildren.setAttribute("role", "group");
        appendChildren(rootChildren, null);
        rootLi.appendChild(rootChildren);
        treeHost.appendChild(rootLi);

        rootCaret.addEventListener("click", function (event) {
            event.stopPropagation();
            toggleChildren(rootLi, rootCaret);
        });

        attachTreeEvents(rootRow, "root");
    }

    function appendChildren(parentUl, parentId) {
        const children = sortChildren(childrenByParent.get(parentId) || []);
        if (!children.length) {
            const empty = createElement("li", "org-tree-empty");
            empty.textContent = parentId === null ? "هنوز هیچ نود سازمانی ایجاد نشده است. روی ریشه کلیک راست کنید." : "زیرگره‌ای ثبت نشده است.";
            if (!editable && parentId === null) empty.textContent = "در این نسخه نود سازمانی ثبت نشده است.";
            parentUl.appendChild(empty);
            return;
        }

        children.forEach(function (node) {
            const li = createElement("li", "org-tree-item");
            li.dataset.nodeId = String(node.id);
            li.setAttribute("role", "treeitem");

            const row = createElement("div", "org-tree-row" + (node.isActive ? "" : " is-disabled"));
            row.dataset.nodeId = String(node.id);
            row.draggable = !!editable;

            const childList = childrenByParent.get(String(node.id)) || [];
            const caret = createElement("button", "org-tree-caret", childList.length ? "⌄" : "•");
            caret.type = "button";
            caret.disabled = !childList.length;
            caret.title = childList.length ? "باز/بسته کردن" : "";

            row.appendChild(caret);
            row.appendChild(createElement("span", "org-tree-icon", "▸"));
            row.appendChild(createElement("span", "org-tree-title", node.title));
            row.appendChild(createElement("span", "org-tree-code", node.code));
            row.appendChild(createElement("span", "org-tree-rank", node.rankType));
            if (!node.isActive) row.appendChild(createElement("span", "org-tree-status", "غیرفعال"));

            li.appendChild(row);

            if (childList.length) {
                const childUl = createElement("ul", "org-tree-children");
                childUl.setAttribute("role", "group");
                appendChildren(childUl, String(node.id));
                li.appendChild(childUl);

                caret.addEventListener("click", function (event) {
                    event.stopPropagation();
                    toggleChildren(li, caret);
                });
            }

            parentUl.appendChild(li);
            attachTreeEvents(row, String(node.id));
        });
    }

    function toggleChildren(li, caret) {
        const list = li.querySelector(":scope > .org-tree-children");
        if (!list) return;
        const collapsed = list.classList.toggle("collapsed");
        caret.textContent = collapsed ? "‹" : "⌄";
    }

    function attachTreeEvents(row, nodeId) {
        row.addEventListener("contextmenu", function (event) {
            event.preventDefault();
            event.stopPropagation();
            if (!editable) return;
            showContextMenu(nodeId, event.clientX, event.clientY);
        });

        if (!editable) return;

        row.addEventListener("dragstart", function (event) {
            if (nodeId === "root") {
                event.preventDefault();
                return;
            }
            event.dataTransfer.effectAllowed = "move";
            event.dataTransfer.setData("text/plain", nodeId);
            row.classList.add("is-dragging");
        });

        row.addEventListener("dragend", function () {
            row.classList.remove("is-dragging");
            document.querySelectorAll(".is-drop-target").forEach(function (x) {
                x.classList.remove("is-drop-target");
            });
        });

        row.addEventListener("dragover", function (event) {
            if (nodeId === "root" || nodeId) {
                event.preventDefault();
                event.dataTransfer.dropEffect = "move";
                row.classList.add("is-drop-target");
            }
        });

        row.addEventListener("dragleave", function () {
            row.classList.remove("is-drop-target");
        });

        row.addEventListener("drop", function (event) {
            event.preventDefault();
            event.stopPropagation();
            row.classList.remove("is-drop-target");

            const draggedId = event.dataTransfer.getData("text/plain");
            if (!draggedId || draggedId === "root" || draggedId === nodeId) return;

            const targetChildren = nodeId === "root"
                ? (childrenByParent.get(null) || [])
                : (childrenByParent.get(String(nodeId)) || []);

            const parentId = nodeId === "root" ? "" : nodeId;
            const position = targetChildren.length * 10;

            api("/Organization/MoveNode", {
                id: draggedId,
                parentId: parentId,
                position: position
            }).then(function (result) {
                if (!result.success) {
                    alert(result.message || "جابجایی نود انجام نشد.");
                    return;
                }
                window.location.reload();
            }).catch(function () {
                alert("خطا در ارتباط با سرور هنگام جابجایی نود.");
            });
        });
    }

    function showContextMenu(nodeId, x, y) {
        state.menuNodeId = nodeId;
        menu.classList.remove("hidden");

        const edit = menu.querySelector('[data-menu-action="edit"]');
        const remove = menu.querySelector('[data-menu-action="delete"]');
        const create = menu.querySelector('[data-menu-action="create"]');

        const isRoot = nodeId === "root";
        edit.classList.toggle("hidden", isRoot);
        remove.classList.toggle("hidden", isRoot);
        create.textContent = isRoot ? "افزودن گره اصلی" : "افزودن زیرگره";

        const width = 190;
        const height = isRoot ? 50 : 125;
        menu.style.left = Math.min(x, window.innerWidth - width - 10) + "px";
        menu.style.top = Math.min(y, window.innerHeight - height - 10) + "px";
    }

    function hideContextMenu() {
        state.menuNodeId = null;
        menu.classList.add("hidden");
    }

    function nextNodeCode() {
        const usedCodes = new Set(Array.from(dataById.values())
            .map(function (node) { return String(node.code || "").trim().toLocaleUpperCase(); }));
        let number = 1;
        let candidate;
        do {
            candidate = "ORG-" + String(number).padStart(3, "0");
            number++;
        } while (usedCodes.has(candidate.toLocaleUpperCase()));
        return candidate;
    }

    function openNodeModal(mode, nodeId) {
        hideContextMenu();
        showNodeError("");

        const isEdit = mode === "edit";
        const node = isEdit ? dataById.get(String(nodeId)) : null;
        const parentNode = !isEdit && nodeId && nodeId !== "root" ? dataById.get(String(nodeId)) : null;
        const actualParentId = isEdit ? (node?.parentId == null ? "" : String(node.parentId)) : (parentNode ? String(parentNode.id) : "");

        document.getElementById("nodeModalTitle").textContent = isEdit ? "ویرایش گره" : "افزودن گره";
        document.getElementById("nodeModalSubtitle").textContent = isEdit ? "اطلاعات گره انتخاب‌شده" : "اطلاعات گره جدید";
        document.getElementById("nodeId").value = isEdit ? String(node.id) : "";
        document.getElementById("nodeParentId").value = actualParentId;

        document.getElementById("nodeTitle").value = isEdit ? node.title : "";
        document.getElementById("nodeCode").value = isEdit ? node.code : nextNodeCode();
        document.getElementById("nodeSortOrder").value = isEdit ? Number(node.sortOrder || 0) : 0;
        document.getElementById("nodeActive").checked = isEdit ? !!node.isActive : true;
        document.getElementById("nodeNotes").value = isEdit ? (node.notes || "") : "";
        const holderSelect = document.getElementById("nodePositionHolder");
        holderSelect.innerHTML = "";
        const noHolder = document.createElement("option");
        noHolder.value = "";
        noHolder.textContent = "بدون متصدی مشخص‌شده";
        holderSelect.appendChild(noHolder);
        positionHolderEmployees.forEach(function (employee) {
            const option = document.createElement("option");
            option.value = String(employee.id);
            option.textContent = employee.name + " (" + employee.personnelNumber + ")";
            if (isEdit && Number(node.positionHolderEmployeeId || 0) === Number(employee.id)) option.selected = true;
            holderSelect.appendChild(option);
        });

        const ranks = organizationRanks;
        const select = document.getElementById("nodeRank");
        select.innerHTML = "";

        ranks.forEach(function (rank) {
            const option = document.createElement("option");
            option.value = rank;
            option.textContent = rank;
            if (isEdit && node.rankType === rank) option.selected = true;
            select.appendChild(option);
        });

        if (isEdit && node && !ranks.includes(node.rankType)) {
            const option = document.createElement("option");
            option.value = node.rankType;
            option.textContent = node.rankType;
            option.selected = true;
            select.insertBefore(option, select.firstChild);
        }

        if (!select.options.length) {
            showNodeError("فهرست رده‌های سازمانی در اطلاعات پایه سامانه خالی است؛ ابتدا رده تعریف کنید.");
            return;
        }

        document.getElementById("nodeModal").classList.remove("hidden");
        document.getElementById("nodeTitle").focus();
        document.getElementById("nodeForm").dataset.mode = mode;
    }

    function closeNodeModal() {
        document.getElementById("nodeModal").classList.add("hidden");
        showNodeError("");
    }

    function showNodeError(message) {
        const box = document.getElementById("nodeModalError");
        box.textContent = message || "";
        box.classList.toggle("hidden", !message);
    }

    function api(url, values) {
        const body = new URLSearchParams();
        body.append("__RequestVerificationToken", token);
        Object.keys(values || {}).forEach(function (key) {
            body.append(key, values[key] == null ? "" : String(values[key]));
        });

        return fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                "X-Requested-With": "XMLHttpRequest"
            },
            body: body.toString()
        }).then(function (response) {
            if (!response.ok) throw new Error("HTTP " + response.status);
            return response.json();
        });
    }

    document.getElementById("nodeForm")?.addEventListener("submit", function (event) {
        event.preventDefault();
        showNodeError("");

        const mode = this.dataset.mode;
        const values = {
            revisionId: revisionId,
            code: document.getElementById("nodeCode").value.trim(),
            title: document.getElementById("nodeTitle").value.trim(),
            rankType: document.getElementById("nodeRank").value,
            sortOrder: Number(document.getElementById("nodeSortOrder").value || 0),
            isActive: document.getElementById("nodeActive").checked ? "true" : "false",
            notes: document.getElementById("nodeNotes").value,
            positionHolderEmployeeId: document.getElementById("nodePositionHolder").value
        };

        if (mode === "edit") {
            values.id = document.getElementById("nodeId").value;
        } else {
            values.parentId = document.getElementById("nodeParentId").value;
        }

        if (!values.title || !values.rankType) {
            showNodeError("عنوان و رده الزامی است. کد به‌صورت خودکار پیشنهاد می‌شود و قابل ویرایش است.");
            return;
        }

        const url = mode === "edit" ? "/Organization/UpdateNode" : "/Organization/CreateNode";
        api(url, values).then(function (result) {
            if (!result.success) {
                showNodeError(result.message || "ذخیره نود انجام نشد.");
                return;
            }
            closeNodeModal();
            window.location.reload();
        }).catch(function (error) {
            console.error(error);
            showNodeError("خطا در ارتباط با سرور.");
        });
    });

    menu?.addEventListener("click", function (event) {
        const button = event.target.closest("[data-menu-action]");
        if (!button || !state.menuNodeId) return;

        const action = button.dataset.menuAction;
        const nodeId = state.menuNodeId;

        if (action === "create") {
            openNodeModal("create", nodeId);
        } else if (action === "edit") {
            openNodeModal("edit", nodeId);
        } else if (action === "delete") {
            hideContextMenu();
            const node = dataById.get(String(nodeId));
            if (!node) return;
            if (!confirm("آیا از حذف گره «" + node.title + "» اطمینان دارید؟")) return;

            api("/Organization/DeleteNode", { id: nodeId }).then(function (result) {
                if (!result.success) {
                    alert(result.message || "حذف نود انجام نشد.");
                    return;
                }
                window.location.reload();
            }).catch(function () {
                alert("خطا در ارتباط با سرور هنگام حذف نود.");
            });
        }
    });

    treeHost.addEventListener("contextmenu", function (event) {
        event.preventDefault();
    }, true);

    document.addEventListener("click", function (event) {
        if (menu && !menu.contains(event.target)) hideContextMenu();
    });

    document.addEventListener("scroll", hideContextMenu, true);
    window.addEventListener("resize", hideContextMenu);
    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            hideContextMenu();
            closeNodeModal();
        }
    });

    document.getElementById("closeNodeModal")?.addEventListener("click", closeNodeModal);
    document.getElementById("cancelNode")?.addEventListener("click", closeNodeModal);
    document.getElementById("nodeModal")?.addEventListener("click", function (event) {
        if (event.target === this) closeNodeModal();
    });

    buildTree();
})();
</script>
}