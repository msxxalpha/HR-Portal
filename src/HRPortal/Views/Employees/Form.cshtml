@model HRPortal.Controllers.EmployeesController.FormVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var edit = Model.Employee.Id > 0;
    ViewData["Title"] = edit ? "ویرایش کارمند" : "کارمند جدید";
}
<div class="page-head">
    <div><h1>@ViewData["Title"]</h1><p>اطلاعات شناسایی و ارتباطی کارمند</p></div>
    <a class="btn btn-outline" href="/Employees">بازگشت</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error">
    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }
    </div>
}

<form method="post" action="/Employees/@(edit ? "Edit" : "Create")" class="employee-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Employee.Id" />

    <div class="card">
        <div class="section-head"><div><h3>اطلاعات اصلی</h3><span class="muted">موارد دارای * اجباری هستند.</span></div></div>
        <div class="grid-3">
            <label>شماره پرسنلی *<input name="PersonnelNumber" value="@Model.Employee.PersonnelNumber" required autocomplete="off" /></label>
            <label>شناسه *<input name="Identifier" value="@Model.Employee.Identifier" required autocomplete="off" /></label>
            <label>کد ملی *<input name="NationalId" value="@Model.Employee.NationalId" required inputmode="numeric" autocomplete="off" /></label>
            <label>نام *<input name="FirstName" value="@Model.Employee.FirstName" required /></label>
            <label>نام خانوادگی *<input name="LastName" value="@Model.Employee.LastName" required /></label>
            <label>شماره موبایل *<input name="Mobile" value="@Model.Employee.Mobile" required inputmode="tel" autocomplete="tel" /></label>
            <label>جنسیت *
                <select name="Gender" required>
                    <option value="">انتخاب کنید</option>
                    @if (Model.Employee.Gender == "مرد")
                    {
                        <option value="مرد" selected>مرد</option>
                    }
                    else
                    {
                        <option value="مرد">مرد</option>
                    }
                    @if (Model.Employee.Gender == "زن")
                    {
                        <option value="زن" selected>زن</option>
                    }
                    else
                    {
                        <option value="زن">زن</option>
                    }
                </select>
            </label>
            <label>نام پدر<input name="FatherName" value="@Model.Employee.FatherName" /></label>
            <label>ایمیل<input name="Email" value="@Model.Employee.Email" type="email" /></label>
            <label>سمت / پست سازمانی
                <input type="search" id="positionFilter" placeholder="جست‌وجوی کد یا عنوان پست..." autocomplete="off" />
                <select name="PositionTitle" id="positionSelect">
                    <option value="">بدون سمت مشخص‌شده</option>
                    @foreach (var p in Model.Positions)
                    {
                        <option value="@p.Title" data-active="@p.IsActive.ToString().ToLowerInvariant()"
                                data-search="@($"{p.Code} {p.Title} {p.JobFamily} {p.Grade}")"
                                selected="@(Model.Employee.PositionTitle == p.Title)">
                            @p.Title (@p.Code)@(p.IsActive ? "" : " - غیرفعال / عنوان قبلی")
                        </option>
                    }
                </select>
                <small class="muted">برای تخصیص یا تغییر سمت، یک پست فعال انتخاب کنید. سمت‌های غیرفعال فقط برای حفظ اطلاعات قبلی نمایش داده می‌شوند.</small>
            </label>
            <label class="inline-check">غیرقراردادی
                <input type="checkbox" id="isNonContractual" name="isNonContractual" value="true" checked="@(Model.Employee.EmploymentType == "غیرقراردادی")" />
            </label>
            <label>تاریخ پایان قرارداد
                <input type="text" id="contractEndDatePersian" name="contractEndDatePersian"
                       value="@(Model.Employee.ContractEndDate.HasValue ? HRPortal.Services.PersianDateService.Format(Model.Employee.ContractEndDate.Value) : "")"
                       data-jdp data-jdp-only-date autocomplete="off" placeholder="۱۴۰۵/۱۲/۲۹"
                       disabled="@(Model.Employee.EmploymentType == "غیرقراردادی")" />
            </label>
            <label>وضعیت
                <select name="Status">
                    @if (Model.Employee.Status != "غیرفعال")
                    {
                        <option value="فعال" selected>فعال</option>
                    }
                    else
                    {
                        <option value="فعال">فعال</option>
                    }
                    @if (Model.Employee.Status == "غیرفعال")
                    {
                        <option value="غیرفعال" selected>غیرفعال</option>
                    }
                    else
                    {
                        <option value="غیرفعال">غیرفعال</option>
                    }
                </select>
            </label>
        </div>
    </div>

    <div class="card">
        <div class="section-head"><div><h3>ساختار سازمانی</h3><span class="muted">اداره و بخش متناسب با انتخاب والد فیلتر می‌شوند.</span></div></div>
        <div class="grid-3">
            <label>واحد سازمانی
                <select name="OrganizationUnitId" id="unitSelect">
                    <option value="">انتخاب واحد</option>
                    @foreach (var n in Model.Units)
                    {
                        @if (Model.Employee.OrganizationUnitId == n.Id)
                        {
                            <option value="@n.Id" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
            <label>اداره سازمانی
                <select name="OrganizationDepartmentId" id="departmentSelect">
                    <option value="">انتخاب اداره</option>
                    @foreach (var n in Model.Departments)
                    {
                        @if (Model.Employee.OrganizationDepartmentId == n.Id)
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
            <label>بخش سازمانی
                <select name="OrganizationSectionId" id="sectionSelect">
                    <option value="">انتخاب بخش</option>
                    @foreach (var n in Model.Sections)
                    {
                        @if (Model.Employee.OrganizationSectionId == n.Id)
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
        </div>
        <div class="grid-2">
            <label>جایگاه سازمانی ویژه (مدیرعامل)
                <select name="OrganizationPositionId">
                    <option value="">بدون جایگاه ویژه</option>
                    @foreach (var n in Model.SpecialPositions)
                    {
                        <option value="@n.Id" selected="@(Model.Employee.OrganizationPositionId == n.Id)">@n.Title (@n.Code)</option>
                    }
                </select>
                <small class="muted">این گزینه فقط برای تعیین مدیرعامل استفاده می‌شود. در میان کارکنان فعال، این رده فقط به یک نفر قابل اختصاص است.</small>
            </label>
        </div>
    </div>

    <div class="form-actions"><button class="btn btn-main" type="submit">@(edit ? "ذخیره تغییرات" : "ثبت کارمند")</button></div>
</form>

@section Scripts {
<script>
(function(){
    const nonContractual = document.getElementById('isNonContractual');
    const contractEndDate = document.getElementById('contractEndDatePersian');
    function syncEmploymentType() {
        const isNonContract = nonContractual.checked;
        contractEndDate.disabled = isNonContract;
        if (isNonContract) contractEndDate.value = '';
        else if (!contractEndDate.value) contractEndDate.value = '۱۴۰۵/۱۲/۲۹';
    }
    nonContractual.addEventListener('change', syncEmploymentType);
    syncEmploymentType();

    const positionFilter = document.getElementById('positionFilter');
    const positionSelect = document.getElementById('positionSelect');
    positionFilter.addEventListener('input', function () {
        const term = this.value.trim().toLocaleLowerCase();
        Array.from(positionSelect.options).forEach(function (opt, index) {
            if (index === 0) { opt.hidden = false; return; }
            const haystack = (opt.dataset.search || opt.textContent || '').toLocaleLowerCase();
            opt.hidden = !!term && !haystack.includes(term);
        });
    });

    const unit = document.getElementById('unitSelect');
    const department = document.getElementById('departmentSelect');
    const section = document.getElementById('sectionSelect');

    function filterChildren(parentSelect, childSelect) {
        const parentId = parentSelect.value;
        Array.from(childSelect.options).forEach(function(opt, index){
            if (index === 0) { opt.hidden = false; return; }
            const show = !!parentId && opt.dataset.parentId === parentId;
            opt.hidden = !show;
        });
    }

    function resetInvalidSelection(select) {
        if (select.selectedOptions.length && select.selectedOptions[0].hidden)
            select.value = "";
    }

    function refresh() {
        filterChildren(unit, department);
        resetInvalidSelection(department);
        filterChildren(department, section);
        resetInvalidSelection(section);
    }

    unit.addEventListener('change', function(){
        filterChildren(unit, department);
        department.value = "";
        section.value = "";
        filterChildren(department, section);
    });

    department.addEventListener('change', function(){
        section.value = "";
        filterChildren(department, section);
    });

    refresh();
})();
</script>
<style>
#contractDatePicker {
    position: fixed; z-index: 100000; width: 286px; padding: 12px;
    background: #fff; border: 1px solid #d8e1e8; border-radius: 12px;
    box-shadow: 0 12px 34px rgba(15,37,53,.22); color: #1d2a34;
    font-family: inherit; direction: rtl;
}
#contractDatePicker[hidden] { display: none !important; }
#contractDatePicker .cdp-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:10px; }
#contractDatePicker .cdp-title { font-weight:700; color:#17324d; }
#contractDatePicker button { font:inherit; cursor:pointer; }
#contractDatePicker .cdp-nav, #contractDatePicker .cdp-today {
    border:1px solid #dce5eb; background:#f7fafc; border-radius:7px; padding:5px 9px;
}
#contractDatePicker .cdp-week, #contractDatePicker .cdp-days { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:3px; text-align:center; }
#contractDatePicker .cdp-week { margin-bottom:5px; color:#71808b; font-size:11px; }
#contractDatePicker .cdp-days button { border:1px solid transparent; background:#fff; border-radius:7px; padding:7px 0; min-width:0; }
#contractDatePicker .cdp-days button:hover { background:#edf4f8; border-color:#cbd9e2; }
#contractDatePicker .cdp-days button.cdp-selected { background:#17324d; color:#fff; }
#contractDatePicker .cdp-days button.cdp-today-mark { border-color:#7897ad; }
#contractDatePicker .cdp-foot { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-top:10px; }
#contractDatePicker .cdp-today { color:#17324d; }
</style>
<div id="contractDatePicker" hidden role="dialog" aria-label="تقویم شمسی">
    <div class="cdp-head">
        <button type="button" class="cdp-nav" id="cdpPrev" aria-label="ماه قبل">‹</button>
        <span class="cdp-title" id="cdpTitle"></span>
        <button type="button" class="cdp-nav" id="cdpNext" aria-label="ماه بعد">›</button>
    </div>
    <div class="cdp-week"><span>ش</span><span>ی</span><span>د</span><span>س</span><span>چ</span><span>پ</span><span>ج</span></div>
    <div class="cdp-days" id="cdpDays"></div>
    <div class="cdp-foot"><button type="button" class="cdp-today" id="cdpToday">امروز</button><button type="button" class="cdp-today" id="cdpClose">بستن</button></div>
</div>
<script>
(function () {
    'use strict';
    const input = document.getElementById('contractEndDatePersian');
    const nonContractual = document.getElementById('isNonContractual');
    const popup = document.getElementById('contractDatePicker');
    const title = document.getElementById('cdpTitle');
    const daysHost = document.getElementById('cdpDays');
    if (!input || !nonContractual || !popup || !window.Intl || !Intl.DateTimeFormat.prototype.formatToParts) return;

    const monthNames = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
    const numberFa = new Intl.NumberFormat('fa-IR-u-nu-latn', { useGrouping: false });
    const persianNumber = new Intl.NumberFormat('fa-IR', { useGrouping: false });
    const calendarFormat = new Intl.DateTimeFormat('en-US-u-ca-persian-nu-latn', {
        year: 'numeric', month: 'numeric', day: 'numeric', timeZone: 'UTC'
    });
    let shownYear = 1405, shownMonth = 1, selectedKey = '';
    const utcDay = date => new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
    function persianParts(date) {
        const result = {};
        calendarFormat.formatToParts(date).forEach(p => {
            if (p.type === 'year' || p.type === 'month' || p.type === 'day') result[p.type] = Number(p.value);
        });
        return result;
    }
    function monthStart(year, month) {
        const start = Date.UTC(year + 621, 2, 1);
        for (let i = 0; i < 370; i++) {
            const candidate = new Date(start + i * 86400000);
            const p = persianParts(candidate);
            if (p.year === year && p.month === month && p.day === 1) return candidate;
        }
        throw new Error('Persian calendar month could not be resolved.');
    }
    function dateForPersian(year, month, day) {
        return new Date(monthStart(year, month).getTime() + (day - 1) * 86400000);
    }
    function normalizeDigits(value) {
        return String(value || '').replace(/[۰-۹]/g, c => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(c)))
            .replace(/[٠-٩]/g, c => String('٠١٢٣٤٥٦٧٨٩'.indexOf(c))).replace(/-/g, '/').trim();
    }
    function parseInput() {
        const m = normalizeDigits(input.value).match(/^(\d{4})\/(\d{1,2})\/(\d{1,2})$/);
        if (!m) return null;
        const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);
        if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
        try {
            const date = dateForPersian(y, mo, d), p = persianParts(date);
            return p.year === y && p.month === mo && p.day === d ? { year:y, month:mo, day:d, date } : null;
        } catch (_) { return null; }
    }
    function key(y, m, d) { return y + '/' + String(m).padStart(2,'0') + '/' + String(d).padStart(2,'0'); }
    function positionPopup() {
        const r = input.getBoundingClientRect();
        popup.style.top = Math.min(window.innerHeight - popup.offsetHeight - 8, r.bottom + 5) + 'px';
        popup.style.left = Math.max(8, Math.min(window.innerWidth - popup.offsetWidth - 8, r.left)) + 'px';
    }
    function render() {
        title.textContent = monthNames[shownMonth - 1] + ' ' + numberFa.format(shownYear);
        daysHost.replaceChildren();
        const first = monthStart(shownYear, shownMonth);
        const offset = (first.getUTCDay() + 1) % 7; // Persian week begins Saturday.
        const today = new Date();
        const todayParts = persianParts(new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate())));
        // Month 12's next month belongs to the next Persian year.
        const nextStart = shownMonth === 12 ? monthStart(shownYear + 1, 1) : monthStart(shownYear, shownMonth + 1);
        const daysInMonth = Math.round((nextStart.getTime() - first.getTime()) / 86400000);
        for (let i = 0; i < offset; i++) daysHost.appendChild(document.createElement('span'));
        for (let d = 1; d <= daysInMonth; d++) {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = persianNumber.format(d);
            const dateKey = key(shownYear, shownMonth, d);
            if (dateKey === selectedKey) button.classList.add('cdp-selected');
            if (todayParts.year === shownYear && todayParts.month === shownMonth && todayParts.day === d) button.classList.add('cdp-today-mark');
            button.addEventListener('click', function () {
                input.value = dateKey;
                input.dispatchEvent(new Event('change', { bubbles: true }));
                close();
            });
            daysHost.appendChild(button);
        }
        positionPopup();
    }
    function open() {
        if (input.disabled || nonContractual.checked) return;
        const parsed = parseInput();
        let y, m;
        if (parsed) { y = parsed.year; m = parsed.month; selectedKey = key(parsed.year, parsed.month, parsed.day); }
        else {
            const now = new Date();
            const p = persianParts(new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())));
            y = p.year; m = p.month; selectedKey = '';
        }
        shownYear = y; shownMonth = m;
        popup.hidden = false;
        render();
    }
    function close() { popup.hidden = true; }
    function changeMonth(delta) {
        shownMonth += delta;
        if (shownMonth < 1) { shownMonth = 12; shownYear--; }
        if (shownMonth > 12) { shownMonth = 1; shownYear++; }
        render();
    }
    document.getElementById('cdpPrev').addEventListener('click', () => changeMonth(-1));
    document.getElementById('cdpNext').addEventListener('click', () => changeMonth(1));
    document.getElementById('cdpToday').addEventListener('click', () => {
        const now = new Date(), p = persianParts(new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())));
        input.value = key(p.year, p.month, p.day);
        input.dispatchEvent(new Event('change', { bubbles: true }));
        close();
    });
    document.getElementById('cdpClose').addEventListener('click', close);
    input.addEventListener('focus', open);
    input.addEventListener('click', open);
    input.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
    document.addEventListener('pointerdown', e => {
        if (!popup.hidden && e.target !== input && !popup.contains(e.target)) close();
    });
    window.addEventListener('resize', () => { if (!popup.hidden) positionPopup(); });
    window.addEventListener('scroll', () => { if (!popup.hidden) positionPopup(); }, true);

    function syncEmploymentType() {
        const isNonContract = nonContractual.checked;
        input.disabled = isNonContract;
        if (isNonContract) { input.value = ''; close(); }
        else if (!input.value) input.value = '۱۴۰۵/۱۲/۲۹';
    }
    nonContractual.addEventListener('change', syncEmploymentType);
    syncEmploymentType();
})();
</script>
}