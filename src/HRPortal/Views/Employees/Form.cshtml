@model HRPortal.Controllers.EmployeesController.FormVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var edit = Model.Employee.Id > 0;
    ViewData["Title"] = edit ? "ویرایش کارمند" : "کارمند جدید";
}
<div class="page-head">
    <div><h1>@ViewData["Title"]</h1><p>اطلاعات شناسایی و ارتباطی کارمند</p></div>
    <a class="btn btn-outline" href="/Employees">بازگشت</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error">
    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }
    </div>
}

<form method="post" action="/Employees/@(edit ? "Edit" : "Create")" class="employee-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Employee.Id" />

    <div class="card">
        <div class="section-head"><div><h3>اطلاعات اصلی</h3><span class="muted">موارد دارای * اجباری هستند.</span></div></div>
        <div class="grid-3">
            <label>شماره پرسنلی *<input name="PersonnelNumber" value="@Model.Employee.PersonnelNumber" required autocomplete="off" /></label>
            <label>شناسه *<input name="Identifier" value="@Model.Employee.Identifier" required autocomplete="off" /></label>
            <label>کد ملی *<input name="NationalId" value="@Model.Employee.NationalId" required inputmode="numeric" autocomplete="off" /></label>
            <label>نام *<input name="FirstName" value="@Model.Employee.FirstName" required /></label>
            <label>نام خانوادگی *<input name="LastName" value="@Model.Employee.LastName" required /></label>
            <label>شماره موبایل *<input name="Mobile" value="@Model.Employee.Mobile" required inputmode="tel" autocomplete="tel" /></label>
            <label>جنسیت *
                <select name="Gender" required>
                    <option value="">انتخاب کنید</option>
                    @if (Model.Employee.Gender == "مرد")
                    {
                        <option value="مرد" selected>مرد</option>
                    }
                    else
                    {
                        <option value="مرد">مرد</option>
                    }
                    @if (Model.Employee.Gender == "زن")
                    {
                        <option value="زن" selected>زن</option>
                    }
                    else
                    {
                        <option value="زن">زن</option>
                    }
                </select>
            </label>
            <label>نام پدر<input name="FatherName" value="@Model.Employee.FatherName" /></label>
            <label>ایمیل<input name="Email" value="@Model.Employee.Email" type="email" /></label>
            <label>سمت<input name="PositionTitle" value="@Model.Employee.PositionTitle" /></label>
            <label class="inline-check">غیرقراردادی
                <input type="checkbox" id="isNonContractual" name="isNonContractual" value="true" checked="@(Model.Employee.EmploymentType == "غیرقراردادی")" />
            </label>
            <label>تاریخ پایان قرارداد
                <input type="text" id="contractEndDatePersian" name="contractEndDatePersian"
                       value="@(Model.Employee.ContractEndDate.HasValue ? HRPortal.Services.PersianDateService.Format(Model.Employee.ContractEndDate.Value) : "")"
                       data-jdp data-jdp-only-date autocomplete="off" placeholder="۱۴۰۵/۱۲/۲۹"
                       disabled="@(Model.Employee.EmploymentType == "غیرقراردادی")" />
            </label>
            <label>وضعیت
                <select name="Status">
                    @if (Model.Employee.Status != "غیرفعال")
                    {
                        <option value="فعال" selected>فعال</option>
                    }
                    else
                    {
                        <option value="فعال">فعال</option>
                    }
                    @if (Model.Employee.Status == "غیرفعال")
                    {
                        <option value="غیرفعال" selected>غیرفعال</option>
                    }
                    else
                    {
                        <option value="غیرفعال">غیرفعال</option>
                    }
                </select>
            </label>
        </div>
    </div>

    <div class="card">
        <div class="section-head"><div><h3>ساختار سازمانی</h3><span class="muted">اداره و بخش متناسب با انتخاب والد فیلتر می‌شوند.</span></div></div>
        <div class="grid-3">
            <label>واحد سازمانی
                <select name="OrganizationUnitId" id="unitSelect">
                    <option value="">انتخاب واحد</option>
                    @foreach (var n in Model.Units)
                    {
                        @if (Model.Employee.OrganizationUnitId == n.Id)
                        {
                            <option value="@n.Id" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
            <label>اداره سازمانی
                <select name="OrganizationDepartmentId" id="departmentSelect">
                    <option value="">انتخاب اداره</option>
                    @foreach (var n in Model.Departments)
                    {
                        @if (Model.Employee.OrganizationDepartmentId == n.Id)
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
            <label>بخش سازمانی
                <select name="OrganizationSectionId" id="sectionSelect">
                    <option value="">انتخاب بخش</option>
                    @foreach (var n in Model.Sections)
                    {
                        @if (Model.Employee.OrganizationSectionId == n.Id)
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId" selected>@n.Title (@n.Code)</option>
                        }
                        else
                        {
                            <option value="@n.Id" data-parent-id="@n.ParentId">@n.Title (@n.Code)</option>
                        }
                    }
                </select>
            </label>
        </div>
    </div>

    <div class="form-actions"><button class="btn btn-main" type="submit">@(edit ? "ذخیره تغییرات" : "ثبت کارمند")</button></div>
</form>

@section Scripts {
<script>
(function(){
    const nonContractual = document.getElementById('isNonContractual');
    const contractEndDate = document.getElementById('contractEndDatePersian');
    function syncEmploymentType() {
        const isNonContract = nonContractual.checked;
        contractEndDate.disabled = isNonContract;
        if (isNonContract) contractEndDate.value = '';
        else if (!contractEndDate.value) contractEndDate.value = '۱۴۰۵/۱۲/۲۹';
    }
    nonContractual.addEventListener('change', syncEmploymentType);
    syncEmploymentType();

    const unit = document.getElementById('unitSelect');
    const department = document.getElementById('departmentSelect');
    const section = document.getElementById('sectionSelect');

    function filterChildren(parentSelect, childSelect) {
        const parentId = parentSelect.value;
        Array.from(childSelect.options).forEach(function(opt, index){
            if (index === 0) { opt.hidden = false; return; }
            const show = !!parentId && opt.dataset.parentId === parentId;
            opt.hidden = !show;
        });
    }

    function resetInvalidSelection(select) {
        if (select.selectedOptions.length && select.selectedOptions[0].hidden)
            select.value = "";
    }

    function refresh() {
        filterChildren(unit, department);
        resetInvalidSelection(department);
        filterChildren(department, section);
        resetInvalidSelection(section);
    }

    unit.addEventListener('change', function(){
        filterChildren(unit, department);
        department.value = "";
        section.value = "";
        filterChildren(department, section);
    });

    department.addEventListener('change', function(){
        section.value = "";
        filterChildren(department, section);
    });

    refresh();
})();
</script>
<script src="https://unpkg.com/@majidh1/jalalidatepicker/dist/jalalidatepicker.min.js"></script>
<script>if (window.jalaliDatepicker) window.jalaliDatepicker.startWatch({ time: false, autoShow: true, autoHide: true, hideAfterChange: true, persianDigits: true });</script>
}