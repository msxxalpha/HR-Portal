
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "فیش حقوقی";
}
<div class="page-head">
    <div>
        <h1>فیش حقوقی</h1>
        <p>شماره پرسنلی از حساب کاربر لاگین‌شده دریافت می‌شود و در فرم قابل تغییر نیست.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error">
        @foreach (var item in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        { <div>@item.ErrorMessage</div> }
    </div>
}

@if (ViewBag.Message != null)
{
    <div class="alert @(ViewBag.ReportUrl == null ? "error" : "success")">@ViewBag.Message</div>
}

<div class="card">
    <div class="report-user-row">
        <div class="report-user">
            <span>کاربر جاری</span>
            <strong>@User.Identity?.Name</strong>
            @if (ViewBag.PersonnelNumber != null)
            {
                <small>شماره پرسنلی: @ViewBag.PersonnelNumber</small>
            }
            else
            {
                <small>حساب مدیر سامانه</small>
            }
        </div>

        @if (ViewBag.PersonnelNumber != null)
        {
            <form method="post" asp-controller="Payroll" asp-action="GeneratePayslip" class="report-filter report-filter-inline">
                @Html.AntiForgeryToken()
                <label class="report-period">
                    سال / ماه
                    <input name="yearMonth"
                           value="@ViewBag.YearMonth"
                           placeholder="۱۴۰۵/۰۶"
                           maxlength="7"
                           inputmode="numeric"
                           autocomplete="off"
                           required />
                </label>
                <button class="btn btn-main" type="submit">مشاهده فیش حقوقی</button>
            </form>
        }
    </div>
</div>

@if (ViewBag.ReportUrl != null)
{
    <div class="report-frame">
        <iframe src="@ViewBag.ReportUrl" title="گزارش فیش حقوقی"></iframe>
    </div>
}