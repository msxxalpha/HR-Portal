@inject HRPortal.Services.EnvironmentSettingsService SettingsService
@{
    var cfg = await SettingsService.GetAsync();
    var company = cfg.System;
    var isAdmin = User.HasClaim("IsAdmin", "1");
    bool Can(string permission) => isAdmin || User.HasClaim("Permission", permission);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@company.PrimaryColor" />
    <title>@ViewData["Title"] - @company.ApplicationName</title>
    @if (!string.IsNullOrWhiteSpace(company.FaviconUrl))
    {
        <link rel="icon" href="@company.FaviconUrl" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
</head>
<body style="--navy:@company.PrimaryColor;--navy2:@company.SecondaryColor;">
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">@company.ShortName</div>
            <div class="brand-text">
                <strong>@company.ApplicationName</strong>
                <small>@company.OrganizationName</small>
            </div>
        </div>

        <nav class="nav">
            <div class="nav-caption">داشبورد</div>
            <a href="/"><span class="nav-icon">⌂</span>داشبورد</a>

            @if (Can("Workflow.Inbox"))
            {
                <div class="nav-caption">درخواست‌ها</div>
                <a href="/Workflow/MyRequests"><span class="nav-icon">▤</span>درخواست‌های من</a>
                <a href="/Workflow/Inbox" class="nav-emphasis"><span class="nav-icon">▣</span>کارتابل <span class="nav-badge">•</span></a>
            }

            @if (Can("Announcements.Manage"))
            {
                <div class="nav-caption">اطلاعیه‌ها</div>
                <a href="/Announcements"><span class="nav-icon">⚑</span>اطلاعیه‌ها</a>
            }

            @if (Can("Employees.View") || Can("Organization.View"))
            {
                <div class="nav-caption">اطلاعات پایه</div>
                @if (Can("Employees.View")) { <a href="/Employees"><span class="nav-icon">♙</span>کارکنان</a> }
                @if (Can("Organization.View")) { <a href="/Organization"><span class="nav-icon">⌘</span>ساختار سازمانی</a> }
            }

            @if (Can("Reports.View"))
            {
                <div class="nav-caption">گزارش‌ها</div>
                <a href="/Reports"><span class="nav-icon">▥</span>گزارش‌ها</a>
            }

            @if (Can("Payroll.View") || Can("PersonnelOrder.View"))
            {
                <div class="nav-caption">خدمات کارکنان</div>
                @if (Can("Payroll.View")) { <a href="/Payroll/Payslip"><span class="nav-icon">▥</span>فیش حقوقی</a> }
                @if (Can("PersonnelOrder.View")) { <a href="/PersonnelOrder"><span class="nav-icon">▤</span>حکم کارگزینی</a> }
            }

            @if (Can("Users.Manage") || Can("Roles.Manage") || Can("Workflow.Manage") || Can("Settings.View"))
            {
                <div class="nav-caption">تنظیمات و مدیریت</div>
                @if (Can("Users.Manage") || Can("Roles.Manage")) { <a href="/Users"><span class="nav-icon">♟</span>کاربران و نقش‌ها</a> }
                @if (Can("Workflow.Manage")) { <a href="/Workflow/Manage"><span class="nav-icon">⇄</span>مدیریت گردش کار</a> }
                @if (Can("Settings.View")) { <a href="/SystemSettings"><span class="nav-icon">⚙</span>تنظیمات سامانه</a> }
            }

            <div class="nav-caption">پشتیبانی</div>
            <a href="/Support"><span class="nav-icon">?</span>راهنما و پشتیبانی</a>

            @if (isAdmin)
            {
                <div class="nav-caption">حساب کاربری</div>
                <a href="/Account/ChangePassword"><span class="nav-icon">⌁</span>تغییر رمز مدیر</a>
            }
            else if (User.HasClaim("UserType", "Employee"))
            {
                <div class="nav-caption">حساب کاربری</div>
                <a href="/Account/PersonalPassword"><span class="nav-icon">⌁</span>رمز عبور شخصی</a>
            }
        </nav>

        <div class="sidebar-foot">
            @(isAdmin ? "مدیر سامانه" : "کاربر کارکنان")
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div>
                <div class="topbar-caption">@company.ApplicationName</div>
                <h2>@ViewData["Title"]</h2>
            </div>
            <div class="user-box">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>@User.Identity.Name</span>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button class="link" type="submit">خروج</button>
                    </form>
                }
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>
                @(string.IsNullOrWhiteSpace(company.FooterText) ? company.ApplicationName : company.FooterText)
                @if (!string.IsNullOrWhiteSpace(company.OrganizationName))
                {
                    <span> | @company.OrganizationName</span>
                }
            </span>
            <span class="build-version">Build @HRPortal.BuildInfo.Number</span>
        </footer>
    </div>
</div>
@RenderSection("Scripts", required: false)
</body>
</html>