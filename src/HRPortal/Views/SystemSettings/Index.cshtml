@model HRPortal.Models.SystemSettingsEditModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تنظیمات سامانه";

    string S(string? value) => value ?? "";
    string C(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value!;
}
<div class="page-head">
    <div>
        <h1>تنظیمات سامانه</h1>
        <p>تنظیمات عمومی، ظاهر، امنیت، پیامک، فیش حقوقی و نگهداری</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert error">@TempData["Error"]</div>
}

<form method="post" action="/SystemSettings/Save" id="systemSettingsForm" autocomplete="off">
    @Html.AntiForgeryToken()

    <div class="tabs settings-tabs">
        <button type="button" class="tab active" data-tab="general">عمومی</button>
        <button type="button" class="tab" data-tab="appearance">ظاهر و برند</button>
        <button type="button" class="tab" data-tab="security">امنیت و OTP</button>
        <button type="button" class="tab" data-tab="sms">سرویس پیامک</button>
        <button type="button" class="tab" data-tab="payroll">فیش حقوقی / SSRS</button>
        <button type="button" class="tab" data-tab="queries">کوئری‌های ورودی</button>
        <button type="button" class="tab" data-tab="personnel-order">حکم کارگزینی / SSRS</button>
        <button type="button" class="tab" data-tab="announcement-categories">اطلاعات پایه / دسته‌بندی اطلاعیه</button>
        <button type="button" class="tab" data-tab="maintenance">نگهداری</button>
    </div>

    <section id="general" class="tab-panel active">
        <div class="settings-section-intro">
            <strong>تنظیمات عمومی سامانه</strong>
            <span>در نسخه اول، هیچ‌یک از فیلدهای این بخش اجباری نیست.</span>
        </div>
        <div class="grid-3">
            <label>نام سامانه
                <input name="ApplicationName" value="@S(Model.ApplicationName)" />
            </label>
            <label>نام سازمان
                <input name="OrganizationName" value="@S(Model.OrganizationName)" />
            </label>
            <label>نام کوتاه
                <input name="ShortName" value="@S(Model.ShortName)" />
            </label>
            <label>شعار
                <input name="Slogan" value="@S(Model.Slogan)" />
            </label>
            <label>تلفن
                <input name="Phone" value="@S(Model.Phone)" />
            </label>
            <label>ایمیل
                <input name="Email" value="@S(Model.Email)" />
            </label>
            <label>وب‌سایت
                <input name="Website" value="@S(Model.Website)" />
            </label>
            <label>شناسه ملی
                <input name="NationalId" value="@S(Model.NationalId)" />
            </label>
            <label>کد اقتصادی
                <input name="EconomicCode" value="@S(Model.EconomicCode)" />
            </label>

            <label>زبان
                <select name="DefaultLanguage">
                    <option value="">انتخاب نشده</option>
                    <option value="fa-IR" selected="@(Model.DefaultLanguage == "fa-IR" ? "selected" : null)">فارسی</option>
                    <option value="en-US" selected="@(Model.DefaultLanguage == "en-US" ? "selected" : null)">English</option>
                    <option value="ar-SA" selected="@(Model.DefaultLanguage == "ar-SA" ? "selected" : null)">العربية</option>
                </select>
            </label>

            <label>تقویم
                <select name="Calendar">
                    <option value="">انتخاب نشده</option>
                    <option value="Persian" selected="@(Model.Calendar == "Persian" ? "selected" : null)">شمسی</option>
                    <option value="Gregorian" selected="@(Model.Calendar == "Gregorian" ? "selected" : null)">میلادی</option>
                </select>
            </label>

            <label>منطقه زمانی
                <select name="TimeZone">
                    <option value="">انتخاب نشده</option>
                    <option value="Asia/Tehran" selected="@(Model.TimeZone == "Asia/Tehran" ? "selected" : null)">ایران - تهران</option>
                    <option value="Asia/Baku" selected="@(Model.TimeZone == "Asia/Baku" ? "selected" : null)">آذربایجان - باکو</option>
                    <option value="Europe/Istanbul" selected="@(Model.TimeZone == "Europe/Istanbul" ? "selected" : null)">ترکیه - استانبول</option>
                    <option value="Asia/Dubai" selected="@(Model.TimeZone == "Asia/Dubai" ? "selected" : null)">امارات - دبی</option>
                    <option value="UTC" selected="@(Model.TimeZone == "UTC" ? "selected" : null)">UTC</option>
                </select>
            </label>

            <label>تعداد رکورد در صفحه
                <input name="ItemsPerPage" type="number" value="@Model.ItemsPerPage" />
            </label>
        </div>
    </section>

    <section id="appearance" class="tab-panel">
        <div class="settings-section-intro">
            <strong>ظاهر و برند</strong>
            <span>تمامی مقادیر این بخش نیز اختیاری هستند.</span>
        </div>
        <div class="grid-3">
            <label>تم
                <input name="Theme" value="@S(Model.Theme)" />
            </label>
            <label>رنگ اصلی
                <input name="PrimaryColor" type="color" value="@C(Model.PrimaryColor, "#17324D")" />
            </label>
            <label>رنگ ثانویه
                <input name="SecondaryColor" type="color" value="@C(Model.SecondaryColor, "#6C757D")" />
            </label>
            <label>مسیر لوگو
                <input name="LogoUrl" value="@S(Model.LogoUrl)" />
            </label>
            <label>مسیر Favicon
                <input name="FaviconUrl" value="@S(Model.FaviconUrl)" />
            </label>
            <label class="wide">متن پایین صفحه
                <textarea name="FooterText">@S(Model.FooterText)</textarea>
            </label>
        </div>
    </section>

    <section id="security" class="tab-panel">
        <div class="settings-section-intro">
            <strong>امنیت و OTP</strong>
            <span>Switch سبز یعنی فعال و خاکستری یعنی غیرفعال.</span>
        </div>

        <div class="grid-3">
            <label>طول OTP
                <input name="OtpLength" type="number" value="@Model.OtpLength" />
            </label>
            <label>اعتبار OTP (ثانیه)
                <input name="OtpValiditySeconds" type="number" value="@Model.OtpValiditySeconds" />
            </label>
            <label>حداکثر تلاش
                <input name="OtpMaxAttempts" type="number" value="@Model.OtpMaxAttempts" />
            </label>
        </div>

        <div class="switch-grid">
            <label class="toggle-card">
                <span class="toggle-text">
                    <strong>ورود با OTP</strong>
                    <small>ورود کارکنان با کد یکبارمصرف</small>
                </span>
                <span class="switch-control">
                    <input type="checkbox" name="OtpEnabled" value="true" @(Model.OtpEnabled ? "checked" : "") aria-label="ورود با OTP" />
                    <input type="hidden" name="OtpEnabled" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>

            <label class="toggle-card">
                <span class="toggle-text">
                    <strong>خدمات کاربری</strong>
                    <small>دسترسی کاربران به خدمات پرسنلی</small>
                </span>
                <span class="switch-control">
                    <input type="checkbox" name="AllowUserSelfService" value="true" @(Model.AllowUserSelfService ? "checked" : "") aria-label="خدمات کاربری" />
                    <input type="hidden" name="AllowUserSelfService" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>

            <label class="toggle-card">
                <span class="toggle-text">
                    <strong>ثبت رویدادهای سامانه</strong>
                    <small>ثبت رخدادهای مدیریتی و امنیتی</small>
                </span>
                <span class="switch-control">
                    <input type="checkbox" name="EnableAuditLog" value="true" @(Model.EnableAuditLog ? "checked" : "") aria-label="ثبت رویدادها" />
                    <input type="hidden" name="EnableAuditLog" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
        </div>
    </section>

    <section id="sms" class="tab-panel">
        <div class="settings-section-intro">
            <strong>پارامترهای اتصال سرویس پیامک</strong>
            <span>مقادیر اختیاری هستند و مطابق مستندات سرویس‌دهنده تکمیل می‌شوند.</span>
        </div>

        <div class="grid-2">
            <label>نشانی API
                <input name="SmsEndpoint" value="@S(Model.SmsEndpoint)" />
            </label>
            <label>روش HTTP
                <select name="SmsMethod">
                    <option value="">انتخاب نشده</option>
                    <option value="POST" selected="@(Model.SmsMethod == "POST" ? "selected" : null)">POST</option>
                    <option value="GET" selected="@(Model.SmsMethod == "GET" ? "selected" : null)">GET</option>
                    <option value="PUT" selected="@(Model.SmsMethod == "PUT" ? "selected" : null)">PUT</option>
                </select>
            </label>

            <label>نوع بدنه درخواست
                <select name="SmsFormat">
                    <option value="">انتخاب نشده</option>
                    <option value="json" selected="@(Model.SmsFormat == "json" ? "selected" : null)">JSON</option>
                    <option value="form" selected="@(Model.SmsFormat == "form" ? "selected" : null)">Form URL Encoded</option>
                    <option value="query" selected="@(Model.SmsFormat == "query" ? "selected" : null)">Query String</option>
                </select>
            </label>

            <label>محل احراز هویت
                <select name="SmsAuthMode">
                    <option value="">انتخاب نشده</option>
                    <option value="none" selected="@(Model.SmsAuthMode == "none" ? "selected" : null)">بدون کلید</option>
                    <option value="header" selected="@(Model.SmsAuthMode == "header" ? "selected" : null)">هدر API-Key</option>
                    <option value="bearer" selected="@(Model.SmsAuthMode == "bearer" ? "selected" : null)">Bearer</option>
                    <option value="query" selected="@(Model.SmsAuthMode == "query" ? "selected" : null)">Query</option>
                    <option value="body" selected="@(Model.SmsAuthMode == "body" ? "selected" : null)">Body</option>
                </select>
            </label>

            <label>نام هدر/پارامتر کلید
                <input name="SmsApiKeyName" value="@S(Model.SmsApiKeyName)" />
            </label>

            <label>کلید API
                <input name="SmsApiKey" type="password" value="" placeholder="برای حفظ کلید فعلی خالی بگذارید" />
            </label>

            <label>نام فیلد فرستنده
                <input name="SmsSenderField" value="@S(Model.SmsSenderField)" />
            </label>
            <label>شماره/شناسه فرستنده
                <input name="SmsSender" value="@S(Model.SmsSender)" />
            </label>
            <label>نام فیلد گیرنده
                <input name="SmsRecipientField" value="@S(Model.SmsRecipientField)" />
            </label>
            <label>نوع مقدار گیرنده
                <select name="SmsRecipientMode">
                    <option value="">انتخاب نشده</option>
                    <option value="scalar" selected="@(Model.SmsRecipientMode == "scalar" ? "selected" : null)">متن تکی</option>
                    <option value="array" selected="@(Model.SmsRecipientMode == "array" ? "selected" : null)">آرایه</option>
                </select>
            </label>
            <label>نام فیلد متن پیام
                <input name="SmsMessageField" value="@S(Model.SmsMessageField)" />
            </label>
            <label>نام فیلد کد الگو
                <input name="SmsCodeField" value="@S(Model.SmsCodeField)" placeholder="code" />
            </label>
            <label>کد الگوی پیامک
                <input name="SmsPatternCode" value="@S(Model.SmsPatternCode)" placeholder="شناسه واقعی الگوی ثبت‌شده" />
            </label>
            <label>نام پارامتر OTP در الگو
                <input name="SmsOtpParameterField" value="@S(Model.SmsOtpParameterField)" placeholder="code" />
            </label>
            <label>نام فیلد فرمت شماره
                <input name="SmsNumberFormatField" value="@S(Model.SmsNumberFormatField)" />
            </label>
            <label>مقدار فرمت شماره
                <input name="SmsNumberFormat" value="@S(Model.SmsNumberFormat)" />
            </label>
            <label>کدهای HTTP موفق
                <input name="SmsSuccessCodes" value="@S(Model.SmsSuccessCodes)" />
            </label>
            <label>شماره مقصد آزمایشی
                <input name="SmsTestRecipient" value="@S(Model.SmsTestRecipient)" />
            </label>
            <label class="wide">پارامترهای ثابت JSON
                <textarea name="SmsStaticParams" rows="5">@S(Model.SmsStaticParams)</textarea>
            </label>
            <label class="wide">متن پیامک
                <textarea name="SmsTemplate" rows="4">@S(Model.SmsTemplate)</textarea>
            </label>
        </div>

        <div class="settings-help">
            <strong>راهنمای IPPanel Edge:</strong>
            برای حالت <code>pattern</code>، فیلد گیرنده باید به صورت <code>recipients</code> و آرایه ارسال شود؛
            شماره‌ها با قالب بین‌المللی ارسال می‌شوند، <code>code</code> شناسه الگوی ثبت‌شده است و مقدار OTP داخل <code>params</code> قرار می‌گیرد.
            مقدار «کد الگوی پیامک» باید شناسه واقعی الگو باشد، نه کلمه <code>code</code> و نه خود OTP.
        </div>

        <div class="settings-actions">
            <label class="toggle-card compact-toggle">
                <span class="toggle-text"><strong>سرویس پیامک</strong><small>ارسال OTP و پیام‌های سامانه</small></span>
                <span class="switch-control">
                    <input type="checkbox" name="SmsEnabled" value="true" @(Model.SmsEnabled ? "checked" : "") aria-label="سرویس پیامک" />
                    <input type="hidden" name="SmsEnabled" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
            <button class="btn btn-main" type="submit" name="command" value="save-test-sms">ذخیره و ارسال پیامک آزمایشی</button>
        </div>
    </section>

    <section id="payroll" class="tab-panel">
        <div class="settings-section-intro">
            <strong>فیش حقوقی / SSRS</strong>
            <span>شماره پرسنلی فقط برای ورود به پورتال استفاده می‌شود؛ مقدار پارامتر پرسنلی گزارش از «شناسه» متناظر همان کارمند خوانده می‌شود.</span>
        </div>

        <div class="grid-2">
            <label class="wide">آدرس کامل گزارش SSRS / Report URL
                <input name="PayrollReportUrl" value="@S(Model.PayrollReportUrl)" placeholder="برای گزارش مستقیم؛ در صورت استفاده از Report Server/Path خالی بگذارید" />
            </label>
            <label>آدرس Report Server
                <input name="PayrollReportServerUrl" value="@S(Model.PayrollReportServerUrl)" placeholder="مثلاً http://srv.../Indamin_ReportServer" />
            </label>
            <label>مسیر مستقیم گزارش
                <input name="PayrollReportPath" value="@S(Model.PayrollReportPath)" placeholder="مثلاً /پوشه/نام گزارش" />
            </label>

            <label>نام پارامتر سال و ماه گزارش
                <input name="PayrollYearParameter" value="@S(Model.PayrollYearParameter)" placeholder="مثلاً YearMonth" />
            </label>
            <label>نام پارامتر کد پرسنلی گزارش
                <input name="PayrollPersonnelParameter" value="@S(Model.PayrollPersonnelParameter)" placeholder="مثلاً PersonnelNo" />
            </label>
            <label>فرمت گزارش
                <select name="PayrollReportFormat">
                    <option value="PDF" selected="@(string.Equals(Model.PayrollReportFormat, "PDF", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">PDF</option>
                    <option value="HTML5" selected="@(string.Equals(Model.PayrollReportFormat, "HTML5", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">HTML5</option>
                    <option value="HTML4.0" selected="@(string.Equals(Model.PayrollReportFormat, "HTML4.0", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">HTML4.0</option>
                    <option value="MHTML" selected="@(string.Equals(Model.PayrollReportFormat, "MHTML", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">MHTML</option>
                </select>
            </label>

            <label>نوع احراز هویت SSRS
                <select name="PayrollReportAuthentication">
                    <option value="windows" selected="@(string.Equals(Model.PayrollReportAuthentication, "windows", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Windows / NTLM / Negotiate (حساب اجرای سامانه)</option>
                    <option value="forms" selected="@(string.Equals(Model.PayrollReportAuthentication, "forms", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Forms / Custom Login</option>
                    <option value="windows" selected="@(string.Equals(Model.PayrollReportAuthentication, "windows", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Windows / NTLM / Negotiate</option>
                    <option value="basic" selected="@(string.Equals(Model.PayrollReportAuthentication, "basic", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Basic</option>
                    <option value="none" selected="@(string.Equals(Model.PayrollReportAuthentication, "none", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">بدون احراز هویت</option>
                </select>
            </label>

            <label>نام کاربری دسترسی SSRS
                <input name="PayrollReportUsername" value="@S(Model.PayrollReportUsername)" autocomplete="off" />
            </label>
            <label>دامین / Domain
                <input name="PayrollReportDomain" value="@S(Model.PayrollReportDomain)" autocomplete="off" />
            </label>

            <label class="wide">آدرس صفحه ورود SSRS
                <input name="PayrollReportLoginUrl" value="@S(Model.PayrollReportLoginUrl)" placeholder="مثلاً http://srv.../Indamin_ReportServer/Pages/Login.aspx?AspxAutoDetectCookieSupport=1" />
            </label>
            <label>نام فیلد کاربری در Login
                <input name="PayrollReportUsernameField" value="@S(Model.PayrollReportUsernameField)" placeholder="خالی = تشخیص خودکار" />
            </label>
            <label>نام فیلد رمز در Login
                <input name="PayrollReportPasswordField" value="@S(Model.PayrollReportPasswordField)" placeholder="خالی = تشخیص خودکار" />
            </label>
            <label>گذرواژه دسترسی SSRS
                <input name="PayrollReportPassword" type="password" value="" autocomplete="new-password" placeholder="برای حفظ رمز فعلی خالی بگذارید" />
            </label>
        </div>

        <div class="settings-help">
            <strong>تنظیم اتصال:</strong>
            تصویر ارسالی شما نشان می‌دهد سرور گزارش صفحه <code>Login.aspx</code> با فرم نام کاربری/کلمه عبور دارد؛ بنابراین گزینه <strong>Forms / Custom Login</strong> را انتخاب کنید.
            اگر «آدرس صفحه ورود» خالی باشد، پورتال به‌صورت خودکار مسیر <code>/Pages/Login.aspx?AspxAutoDetectCookieSupport=1</code> را از روی Report Server می‌سازد.
            نام فیلدهای Login نیز در حالت عادی به‌صورت خودکار از صفحه ورود تشخیص داده می‌شوند.
            بعد از ورود، همان نشست احراز هویت برای درخواست گزارش مستقیم استفاده می‌شود و کاربر پورتال صفحه Login یا نام کاربری/رمز SSRS را نمی‌بیند.
            مقدار پارامتر کد پرسنلی از «شناسه» کارمند لاگین‌شده و مقدار پارامتر دوم از دوره شش‌رقمی مانند <code>140506</code> گرفته می‌شود.
        </div>

        <div class="settings-actions">
            <label class="toggle-card compact-toggle">
                <span class="toggle-text"><strong>فیش حقوقی</strong><small>فعال بودن دسترسی فیش حقوقی</small></span>
                <span class="switch-control">
                    <input type="checkbox" name="PayrollEnabled" value="true" @(Model.PayrollEnabled ? "checked" : "") aria-label="فیش حقوقی" />
                    <input type="hidden" name="PayrollEnabled" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
            <label class="toggle-card compact-toggle">
                <span class="toggle-text"><strong>امکان چاپ فیش حقوقی</strong><small>نمایش گزینه چاپ در نمایشگر PDF</small></span>
                <span class="switch-control">
                    <input type="checkbox" name="PayrollAllowPrint" value="true" @(Model.PayrollAllowPrint ? "checked" : "") aria-label="چاپ فیش حقوقی" />
                    <input type="hidden" name="PayrollAllowPrint" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
            <label class="toggle-card compact-toggle">
                <span class="toggle-text"><strong>امکان ذخیره فیش حقوقی</strong><small>نمایش گزینه ذخیره PDF</small></span>
                <span class="switch-control">
                    <input type="checkbox" name="PayrollAllowDownload" value="true" @(Model.PayrollAllowDownload ? "checked" : "") aria-label="ذخیره فیش حقوقی" />
                    <input type="hidden" name="PayrollAllowDownload" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
        </div>
    </section>

    <section id="queries" class="tab-panel">
        <div class="settings-section-intro">
            <strong>کوئری‌های ورودی</strong>
            <span>کوئری‌های خواندنی برای دریافت شناسه‌های مورد نیاز خدمات کارکنان.</span>
        </div>
        <div class="card">
            <p>هر کوئری دارای اتصال SQL مستقل است و رمز عبور آن به‌صورت رمزنگاری‌شده در پایگاه داده نگهداری می‌شود.</p>
            <p>برای سرویس حکم کارگزینی، عنوان کوئری باید دقیقاً <strong>حکم کارگزینی</strong> باشد.</p>
            <a class="btn btn-main" href="/InputQueries">مدیریت کوئری‌های ورودی</a>
        </div>
    </section>

    <section id="personnel-order" class="tab-panel">
        <div class="settings-section-intro">
            <strong>حکم کارگزینی / SSRS</strong>
            <span>در زمان ورود به صفحه، کوئری «حکم کارگزینی» اجرا می‌شود و مقدار ستون اول نتیجه به پارامتر گزارش ارسال می‌گردد.</span>
        </div>
        <div class="grid-2">
            <label class="wide">آدرس Report Server
                <input name="PersonnelOrderReportServerUrl" value="@S(Model.PersonnelOrderReportServerUrl)" placeholder="مثلاً http://srvwebapps/ReportServer" />
            </label>
            <label class="wide">مسیر مستقیم گزارش
                <input name="PersonnelOrderReportPath" value="@S(Model.PersonnelOrderReportPath)" placeholder="مثلاً /PersonnelOrder" />
            </label>
            <label>نام پارامتر شناسه حکم کارگزینی
                <input name="PersonnelOrderIdParameter" value="@S(Model.PersonnelOrderIdParameter)" placeholder="مثلاً PersonnelOrderId" />
            </label>
            <label>فرمت گزارش
                <select name="PersonnelOrderReportFormat">
                    <option value="PDF" selected="@(string.Equals(Model.PersonnelOrderReportFormat, "PDF", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">PDF</option>
                    <option value="HTML5" selected="@(string.Equals(Model.PersonnelOrderReportFormat, "HTML5", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">HTML5</option>
                    <option value="MHTML" selected="@(string.Equals(Model.PersonnelOrderReportFormat, "MHTML", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">MHTML</option>
                </select>
            </label>
            <label>نوع احراز هویت SSRS
                <select name="PersonnelOrderReportAuthentication">
                    <option value="windows" selected="@(string.Equals(Model.PersonnelOrderReportAuthentication, "windows", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Windows خودکار (حساب اجرای سامانه)</option>
                    <option value="none" selected="@(string.Equals(Model.PersonnelOrderReportAuthentication, "none", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">بدون احراز هویت</option>
                    <option value="forms" selected="@(string.Equals(Model.PersonnelOrderReportAuthentication, "forms", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Forms / Custom Login</option>
                    <option value="basic" selected="@(string.Equals(Model.PersonnelOrderReportAuthentication, "basic", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Basic</option>
                </select>
            </label>
            <label>نام کاربری SSRS
                <input name="PersonnelOrderReportUsername" value="@S(Model.PersonnelOrderReportUsername)" />
            </label>
            <label>دامنه
                <input name="PersonnelOrderReportDomain" value="@S(Model.PersonnelOrderReportDomain)" />
            </label>
            <label>آدرس صفحه ورود
                <input name="PersonnelOrderReportLoginUrl" value="@S(Model.PersonnelOrderReportLoginUrl)" />
            </label>
            <label>نام فیلد کاربری
                <input name="PersonnelOrderReportUsernameField" value="@S(Model.PersonnelOrderReportUsernameField)" />
            </label>
            <label>نام فیلد رمز
                <input name="PersonnelOrderReportPasswordField" value="@S(Model.PersonnelOrderReportPasswordField)" />
            </label>
            <label>کلمه عبور SSRS
                <input name="PersonnelOrderReportPassword" type="password" value="" placeholder="برای حفظ رمز فعلی خالی بگذارید" />
            </label>
            <label class="wide">آدرس کامل گزارش SSRS / Report URL
                <input name="PersonnelOrderReportUrl" value="@S(Model.PersonnelOrderReportUrl)" placeholder="اختیاری؛ در صورت تکمیل Report Server و مسیر گزارش، این دو مبنا قرار می‌گیرند" />
            </label>
        </div>
        <div class="settings-actions">
            <label class="toggle-card compact-toggle">
                <span class="toggle-text"><strong>حکم کارگزینی</strong><small>فعال بودن نمایش آخرین حکم کارگزینی</small></span>
                <span class="switch-control">
                    <input type="checkbox" name="PersonnelOrderEnabled" value="true" @(Model.PersonnelOrderEnabled ? "checked" : "") aria-label="حکم کارگزینی" />
                    <input type="hidden" name="PersonnelOrderEnabled" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
            <label class="toggle-card compact-toggle">
                <span class="toggle-text"><strong>امکان چاپ حکم کارگزینی</strong><small>نمایش گزینه چاپ در نمایشگر PDF</small></span>
                <span class="switch-control">
                    <input type="checkbox" name="PersonnelOrderAllowPrint" value="true" @(Model.PersonnelOrderAllowPrint ? "checked" : "") aria-label="چاپ حکم کارگزینی" />
                    <input type="hidden" name="PersonnelOrderAllowPrint" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
            <label class="toggle-card compact-toggle">
                <span class="toggle-text"><strong>امکان ذخیره حکم کارگزینی</strong><small>نمایش گزینه ذخیره PDF</small></span>
                <span class="switch-control">
                    <input type="checkbox" name="PersonnelOrderAllowDownload" value="true" @(Model.PersonnelOrderAllowDownload ? "checked" : "") aria-label="ذخیره حکم کارگزینی" />
                    <input type="hidden" name="PersonnelOrderAllowDownload" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
        </div>
    </section>

    <section id="announcement-categories" class="tab-panel">
        <div class="settings-section-intro">
            <strong>اطلاعات پایه / دسته‌بندی اطلاعیه‌ها</strong>
            <span>دسته‌بندی‌ها در زمان تعریف اطلاعیه به‌صورت انتخابی نمایش داده می‌شوند. دسته‌بندی مورد استفاده در اطلاعیه فعال را می‌توان غیرفعال کرد فقط پس از تعیین تکلیف اطلاعیه‌های آن.</span>
        </div>

        <div class="category-management-grid">
            <form method="post" action="/SystemSettings/SaveAnnouncementCategory" class="category-editor-card">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <h3>افزودن دسته‌بندی</h3>
                <label>عنوان دسته‌بندی *
                    <input name="title" placeholder="مثلاً منابع انسانی" required />
                </label>
                <label>توضیحات
                    <input name="description" />
                </label>
                <label>ترتیب نمایش
                    <input name="sortOrder" type="number" value="10" />
                </label>
                <label class="inline-check">
                    <input type="checkbox" name="isActive" value="true" checked />
                    فعال
                </label>
                <button class="btn btn-main" type="submit">افزودن دسته‌بندی</button>
            </form>

            <div class="category-list">
                @if (Model.AnnouncementCategories.Count == 0)
                {
                    <div class="empty">دسته‌بندی‌ای ثبت نشده است.</div>
                }
                else
                {
                    foreach (var category in Model.AnnouncementCategories)
                    {
                        <form method="post" action="/SystemSettings/SaveAnnouncementCategory" class="category-editor-card">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@category.Id" />
                            <h3>@category.Title</h3>
                            <label>عنوان
                                <input name="title" value="@category.Title" required />
                            </label>
                            <label>توضیحات
                                <input name="description" value="@category.Description" />
                            </label>
                            <label>ترتیب نمایش
                                <input name="sortOrder" type="number" value="@category.SortOrder" />
                            </label>
                            <label class="inline-check">
                                <input type="checkbox" name="isActive" value="true" @(category.IsActive ? "checked" : "") />
                                فعال
                            </label>
                            <button class="btn btn-outline" type="submit">ذخیره دسته‌بندی</button>
                        </form>
                    }
                }
            </div>
        </div>
    </section>

    <section id="maintenance" class="tab-panel">
        <div class="settings-section-intro">
            <strong>نگهداری</strong>
            <span>وضعیت فعال سبز و وضعیت غیرفعال خاکستری نمایش داده می‌شود.</span>
        </div>

        <div class="settings-actions">
            <label class="toggle-card compact-toggle">
                <span class="toggle-text"><strong>حالت تعمیر و نگهداری</strong><small>جلوگیری از ورود کاربران هنگام تعمیرات</small></span>
                <span class="switch-control">
                    <input type="checkbox" name="MaintenanceMode" value="true" @(Model.MaintenanceMode ? "checked" : "") aria-label="حالت تعمیر و نگهداری" />
                    <input type="hidden" name="MaintenanceMode" value="false" />
                    <span class="switch-slider"></span>
                </span>
            </label>
        </div>

        <label>پیام نگهداری
            <textarea name="MaintenanceMessage">@S(Model.MaintenanceMessage)</textarea>
        </label>
    </section>

    <div class="form-actions">
        <button class="btn btn-main" type="submit" name="command" value="save">ذخیره همه تنظیمات</button>
    </div>
</form>

@section Scripts {
<script>
(function () {
    function activate(tabId) {
        const target = document.getElementById(tabId);
        const button = document.querySelector('.tab[data-tab="' + tabId + '"]');
        if (!target || !button) return;
        document.querySelectorAll('.tab').forEach(function (b) { b.classList.remove('active'); });
        document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('active'); });
        button.classList.add('active');
        target.classList.add('active');
    }

    document.querySelectorAll('.tab').forEach(function (button) {
        button.addEventListener('click', function () {
            activate(button.dataset.tab);
            if (history.replaceState) history.replaceState(null, '', '#' + button.dataset.tab);
        });
    });

    const hash = window.location.hash ? window.location.hash.substring(1) : "";
    if (hash) activate(hash);
})();
</script>
}