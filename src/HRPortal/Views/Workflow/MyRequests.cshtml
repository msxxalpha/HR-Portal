@model List<HRPortal.Models.WorkflowInboxRow>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdminRequests = (bool?)ViewBag.IsAdminRequests ?? false;
    ViewData["Title"] = isAdminRequests ? "مدیریت درخواست‌ها" : "درخواست‌های من";
}
<div class="page-head">
    <div><h1>@(isAdminRequests ? "مدیریت درخواست‌ها" : "درخواست‌های من")</h1><p>@(isAdminRequests ? "مشاهده و حذف کامل درخواست‌ها همراه با سوابق و تاریخچه گردش کار." : "پیگیری وضعیت درخواست‌های ثبت‌شده توسط شما؛ حذف فقط تا پیش از مشاهده مرحله بعد امکان‌پذیر است.")</p></div>
    <div class="actions"><a class="btn btn-outline" href="/Workflow/Inbox">کارتابل</a><a class="btn btn-main" href="/">بازگشت به داشبورد</a></div>
</div>
<div class="workflow-stats">
    <div class="stat"><span>کل درخواست‌ها</span><strong>@Model.Count</strong></div>
    <div class="stat"><span>در حال گردش</span><strong>@Model.Count(x => x.Status == "InProgress")</strong></div>
    <div class="stat"><span>تأیید نهایی</span><strong>@Model.Count(x => x.Status == "Approved" || x.Status == "Completed")</strong></div>
    <div class="stat"><span>رد یا برگشت</span><strong>@Model.Count(x => x.Status == "Rejected" || x.Status == "Returned")</strong></div>
</div>
<section class="card request-list-card">
    <div class="section-head"><div><h3>@(isAdminRequests ? "همه درخواست‌های سامانه" : "فهرست درخواست‌ها")</h3><span class="muted">نمایش @Model.Count درخواست؛ تفکیک بر اساس وضعیت در آمار بالای صفحه</span></div><span class="request-count-pill">@Model.Count</span></div>
    @if (isAdminRequests) { <div class="alert warning">حذف مدیر سامانه غیرقابل‌بازگشت است و اطلاعات درخواست، مراحل، امتیازها و تاریخچه مرتبط را حذف می‌کند.</div> }
    @if (Model.Count == 0)
    {
        <div class="empty">هنوز درخواستی از طرف شما در گردش کار ثبت نشده است.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>گردش کار</th><th>نوع/شناسه</th><th>مرحله جاری</th><th>وضعیت</th><th>تاریخ ثبت</th><th>عملیات</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var statusTitle = item.Status switch
                    {
                        "Approved" => "تأیید نهایی",
                        "Rejected" => "رد شده",
                        "Returned" => "برگشت داده شده",
                        _ => "در حال گردش"
                    };
                    <tr>
                        <td><strong>@item.WorkflowTitle</strong></td>
                        <td>@item.EntityType #@item.EntityId</td>
                        <td>@item.StepTitle</td>
                        <td><span class="workflow-status @(item.Status == "Approved" ? "done" : item.Status == "Rejected" ? "rejected" : item.Status == "Returned" ? "returned" : "pending")">@statusTitle</span></td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            <div class="actions request-row-actions">
                                <a class="btn btn-outline btn-sm" href="/Workflow/Details/@item.WorkflowInstanceId">جزئیات و تاریخچه</a>
                                @if (isAdminRequests || item.CanDelete)
                                {
                                    <form method="post" action="/Workflow/DeleteRequest" onsubmit="return confirm('این درخواست و تمام سوابق و تاریخچه آن به‌طور کامل حذف می‌شود. ادامه می‌دهید؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.WorkflowInstanceId" />
                                        <button class="btn btn-danger btn-sm" type="submit">حذف کامل</button>
                                    </form>
                                }
                                else if (item.Status == "InProgress")
                                {
                                    <span class="request-locked-note">مرحله بعد مشاهده کرده یا روی درخواست اقدام شده است.</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
