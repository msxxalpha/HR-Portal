@inject HRPortal.Services.EnvironmentSettingsService SettingsService
@{
    var cfg = await SettingsService.GetAsync();
    var company = cfg.System;
    var isAdmin = User.HasClaim("IsAdmin", "1");
    bool Can(string permission) => isAdmin || User.HasClaim("Permission", permission);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@company.PrimaryColor" />
    <title>@ViewData["Title"] - @company.ApplicationName</title>
    @if (!string.IsNullOrWhiteSpace(company.FaviconUrl))
    {
        <link rel="icon" href="@company.FaviconUrl" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
</head>
<body style="--navy:@company.PrimaryColor;--navy2:@company.SecondaryColor;">
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">@company.ShortName</div>
            <div class="brand-text">
                <strong>@company.ApplicationName</strong>
                <small>@company.OrganizationName</small>
            </div>
        </div>

        <nav class="nav">
            <a class="nav-dashboard" href="/"><span class="nav-icon">⌂</span>داشبورد</a>
            @if (Can("Workflow.Inbox")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Workflow") ? "open" : null)">
                    <summary><span class="nav-icon">▤</span>درخواست‌ها</summary><div class="nav-submenu">
                        <a href="/Workflow/MyRequests">درخواست‌های من</a><a href="/Workflow/Inbox">کارتابل</a>
                    </div>
                </details>
            }
            @if (Can("Announcements.Manage")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Announcements") ? "open" : null)">
                    <summary><span class="nav-icon">⚑</span>اطلاعیه‌ها</summary><div class="nav-submenu"><a href="/Announcements">اطلاعیه‌ها</a></div>
                </details>
            }
            @if (Can("Employees.View") || Can("Organization.View")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Employees") || Context.Request.Path.StartsWithSegments("/Organization") ? "open" : null)">
                    <summary><span class="nav-icon">♙</span>اطلاعات پایه</summary><div class="nav-submenu">
                        @if (Can("Employees.View")) { <a href="/Employees">کارکنان</a> }
                        @if (Can("Organization.View")) { <a href="/Organization">ساختار سازمانی</a> }
                    </div>
                </details>
            }
            @if (Can("Reports.View")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Reports") ? "open" : null)">
                    <summary><span class="nav-icon">▥</span>گزارش‌ها</summary><div class="nav-submenu"><a href="/Reports">گزارش‌ها</a></div>
                </details>
            }
            @if (Can("Payroll.View") || Can("PersonnelOrder.View")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Payroll") || Context.Request.Path.StartsWithSegments("/PersonnelOrder") ? "open" : null)">
                    <summary><span class="nav-icon">▥</span>خدمات کارکنان</summary><div class="nav-submenu">
                        @if (Can("Payroll.View")) { <a href="/Payroll/Payslip">فیش حقوقی</a> }
                        @if (Can("PersonnelOrder.View")) { <a href="/PersonnelOrder">حکم کارگزینی</a> }
                    </div>
                </details>
            }
            @if (Can("Users.Manage") || Can("Roles.Manage") || Can("Workflow.Manage") || Can("Settings.View")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Users") || Context.Request.Path.StartsWithSegments("/Workflow/Manage") || Context.Request.Path.StartsWithSegments("/SystemSettings") ? "open" : null)">
                    <summary><span class="nav-icon">⚙</span>تنظیمات و مدیریت</summary><div class="nav-submenu">
                        @if (Can("Users.Manage") || Can("Roles.Manage")) { <a href="/Users">کاربران و نقش‌ها</a> }
                        @if (Can("Workflow.Manage")) { <a href="/Workflow/Manage">مدیریت گردش کار</a> }
                        @if (Can("Settings.View")) { <a href="/SystemSettings">تنظیمات سامانه</a> }
                    </div>
                </details>
            }
            <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Support") ? "open" : null)">
                <summary><span class="nav-icon">?</span>پشتیبانی</summary><div class="nav-submenu"><a href="/Support">راهنما و پشتیبانی</a></div>
            </details>
            @if (isAdmin) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Account") ? "open" : null)">
                    <summary><span class="nav-icon">⌁</span>حساب کاربری</summary><div class="nav-submenu"><a href="/Account/ChangePassword">تغییر رمز مدیر</a></div>
                </details>
            } else if (User.HasClaim("UserType", "Employee")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Account") ? "open" : null)">
                    <summary><span class="nav-icon">⌁</span>حساب کاربری</summary><div class="nav-submenu"><a href="/Account/PersonalPassword">رمز عبور شخصی</a></div>
                </details>
            }
        </nav>

        <div class="sidebar-foot">
            @(isAdmin ? "مدیر سامانه" : "کاربر کارکنان")
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div>
                <div class="topbar-caption">@company.ApplicationName</div>
                <h2>@ViewData["Title"]</h2>
            </div>
            <div class="user-box">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>@User.Identity.Name</span>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button class="link" type="submit">خروج</button>
                    </form>
                }
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>
                @(string.IsNullOrWhiteSpace(company.FooterText) ? company.ApplicationName : company.FooterText)
                @if (!string.IsNullOrWhiteSpace(company.OrganizationName))
                {
                    <span> | @company.OrganizationName</span>
                }
            </span>
            <span class="build-version">Build @HRPortal.BuildInfo.Number</span>
        </footer>
    </div>
</div>
@RenderSection("Scripts", required: false)
</body>
</html>