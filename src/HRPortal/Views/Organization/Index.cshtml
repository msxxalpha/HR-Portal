@model HRPortal.Models.OrganizationStructureRevision?
@{ViewData["Title"]="ساختار سازمانی";var revs=ViewBag.Revisions as List<HRPortal.Models.OrganizationStructureRevision>??[];var editable=Model!=null&&!Model.IsFinalized;var roots=Model?.Nodes.Where(x=>x.ParentId==null).OrderBy(x=>x.SortOrder).ThenBy(x=>x.Title).ToList()??[];}
<div class="page-head"><div><h1>ساختار سازمانی</h1><p>نسخه‌بندی ساختار، تاریخ اجرا و ثبت تاریخچه تغییرات</p></div></div>
@if(TempData["Error"]!=null){<div class="alert error">@TempData["Error"]</div>}
<div class="split"><div class="card"><h3>نسخه‌ها</h3><form method="post" action="/Organization/NewRevision" class="mini-form">@Html.AntiForgeryToken()<label>تاریخ اجرا<input name="effectiveDate" value="@HRPortal.Services.PersianDateService.Format(DateTime.Today)" placeholder="۱۴۰۵/۰۷/۰۵"></label><label>عنوان<input name="title" required></label><label>یادداشت<textarea name="notes"></textarea></label><button class="btn btn-main">ایجاد نسخه جدید</button></form><hr>@foreach(var r in revs){<a class="revision @(Model?.Id==r.Id?"selected":"")" href="/Organization?revisionId=@r.Id"><strong>@r.Title</strong><span>@r.RevisionCode - @HRPortal.Services.PersianDateService.Format(r.EffectiveDate) - @(r.IsFinalized?"نهایی":"پیش‌نویس")</span></a>}</div>
<div class="card"><div class="section-head"><div><h3>@(Model?.Title??"ساختار تعریف نشده")</h3><span>@(Model?.RevisionCode)</span></div>@if(editable){<form method="post" action="/Organization/Finalize">@Html.AntiForgeryToken()<input type="hidden" name="revisionId" value="@Model!.Id"><button class="btn btn-main">نهایی‌سازی نسخه</button></form>}</div>
@if(editable){<form method="post" action="/Organization/AddNode" class="mini-form grid-4">@Html.AntiForgeryToken()<input type="hidden" name="revisionId" value="@Model!.Id"><input name="code" placeholder="کد" required><input name="title" placeholder="عنوان" required><select name="rankType"><option>مدیریت</option><option>ریاست</option><option>سرپرستی</option></select><input name="sortOrder" type="number" value="0"><button class="btn btn-outline">افزودن ریشه</button></form>}
<div class="tree">@foreach(var n in roots){<partial name="_Node" model="n"/>}</div></div></div>
<div class="card"><h3>تاریخچه تغییرات</h3>@if(Model?.Changes.Any()==true){<table><thead><tr><th>نوع</th><th>کد</th><th>شرح</th><th>زمان</th></tr></thead><tbody>@foreach(var c in Model.Changes.OrderByDescending(x=>x.ChangedAt)){<tr><td>@c.ChangeType</td><td>@c.EntityCode</td><td>@c.Description</td><td>@c.ChangedAt.ToLocalTime()</td></tr>}</tbody></table>}else{<p>تغییری ثبت نشده است.</p>}</div>