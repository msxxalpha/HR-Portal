@inject HRPortal.Services.EnvironmentSettingsService SettingsService
@{
    var cfg = await SettingsService.GetAsync();
    var company = cfg.System;
    var isAdmin = User.HasClaim("IsAdmin", "1");
    bool Can(string permission) =>
        isAdmin ||
        User.HasClaim("Permission", permission) ||
        ((permission == "ContractRenewal.View" || permission == "ContractRenewal.Create" ||
          permission == "ContractRenewal.List") &&
            User.HasClaim("Permission", "ContractRenewal.Track"));
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@company.PrimaryColor" />
    <title>@ViewData["Title"] - @company.ApplicationName</title>
    @if (!string.IsNullOrWhiteSpace(company.FaviconUrl))
    {
        <link rel="icon" href="@company.FaviconUrl" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" />
    <link rel="stylesheet" href="https://unpkg.com/@@majidh1/jalalidatepicker/dist/jalalidatepicker.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/suggestions.css")" asp-append-version="true" />
</head>
<body style="--navy:@company.PrimaryColor;--navy2:@company.SecondaryColor;">
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">@company.ShortName</div>
            <div class="brand-text">
                <strong>@company.ApplicationName</strong>
                <small>@company.OrganizationName</small>
            </div>
        </div>

        <nav class="nav">
            <a class="nav-dashboard" href="/"><span class="nav-icon">⌂</span>داشبورد</a>
            @if (Can("Workflow.Inbox") || Can("ContractRenewal.Manage") ||
                 User.HasClaim("UserType", "Employee")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Workflow") ? "open" : null)">
                    <summary><span class="nav-icon">▤</span>درخواست‌ها</summary><div class="nav-submenu">
                        <a href="/Workflow/MyRequests">درخواست‌های من</a><a href="/Workflow/Inbox">کارتابل</a>
                    </div>
                </details>
            }
            @if (Can("Announcements.Manage")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Announcements") ? "open" : null)">
                    <summary><span class="nav-icon">⚑</span>اطلاعیه‌ها</summary><div class="nav-submenu"><a href="/Announcements">اطلاعیه‌ها</a></div>
                </details>
            }
            @if (Can("Employees.View") || Can("Organization.View") || Can("Settings.View") || Can("Settings.Edit")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Employees") || Context.Request.Path.StartsWithSegments("/Organization") || Context.Request.Path.StartsWithSegments("/OrganizationPositions") || Context.Request.Path.StartsWithSegments("/SystemForms") ? "open" : null)">
                    <summary><span class="nav-icon">♙</span>اطلاعات پایه</summary><div class="nav-submenu">
                        @if (Can("Employees.View")) { <a href="/Employees">کارکنان</a> }
                        @if (Can("Settings.View")) { <a href="/OrganizationPositions">مدیریت پست‌های سازمانی</a> }
                        @if (Can("Organization.View")) { <a href="/Organization">ساختار سازمانی</a> }
                        @if (Can("Settings.Edit")) { <a href="/SystemForms">مدیریت فرم‌ها</a> }
                    </div>
                </details>
            }
            @if (isAdmin || Can("ContractRenewal.Manage") || Can("ContractRenewal.View") || Can("ContractRenewal.List") || Can("ContractRenewal.Reports") || Can("ContractRenewal.Create") || Can("ContractRenewal.Settings") || Can("ContractRenewal.Evaluation.Manage") || Can("ContractRenewal.Workflow") || Can("MonthlyPerformance.View") ||
                Can("MonthlyPerformance.Evaluate") || Can("MonthlyPerformance.Manage") || Can("MonthlyPerformance.Reports") || Can("Suggestions.Submit") || Can("Suggestions.ViewAll") || Can("Suggestions.Manage") || Can("Suggestions.Reports")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/EmployeeContracts") || (Context.Request.Path.StartsWithSegments("/MonthlyPerformance") || Context.Request.Path.StartsWithSegments("/MonthlyPerformanceAdmin") || Context.Request.Path.StartsWithSegments("/MonthlyPerformanceReports") || Context.Request.Path.StartsWithSegments("/Suggestions")) ? "open" : null)">
                    <summary><span class="nav-icon">▦</span>ماژول‌ها</summary>
                    <div class="nav-submenu">
                        @if (isAdmin || Can("ContractRenewal.Manage") || Can("ContractRenewal.View") || Can("ContractRenewal.List") || Can("ContractRenewal.Reports") || Can("ContractRenewal.Create") || Can("ContractRenewal.Settings") || Can("ContractRenewal.Evaluation.Manage") || Can("ContractRenewal.Workflow")) {
                        <details class="nav-subgroup" open="@(Context.Request.Path.StartsWithSegments("/EmployeeContracts") ? "open" : null)">
                            <summary>مدیریت قراردادهای کارکنان</summary>
                            <div class="nav-submenu nav-submenu-nested">
                                @if (isAdmin || Can("ContractRenewal.Settings") || Can("ContractRenewal.Evaluation.Manage") || Can("ContractRenewal.Manage")) { <a href="/EmployeeContracts/BasicInformation">اطلاعات پایه و مدیریت ارزشیابی تمدید قرارداد</a> }
                                @if (isAdmin || Can("ContractRenewal.Reports") || Can("ContractRenewal.Manage")) { <a href="/EmployeeContracts/Dashboard">داشبورد و گزارش‌های تمدید قرارداد</a> }
                                @if (isAdmin || Can("ContractRenewal.List") || Can("ContractRenewal.Manage")) { <a href="/EmployeeContracts/Requests">فهرست درخواست‌های ارزشیابی و تمدید قرارداد</a> }
                                @if (isAdmin || Can("ContractRenewal.Create") || Can("ContractRenewal.Manage")) { <a href="/EmployeeContracts/Renewal">تمدید قرارداد</a> }
                            </div>
                        </details>
                        }
                        @if (Can("Suggestions.Submit") || Can("Suggestions.ViewAll") || Can("Suggestions.Manage") || Can("Suggestions.Reports")) {
                        <details class="nav-subgroup" open="@(Context.Request.Path.StartsWithSegments("/Suggestions") ? "open" : null)">
                            <summary>نظام پیشنهادات</summary><div class="nav-submenu nav-submenu-nested">
                            @if (Can("Suggestions.Submit") || Can("Suggestions.ViewAll") || Can("Suggestions.Manage")) { <a href="/Suggestions">@(Can("Suggestions.ViewAll") || Can("Suggestions.Manage") ? "فهرست پیشنهادها" : "پیشنهادهای من")</a> }
                            @if (Can("Suggestions.Submit") || Can("Suggestions.Manage")) { <a href="/Suggestions/Create">ثبت پیشنهاد جدید</a> }
                            @if (Can("Suggestions.Reports") || Can("Suggestions.Manage")) { <a href="/SuggestionsReports">داشبورد و گزارش‌های نظام پیشنهادات</a> }
                        </div>
                        </details>
                        }
                        @if (isAdmin || Can("MonthlyPerformance.View") || Can("MonthlyPerformance.Evaluate") ||
                            Can("MonthlyPerformance.Manage") || Can("MonthlyPerformance.Reports")) {
                        <details class="nav-subgroup" open="@(Context.Request.Path.StartsWithSegments("/MonthlyPerformance") ? "open" : null)">
                            <summary>ارزیابی عملکرد کارکنان</summary>
                            <div class="nav-submenu nav-submenu-nested">
                                @if (isAdmin || Can("MonthlyPerformance.Manage")) { <a href="/MonthlyPerformanceAdmin/Basic">اطلاعات پایه ماژول</a> }
                                @if (isAdmin || Can("MonthlyPerformance.Manage")) { <a href="/MonthlyPerformanceAdmin/Periods">دوره‌های ارزیابی</a> }
                                @if (isAdmin || Can("MonthlyPerformance.Manage")) { <a href="/MonthlyPerformanceAdmin/Ranks">رده‌های پستی</a> }
                                @if (isAdmin || Can("MonthlyPerformance.Manage")) { <a href="/MonthlyPerformanceAdmin/Questions">بانک سؤالات</a> }
                                @if (isAdmin || Can("MonthlyPerformance.Reports")) { <a href="/MonthlyPerformanceReports/Index">گزارش‌های مدیریتی عملکرد</a> }
                                @if (Can("MonthlyPerformance.Evaluate") && User.HasClaim("IsPerformanceEvaluator","1")) { <a href="/MonthlyPerformance/Dashboard">داشبورد ارزیاب و کارتابل عملکرد</a> }
                                @if (Can("MonthlyPerformance.View")) { <a href="/MonthlyPerformance/Mine">داشبورد عملکرد شخصی</a> }
                            </div>
                        </details>
                        }
                    </div>
                </details>
            }
            @if (Can("Reports.View") || Can("Reports.ActivityPerformance.View")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Reports") ? "open" : null)">
                    <summary><span class="nav-icon">▥</span>گزارش‌ها</summary><div class="nav-submenu"><a href="/Reports/ActivityPerformance">گزارش عملکرد فعالیتها</a></div>
                </details>
            }
            @if (Can("Payroll.View") || Can("PersonnelOrder.View")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Payroll") || Context.Request.Path.StartsWithSegments("/PersonnelOrder") ? "open" : null)">
                    <summary><span class="nav-icon">▥</span>خدمات کارکنان</summary><div class="nav-submenu">
                        @if (Can("Payroll.View")) { <a href="/Payroll/Payslip">فیش حقوقی</a> }
                        @if (Can("PersonnelOrder.View")) { <a href="/PersonnelOrder">حکم کارگزینی</a> }
                    </div>
                </details>
            }
            @if (Can("Users.Manage") || Can("Roles.Manage") || Can("Workflow.Manage") || Can("Settings.View")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Users") || Context.Request.Path.StartsWithSegments("/Workflow/Manage") || Context.Request.Path.StartsWithSegments("/SystemSettings") || Context.Request.Path.StartsWithSegments("/AuditLogs") ? "open" : null)">
                    <summary><span class="nav-icon">⚙</span>تنظیمات و مدیریت</summary><div class="nav-submenu">
                        @if (Can("Users.Manage") || Can("Roles.Manage")) { <a href="/Users">کاربران و نقش‌ها</a> }
                        @if (Can("Workflow.Manage")) { <a href="/Workflow/Manage">مدیریت گردش کار</a> }
                        @if (Can("Settings.View")) { <a href="/SystemSettings">تنظیمات سامانه</a> }
                        @if (isAdmin) {
                            <a href="/AuditLogs">گزارش فعالیت کاربران</a>
                            <a href="/DatabaseMaintenance">پاکسازی اطلاعات عملیاتی</a>
                        }
                    </div>
                </details>
            }
            <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Support") ? "open" : null)">
                <summary><span class="nav-icon">?</span>پشتیبانی</summary><div class="nav-submenu"><a href="/Support">راهنما و پشتیبانی</a></div>
            </details>
            @if (isAdmin) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Account") ? "open" : null)">
                    <summary><span class="nav-icon">⌁</span>حساب کاربری</summary><div class="nav-submenu"><a href="/Account/ChangePassword">تغییر رمز مدیر</a></div>
                </details>
            } else if (User.HasClaim("UserType", "Employee")) {
                <details class="nav-group" open="@(Context.Request.Path.StartsWithSegments("/Account") ? "open" : null)">
                    <summary><span class="nav-icon">⌁</span>حساب کاربری</summary><div class="nav-submenu"><a href="/Account/PersonalPassword">رمز عبور شخصی</a></div>
                </details>
            }
        </nav>

        <div class="sidebar-foot">
            <div>@(isAdmin ? "مدیر سامانه" : "کاربر کارکنان")</div>
            @if (HRPortal.BuildInfo.Commit != "نامشخص")
            {
                <a class="build-version" href="https://github.com/msxxalpha/HR-Portal/commit/@HRPortal.BuildInfo.Commit"
                   target="_blank" rel="noopener noreferrer"
                   title="نسخه منبع: @HRPortal.BuildInfo.Commit">
                    نسخه @HRPortal.BuildInfo.Number · @HRPortal.BuildInfo.Commit
                </a>
            }
            else
            {
                <span class="build-version">نسخه @HRPortal.BuildInfo.Number · Commit نامشخص</span>
            }
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div>
                <div class="topbar-caption">@company.ApplicationName</div>
                <h2>@ViewData["Title"]</h2>
            </div>
            <div class="user-box">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span style="font-weight:800;font-size:1.08rem">@User.Identity.Name</span>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button class="link" type="submit">خروج</button>
                    </form>
                }
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>
                @(string.IsNullOrWhiteSpace(company.FooterText) ? company.ApplicationName : company.FooterText)
                @if (!string.IsNullOrWhiteSpace(company.OrganizationName))
                {
                    <span> | @company.OrganizationName</span>
                }
            </span>
            <span class="build-version">نسخه @HRPortal.BuildInfo.Number · Commit @HRPortal.BuildInfo.Commit</span>
        </footer>
    </div>
</div>
<script src="@Url.Content("~/js/jalali-datepicker.js")" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)

<script>
(() => {
    const storageKey = 'hrportal.sidebar.groups.v1';
    let saved = {};
    try { saved = JSON.parse(sessionStorage.getItem(storageKey) || '{}') || {}; } catch { saved = {}; }
    const groups = [...document.querySelectorAll('.sidebar .nav details')];
    const keyOf = el => {
        const parts = [];
        let node = el;
        while (node && node.matches && node.matches('details')) {
            const label = node.querySelector(':scope > summary')?.textContent?.trim() || 'group';
            parts.unshift(label);
            node = node.parentElement?.closest('details');
        }
        return parts.join(' / ');
    };
    const currentPath = window.location.pathname.toLowerCase().replace(/\/$/, '') || '/';
    groups.forEach(group => {
        const key = keyOf(group);
        const hasCurrentLink = [...group.querySelectorAll('a[href]')].some(a => {
            try {
                const path = new URL(a.href, window.location.origin).pathname.toLowerCase().replace(/\/$/, '') || '/';
                return path === currentPath;
            } catch { return false; }
        });
        if (Object.prototype.hasOwnProperty.call(saved, key)) group.open = !!saved[key];
        if (hasCurrentLink) group.open = true;
        group.dataset.navStateKey = key;
        group.addEventListener('toggle', () => {
            saved[group.dataset.navStateKey] = group.open;
            try { sessionStorage.setItem(storageKey, JSON.stringify(saved)); } catch { }
        });
    });
})();
</script>
</body>
</html>