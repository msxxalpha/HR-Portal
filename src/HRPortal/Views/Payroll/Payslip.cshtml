
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "فیش حقوقی";
}
<div class="page-head">
    <div>
        <h1>فیش حقوقی</h1>
        <p>شماره پرسنلی از حساب کاربر لاگین‌شده دریافت می‌شود و در فرم قابل تغییر نیست. دوره گزارش را به صورت شش‌رقمی مانند ۱۴۰۵۰۶ وارد کنید.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error">
        @foreach (var item in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        { <div>@item.ErrorMessage</div> }
    </div>
}

@if (ViewBag.Message != null)
{
    var messageClass = ViewBag.MessageType as string ?? (ViewBag.ReportUrl == null ? "error" : "success");
    <div class="alert @messageClass">@ViewBag.Message</div>
}

<div class="card">
    <div class="report-user-row">
        <div class="report-user">
            <span>کاربر جاری</span>
            <strong>@User.Identity?.Name</strong>
            @if (ViewBag.PersonnelNumber != null)
            {
                <small>شماره پرسنلی: @ViewBag.PersonnelNumber</small>
            }
            else
            {
                <small>حساب مدیر سامانه</small>
            }
        </div>

        @if (ViewBag.PersonnelNumber != null)
        {
            <form method="get" asp-controller="Payroll" asp-action="Payslip" class="report-filter report-filter-inline" id="payslipPeriodForm" novalidate>
                <label class="report-period">
                    سال / ماه
                    <input name="yearMonth"
                           id="payslipYearMonth"
                           class="@((bool?)ViewBag.PayrollPeriodInvalid == true ? "input-invalid" : "")"
                           value="@ViewBag.YearMonth"
                           placeholder="۱۴۰۵۰۶"
                           maxlength="6"
                           inputmode="numeric"
                           autocomplete="off"
                           required
                           aria-describedby="payslipPeriodError"
                           aria-invalid="@(((bool?)ViewBag.PayrollPeriodInvalid == true).ToString().ToLowerInvariant())" />
                    <small id="payslipPeriodError" class="field-validation-error" role="alert"
                           style="display:@(((bool?)ViewBag.PayrollPeriodInvalid == true) ? "block" : "none")">
                        @if ((bool?)ViewBag.PayrollPeriodInvalid == true)
                        { <text>حداکثر دوره مجاز @ViewBag.LatestAllowedYearMonth است؛ ماه جاری و ماه‌های آینده قابل مشاهده نیستند.</text> }
                    </small>
                </label>
                <button class="btn btn-main" id="payslipViewButton" type="submit" disabled="@((bool?)ViewBag.PayrollPeriodInvalid == true)">مشاهده فیش حقوقی</button>
            </form>
        }
    </div>
</div>

@if (ViewBag.ReportEndpoint != null)
{
    var allowPrint = (bool?)ViewBag.ReportAllowPrint ?? true;
    var allowDownload = (bool?)ViewBag.ReportAllowDownload ?? true;
    var showToolbar = allowPrint || allowDownload;
    <div class="report-container">
        @if (showToolbar)
        {
            <div class="report-toolbar">
                <div>
                    <strong>ابزارهای گزارش</strong>
                    <span>امکانات نمایش مطابق تنظیمات سامانه فعال شده‌اند.</span>
                </div>
                <div class="actions">
                    @if (allowPrint)
                    {
                        <a class="btn btn-outline" href="@Url.Action("Print", "Payroll", new { yearMonth = ViewBag.YearMonth })" target="_blank" rel="noopener">چاپ گزارش</a>
                    }
                    @if (allowDownload)
                    {
                        <a class="btn btn-main" href="@Url.Action("Download", "Payroll", new { yearMonth = ViewBag.YearMonth })">ذخیره PDF</a>
                    }
                </div>
            </div>
        }
        <div class="report-frame">
            <iframe src="@($"{ViewBag.ReportEndpoint}#toolbar=0&navpanes=0&scrollbar=1&view=FitH")" title="نمایش فیش حقوقی" loading="lazy"></iframe>
        </div>
    </div>
}

@section Scripts
{
    <script>
        (() => {
            const form = document.getElementById("payslipPeriodForm");
            const periodInput = document.getElementById("payslipYearMonth");
            const viewButton = document.getElementById("payslipViewButton");
            const periodError = document.getElementById("payslipPeriodError");
            const latestAllowed = "@(ViewBag.LatestAllowedYearMonth ?? "")";

            const toLatinDigits = value => (value || "").replace(/[۰-۹٠-٩]/g, digit => {
                const fa = "۰۱۲۳۴۵۶۷۸۹";
                const ar = "٠١٢٣٤٥٦٧٨٩";
                const index = fa.indexOf(digit);
                return String(index >= 0 ? index : ar.indexOf(digit));
            });

            const validatePeriod = () => {
                if (!form || !periodInput || !viewButton) return true;
                const value = toLatinDigits(periodInput.value).trim();
                const validFormat = /^\\d{4}(0[1-9]|1[0-2])$/.test(value);
                const validRange = validFormat && latestAllowed && value <= latestAllowed;
                const valid = Boolean(validRange);
                periodInput.classList.toggle("input-invalid", !valid && value.length > 0);
                periodInput.setAttribute("aria-invalid", String(!valid && value.length > 0));
                viewButton.disabled = !valid;
                if (periodError) {
                    periodError.textContent = !valid && value.length > 0
                        ? (validFormat
                            ? `حداکثر دوره مجاز ${latestAllowed} است؛ ماه جاری و ماه‌های آینده قابل مشاهده نیستند.`
                            : "سال و ماه را به صورت شش‌رقمی معتبر مانند ۱۴۰۵۰۶ وارد کنید.")
                        : "";
                    periodError.style.display = !valid && value.length > 0 ? "block" : "none";
                }
                return valid;
            };

            if (periodInput) {
                periodInput.addEventListener("input", validatePeriod);
                periodInput.addEventListener("change", validatePeriod);
                validatePeriod();
            }
            if (form) form.addEventListener("submit", event => {
                if (!validatePeriod()) {
                    event.preventDefault();
                    periodInput?.focus();
                }
            });

            // Remove an accidental literal "\\n" text prefix if it is emitted by a
            // surrounding template/partial before the payroll period controls.
            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
            const nodes = [];
            while (walker.nextNode()) nodes.push(walker.currentNode);
            for (const node of nodes) {
                if (node.nodeValue && /^\s*\\n(?=\s|[^a-zA-Z])/u.test(node.nodeValue)) {
                    node.nodeValue = node.nodeValue.replace(/^\s*\\n/u, "");
                }
            }

            // Best-effort protection for the native browser PDF frame.
            // Browser-owned PDF viewer internals may not expose all events to the host page.
            document.addEventListener("contextmenu", (event) => {
                if (event.target instanceof Element && event.target.closest(".report-frame")) {
                    event.preventDefault();
                    event.stopPropagation();
                }
            }, true);
            document.addEventListener("keydown", (event) => {
                const key = (event.key || "").toLowerCase();
                if (event.key === "PrintScreen" || event.code === "PrintScreen" ||
                    ((event.ctrlKey || event.metaKey) && ["s", "p", "c"].includes(key)) ||
                    (event.metaKey && event.shiftKey && key === "s")) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                }
            }, true);
        })();
    </script>
}
