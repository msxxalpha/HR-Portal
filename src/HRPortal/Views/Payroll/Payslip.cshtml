
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "فیش حقوقی";
}
<div class="page-head">
    <div>
        <h1>فیش حقوقی</h1>
        <p>شماره پرسنلی از حساب کاربر لاگین‌شده دریافت می‌شود و در فرم قابل تغییر نیست. دوره گزارش را به صورت شش‌رقمی مانند ۱۴۰۵۰۶ وارد کنید.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error">
        @foreach (var item in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        { <div>@item.ErrorMessage</div> }
    </div>
}

@if (ViewBag.Message != null)
{
    var messageClass = ViewBag.MessageType as string ?? (ViewBag.ReportUrl == null ? "error" : "success");
    <div class="alert @messageClass">@ViewBag.Message</div>
}

<div class="card">
    <div class="report-user-row">
        <div class="report-user">
            <span>کاربر جاری</span>
            <strong>@User.Identity?.Name</strong>
            @if (ViewBag.PersonnelNumber != null)
            {
                <small>شماره پرسنلی: @ViewBag.PersonnelNumber</small>
            }
            else
            {
                <small>حساب مدیر سامانه</small>
            }
        </div>

        @if (ViewBag.PersonnelNumber != null)
        {
            <form method="get" asp-controller="Payroll" asp-action="Payslip" class="report-filter report-filter-inline">
                <label class="report-period">
                    سال / ماه
                    <input name="yearMonth"
                           value="@ViewBag.YearMonth"
                           placeholder="۱۴۰۵۰۶"
                           maxlength="6"
                           inputmode="numeric"
                           autocomplete="off"
                           required />
                </label>
                <button class="btn btn-main" type="submit">مشاهده فیش حقوقی</button>
            </form>
        }
    </div>
</div>

@if (ViewBag.ReportEndpoint != null)
{
    var allowPrint = (bool?)ViewBag.ReportAllowPrint ?? true;
    var allowDownload = (bool?)ViewBag.ReportAllowDownload ?? true;
    var showToolbar = allowPrint || allowDownload;
    <div class="report-container">
        @if (showToolbar)
        {
            <div class="report-toolbar">
                <div>
                    <strong>ابزارهای گزارش</strong>
                    <span>امکانات نمایش مطابق تنظیمات سامانه فعال شده‌اند.</span>
                </div>
                <div class="actions">
                    @if (allowPrint)
                    {
                        <a class="btn btn-outline" href="@Url.Action("Print", "Payroll", new { yearMonth = ViewBag.YearMonth })" target="_blank" rel="noopener">چاپ گزارش</a>
                    }
                    @if (allowDownload)
                    {
                        <a class="btn btn-main" href="@Url.Action("Download", "Payroll", new { yearMonth = ViewBag.YearMonth })">ذخیره PDF</a>
                    }
                </div>
            </div>
        }
        <div class="report-frame">
            <iframe src="@ViewBag.ReportEndpoint#toolbar=0&navpanes=0&scrollbar=1&view=FitH" title="گزارش فیش حقوقی"></iframe>
        </div>
    </div>
}