@model HRPortal.Models.OutsourcedServiceRequestFormVm
@{
    var isEdit = (bool)(ViewBag.IsEdit ?? false);
    var returnTaskId = ViewBag.ReturnTaskId as int?;
    var isWorkflowReturnEdit = returnTaskId.HasValue;
    ViewData["Title"] = isEdit ? "ویرایش سفارش خدمات برونسپاری" : "سفارش خدمات برونسپاری";
    var formAction = isEdit ? Url.Action("Edit", "OutsourcedServices", new { id = Context.Request.RouteValues["id"], returnTaskId }) : Url.Action("Create", "OutsourcedServices");
    var units = (string[])ViewBag.Units;
    var priorities = (Dictionary<string,string>)ViewBag.Priorities;
}
<div class="outsourced-page">
    <div class="outsourced-hero">
        <div class="outsourced-hero-icon">↗</div>
        <div><span>خدمات کارکنان</span><h1>@(isEdit ? "ویرایش سفارش خدمات برونسپاری" : "ثبت سفارش خدمات برونسپاری")</h1><p>@(isWorkflowReturnEdit ? "درخواست برای اصلاح به شما بازگشته است. پس از ذخیره تغییرات، به کارتابل بازمی‌گردید تا درخواست را مجدداً در مسیر گردش کار ثبت کنید." : isEdit ? "اطلاعات درخواست را اصلاح کنید؛ نسخه قبلی برای سوابق و پیگیری محفوظ می‌ماند." : "درخواست خدمات موردنیاز را ثبت کنید تا پس از طی تأییدیه‌های سازمانی، برای انجام به پیمانکار برون‌سازمانی ارجاع شود.")</p></div>
        <a class="btn btn-outline" href="/OutsourcedServices">فهرست درخواست‌ها</a>
    </div>
    @if (TempData["Warning"] is string warning) { <div class="alert warning">@warning</div> }
    @if (!ViewData.ModelState.IsValid) { <div class="alert error">لطفاً اطلاعات مشخص‌شده را بررسی و اصلاح کنید.</div> }
    <form method="post" action="@formAction" class="outsourced-form">
        @Html.AntiForgeryToken()
        <div class="outsourced-section-head"><div><small>اطلاعات درخواست</small><h2>مشخصات خدمت موردنیاز</h2></div><span class="required-note">فیلدهای ستاره‌دار الزامی هستند</span></div>
        <div class="outsourced-form-grid">
            <label class="outsourced-field wide">شرح خدمات درخواستی <b>*</b>
                <textarea asp-for="ServiceDescription" rows="5" maxlength="3000" required placeholder="شرح دقیق خدمت، محدوده کار، خروجی مورد انتظار و نکات ضروری را وارد کنید."></textarea>
                <span asp-validation-for="ServiceDescription"></span>
            </label>
            <label class="outsourced-field">واحد سنجش <b>*</b>
                <select asp-for="UnitOfMeasure" required><option value="">انتخاب واحد سنجش</option>@foreach (var unit in units){<option value="@unit">@unit</option>}</select>
                <span asp-validation-for="UnitOfMeasure"></span>
            </label>
            <label class="outsourced-field">مقدار <b>*</b>
                <input asp-for="Quantity" type="number" min="0.001" max="999999999" step="0.001" required placeholder="مثلاً ۱۲" />
                <span asp-validation-for="Quantity"></span>
            </label>
            <label class="outsourced-field">تاریخ نیازمندی <b>*</b>
                <div class="jalali-date-input">
                    <input asp-for="NeedByDateJalali" id="NeedByDateJalali" data-jalali-date autocomplete="off" inputmode="numeric" required placeholder="۱۴۰۵/۰۸/۲۵" />
                    <button type="button" class="btn btn-outline jalali-date-open" data-jalali-trigger aria-label="انتخاب تاریخ">تقویم</button>
                </div>
                <span asp-validation-for="NeedByDateJalali"></span>
            </label>
            <label class="outsourced-field">اولویت انجام کار <b>*</b>
                <select asp-for="Priority" required>@foreach (var item in priorities){<option value="@item.Key">@item.Value</option>}</select>
                <span class="field-hint">درخواست‌های فوری و اضطراری در گزارش‌ها به‌صورت جداگانه قابل پایش هستند.</span>
            </label>
        </div>
        <div class="outsourced-form-footer">
            <a class="btn btn-outline" href="/OutsourcedServices">انصراف</a>
            <button class="btn btn-main" type="submit">@(isWorkflowReturnEdit ? "ذخیره اصلاحات و بازگشت به کارتابل" : isEdit ? "ذخیره تغییرات" : "ثبت درخواست و ارسال به گردش کار") <span>←</span></button>
        </div>
    </form>
    @if (!isEdit)
    {
        <div class="outsourced-process-note"><strong>پس از ثبت چه اتفاقی می‌افتد؟</strong><span>درخواست در سامانه ثبت می‌شود و در صورت تعریف گردش کار فعال برای این فرم، به‌صورت خودکار برای تأیید به مسئول یا جایگاه تعیین‌شده ارجاع خواهد شد. ارجاع به پیمانکار پس از تکمیل تأییدیه‌ها انجام می‌شود.</span></div>
    }
</div>