<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HRPortal</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Generate a tiny source file before compilation. This works for both
       Visual Studio and CI builds, without requiring Git metadata at runtime. -->
  <Target Name="GenerateGitBuildInfo" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_GitCommitHash Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</_GitCommitHash>
    </PropertyGroup>
    <Exec Command="git rev-parse --short=12 HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true"
          Condition="'$(_GitCommitHash)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <_GitCommitHashTrimmed>$([System.String]::Copy('$(_GitCommitHash)').Trim())</_GitCommitHashTrimmed>
      <_GitCommitHashTrimmed Condition="'$(_GitCommitHashTrimmed)' == ''">unknown</_GitCommitHashTrimmed>
    </PropertyGroup>
    <ItemGroup>
      <_GitBuildInfoLine Include="namespace HRPortal%3B" />
      <_GitBuildInfoLine Include="public static partial class BuildInfo" />
      <_GitBuildInfoLine Include="{" />
      <_GitBuildInfoLine Include="    static partial void SetGitCommit(ref string commit) { commit = &quot;$(_GitCommitHashTrimmed)&quot;%3B }" />
      <_GitBuildInfoLine Include="}" />
      <Compile Include="$(IntermediateOutputPath)GitBuildInfo.g.cs" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)GitBuildInfo.g.cs" Lines="@(_GitBuildInfoLine)" Overwrite="true" />
    <Message Importance="High" Text="HR Portal source commit: $(_GitCommitHashTrimmed)" />
  </Target>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.20" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.20" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>