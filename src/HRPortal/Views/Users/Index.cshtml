@model HRPortal.Models.UserRoleManagementViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "مدیریت کاربران و نقش‌ها";
    var canUsers = (bool?)ViewBag.CanUsers ?? false;
    var canRoles = (bool?)ViewBag.CanRoles ?? false;
}
<div class="page-head">
    <div>
        <h1>مدیریت کاربران و نقش‌ها</h1>
        <p>سطح دسترسی مؤثر هر کاربر اجتماع مجوزهای تمام نقش‌های مستقیم و نقش‌های منتسب به رده سازمانی اوست؛ داشتن یک نقش محدودتر، مجوز نقش دیگر را لغو نمی‌کند. تغییرات نقش‌ها در درخواست بعدی کاربر اعمال می‌شود.</p>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }

<div class="users-roles-toolbar"><label>جستجوی نقش<input id="rolesSearch" type="search" placeholder="نام یا کد نقش را وارد کنید..." autocomplete="off" /></label><span>دسترسی‌ها در هر نقش به تفکیک ماژول دسته‌بندی شده‌اند.</span></div>
<div class="tabs settings-tabs">
    @if (canUsers) { <button type="button" class="tab @(canUsers ? "active" : "")" data-tab="users">کاربران</button> }
    @if (canRoles) { <button type="button" class="tab @(!canUsers ? "active" : "")" data-tab="roles">نقش‌ها و سطح دسترسی</button> }
</div>

@if (canUsers)
{
<section id="users" class="tab-panel active">
    <div class="card">
        <div class="section-head">
            <div>
                <h3>کاربران کارکنان</h3>
                <span class="muted">نام کاربری کارکنان همان شماره پرسنلی است و ورود با OTP یا رمز شخصی انجام می‌شود.</span>
            </div>
        </div>
        <div class="users-table-tools">
            <label>جستجو
                <input id="usersSearch" type="search" placeholder="نام، نام خانوادگی، شماره پرسنلی یا واحد..." autocomplete="off" />
            </label>
            <label>وضعیت کاربر
                <select id="usersStatusFilter"><option value="all">همه</option><option value="active">فعال</option><option value="inactive">غیرفعال</option></select>
            </label>
            <label>نقش
                <select id="usersRoleFilter"><option value="all">همه نقش‌ها</option>
                    @foreach (var role in Model.Roles) { <option value="@role.Id">@role.Title</option> }
                </select>
            </label>
            <label>تعداد در صفحه
                <select id="usersPageSize"><option value="25">۲۵</option><option value="50">۵۰</option><option value="100">۱۰۰</option></select>
            </label>
            <span id="usersResultCount" class="muted" aria-live="polite"></span>
        </div>
        <div class="table-wrap users-table-wrap">
            <table class="users-management-table">
                <thead>
                    <tr><th>شماره پرسنلی</th><th>کارمند</th><th>واحد</th><th>نقش‌ها</th><th>رمز شخصی</th><th>دسترسی شخصی</th><th>فعال</th><th>عملیات</th></tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Users)
                {
                    var formId = "user-form-" + row.Employee.Id;
                    <tr>
                        <td>
                            <form id="@formId" method="post" action="/Users/SaveUser">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="employeeId" value="@row.Employee.Id" />
                            </form>
                            @row.Employee.PersonnelNumber
                        </td>
                        <td>@row.Employee.FirstName @row.Employee.LastName</td>
                        <td>@(row.Employee.OrganizationUnit?.Title ?? "—")</td>
                        <td>
                            <div class="permission-chips">
                                @foreach (var role in Model.Roles)
                                {
                                    <label class="check-chip">
                                        <input type="checkbox" name="roleIds" value="@role.Id" form="@formId" @(row.RoleIds.Contains(role.Id) ? "checked" : "") />
                                        <span>@role.Title</span>
                                    </label>
                                }
                            </div>
                        </td>
                        <td><span class="badge">@(string.IsNullOrWhiteSpace(row.Employee.PersonalPasswordHash) ? "تعیین نشده" : "تعیین شده")</span></td>
                        <td><details class="personal-permissions"><summary>تنظیم دسترسی اختصاصی <small>(@row.PersonalPermissionIds.Count)</small></summary>
                        <form method="post" action="/Users/SavePersonalPermissions">@Html.AntiForgeryToken()<input type="hidden" name="employeeId" value="@row.Employee.Id" />
                        @foreach(var group in Model.Permissions.GroupBy(x=>x.Module).OrderBy(x=>x.Key)){<fieldset><legend>@group.Key</legend><div class="personal-permission-grid">@foreach(var permission in group.OrderBy(x=>x.Title)){<label><input type="checkbox" name="permissionIds" value="@permission.Id" @(row.PersonalPermissionIds.Contains(permission.Id)?"checked":"") /><span>@permission.Title</span></label>}</div></fieldset>}
                        <button class="btn btn-main btn-sm" type="submit">ذخیره دسترسی شخصی</button></form></details></td>
                        <td>
                            <label class="switch-control">
                                <input type="checkbox" name="isSystemUser" value="true" form="@formId" @(row.Employee.IsSystemUser ? "checked" : "") />
                                <span class="switch-slider"></span>
                            </label>
                        </td>
                        <td>
                            <button class="btn btn-outline btn-sm" type="submit" form="@formId">ذخیره نقش و وضعیت</button>
                            @if(row.IsPasswordLocked){<form method="post" action="/Users/UnlockPassword" class="unlock-user-form">@Html.AntiForgeryToken()<input type="hidden" name="employeeId" value="@row.Employee.Id" /><span class="locked-label">ورود با رمز قفل است</span><button class="btn btn-warning btn-sm" type="submit">بازکردن قفل</button></form>}
                            <form method="post" action="/Users/SetPersonalCredential" style="margin-top:8px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="employeeId" value="@row.Employee.Id" />
                                <input type="password" name="newValue" autocomplete="new-password" placeholder="رمز جدید (حداقل ۶ کاراکتر)" required style="max-width:150px;" />
                                <input type="password" name="confirmValue" autocomplete="new-password" placeholder="تکرار رمز" required style="max-width:150px;margin-top:4px;" />
                                <button class="btn btn-main btn-sm" type="submit" style="margin-top:4px;">تعیین/تغییر رمز</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr class="users-empty-row"><td colspan="8" class="empty">هنوز کارمندی ثبت نشده است.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
}

@if (canRoles)
{
<section id="roles" class="tab-panel @(canUsers ? "" : "active")">
    <div class="card">
        <div class="section-head">
            <div><h3>ایجاد نقش جدید</h3><span class="muted">یک نقش بسازید و عملکردهای مجاز آن را انتخاب کنید.</span></div>
        </div>
        <form method="post" action="/Users/SaveRole">
            @Html.AntiForgeryToken()
            <div class="grid-3">
                <label>کد نقش *<input name="Code" required placeholder="ROLE_CODE" /></label>
                <label>عنوان نقش *<input name="Title" required placeholder="عنوان نقش" /></label>
                <label>شرح<input name="Description" placeholder="توضیحات" /></label>
            </div>
            @foreach(var group in Model.Permissions.GroupBy(x=>x.Module).OrderBy(x=>x.Key)){<details class="permission-module" open><summary>@group.Key <span>@group.Count() دسترسی</span></summary><div class="permission-grid">@foreach(var permission in group.OrderBy(x=>x.Title)){<label class="permission-item"><input type="checkbox" name="PermissionIds" value="@permission.Id" /><span><strong>@permission.Title</strong><small>@permission.Code</small></span></label>}</div></details>}
            <label class="inline-check"><input type="checkbox" name="IsActive" value="true" checked /> نقش فعال باشد</label>
            <div class="form-actions"><button class="btn btn-main" type="submit">ایجاد نقش</button></div>
        </form>
    </div>

    @foreach (var role in Model.Roles)
    {
        <div class="card">
            <form method="post" action="/Users/SaveRole">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@role.Id" />
                <div class="section-head">
                    <div><h3>@role.Title</h3><span class="muted">@role.Code</span></div>
                    <label class="inline-check"><input type="checkbox" name="IsActive" value="true" @(role.IsActive ? "checked" : "") /> فعال</label>
                </div>
                <div class="grid-2">
                    <label>کد نقش<input name="Code" value="@role.Code" required /></label>
                    <label>عنوان نقش<input name="Title" value="@role.Title" required /></label>
                    <label class="wide">شرح<textarea name="Description">@role.Description</textarea></label>
                </div>
                @foreach(var group in Model.Permissions.GroupBy(x=>x.Module).OrderBy(x=>x.Key)){<details class="permission-module" open><summary>@group.Key <span>@group.Count() دسترسی</span></summary><div class="permission-grid">@foreach(var permission in group.OrderBy(x=>x.Title)){<label class="permission-item"><input type="checkbox" name="PermissionIds" value="@permission.Id" @(role.PermissionIds.Contains(permission.Id)?"checked":"") /><span><strong>@permission.Title</strong><small>@permission.Code</small></span></label>}</div></details>}
                <div class="form-actions"><button class="btn btn-outline" type="submit">ذخیره نقش</button></div>
            </form>
            <div class="section-head" style="margin-top:18px;">
                <div><h4>تخصیص نقش به رده‌های سازمانی</h4><span class="muted">تمام کارکنان منتسب به رده‌های انتخاب‌شده در آخرین ساختار نهایی‌شده، دسترسی‌های این نقش را به ارث می‌برند.</span></div>
            </div>
            <form method="post" action="/Users/SaveRoleRanks">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" value="@role.Id" />
                @if (Model.OrganizationRankTypes.Count == 0)
                {
                    <div class="empty">رده سازمانی برای تخصیص وجود ندارد. ابتدا رده‌ها را در اطلاعات پایه تعریف کنید.</div>
                }
                else
                {
                    <div class="permission-grid">
                        @foreach (var rankType in Model.OrganizationRankTypes)
                        {
                            <label class="permission-item">
                                <input type="checkbox" name="rankTypes" value="@rankType" @(Model.RoleRankTypes.TryGetValue(role.Id, out var assignedRanks) && assignedRanks.Contains(rankType, StringComparer.OrdinalIgnoreCase) ? "checked" : "") />
                                <span><strong>@rankType</strong><small>اعمال دسترسی‌های نقش «@role.Title» به کارکنان این رده</small></span>
                            </label>
                        }
                    </div>
                }
                <div class="form-actions"><button class="btn btn-main" type="submit">ذخیره رده‌های این نقش</button></div>
            </form>
        </div>
    }
</section>
}

@section Scripts {
<script>
document.querySelectorAll('.tab').forEach(function (button) {
    button.addEventListener('click', function () {
        document.querySelectorAll('.tab').forEach(function (b) { b.classList.remove('active'); });
        document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('active'); });
        button.classList.add('active');
        document.getElementById(button.dataset.tab).classList.add('active');
    });
});
const roleSearch=document.getElementById('rolesSearch');
if(roleSearch){roleSearch.addEventListener('input',()=>{const q=roleSearch.value.trim().toLocaleLowerCase('fa');document.querySelectorAll('#roles > .card').forEach(card=>{const isCreate=card.querySelector('form[action="/Users/SaveRole"] input[name="Id"]')===null;card.style.display=isCreate||card.innerText.toLocaleLowerCase('fa').includes(q)?'':'none';});});}
const usersTable = document.querySelector('.users-management-table');
if (usersTable) {
    const body = usersTable.tBodies[0];
    const rows = Array.from(body.rows).filter(row => !row.classList.contains('users-empty-row'));
    const search = document.getElementById('usersSearch');
    const status = document.getElementById('usersStatusFilter');
    const role = document.getElementById('usersRoleFilter');
    const pageSize = document.getElementById('usersPageSize');
    const count = document.getElementById('usersResultCount');
    const pager = document.createElement('div');
    pager.className = 'users-pagination';
    pager.innerHTML = '<button type="button" class="btn btn-outline btn-sm" data-prev>قبلی</button><span data-page></span><button type="button" class="btn btn-outline btn-sm" data-next>بعدی</button>';
    usersTable.closest('.users-table-wrap').insertAdjacentElement('afterend', pager);
    let currentPage = 1;
    function applyUserFilters() {
        const q = (search.value || '').trim().toLocaleLowerCase('fa');
        const activeFilter = status.value;
        const roleFilter = role.value;
        const filtered = rows.filter(row => {
            const textMatch = !q || row.innerText.toLocaleLowerCase('fa').includes(q);
            const activeBox = row.querySelector('input[name="isSystemUser"]');
            const active = !!(activeBox && activeBox.checked);
            const statusMatch = activeFilter === 'all' || (activeFilter === 'active' ? active : !active);
            const roleMatch = roleFilter === 'all' || Array.from(row.querySelectorAll('input[name="roleIds"]')).some(input => input.value === roleFilter && input.checked);
            return textMatch && statusMatch && roleMatch;
        });
        const size = Math.max(1, parseInt(pageSize.value, 10) || 25);
        const pages = Math.max(1, Math.ceil(filtered.length / size));
        currentPage = Math.min(currentPage, pages);
        rows.forEach(row => row.style.display = 'none');
        filtered.slice((currentPage - 1) * size, currentPage * size).forEach(row => row.style.display = '');
        const empty = body.querySelector('.users-empty-row');
        if (empty) empty.style.display = filtered.length ? 'none' : '';
        count.textContent = 'نمایش ' + filtered.length + ' کاربر';
        pager.querySelector('[data-page]').textContent = 'صفحه ' + currentPage + ' از ' + pages;
        pager.querySelector('[data-prev]').disabled = currentPage <= 1;
        pager.querySelector('[data-next]').disabled = currentPage >= pages;
    }
    [search, status, role, pageSize].forEach(control => control.addEventListener('input', () => { currentPage = 1; applyUserFilters(); }));
    pager.querySelector('[data-prev]').addEventListener('click', () => { currentPage--; applyUserFilters(); });
    pager.querySelector('[data-next]').addEventListener('click', () => { currentPage++; applyUserFilters(); });
    body.addEventListener('change', event => { if (event.target.matches('input[name="roleIds"], input[name="isSystemUser"]')) applyUserFilters(); });
    applyUserFilters();
}
</script>
}
