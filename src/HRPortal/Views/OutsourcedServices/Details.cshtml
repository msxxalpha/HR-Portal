@model HRPortal.Models.OutsourcedServiceRequest
@{
    ViewData["Title"] = "جزئیات سفارش خدمات برونسپاری";
    var requester = ViewBag.Requester;
    var workflow = ViewBag.Workflow;
}
<div class="outsourced-page">
    @if (TempData["Success"] is string success) { <div class="alert success">@success</div> }
    @if (TempData["Warning"] is string warning) { <div class="alert warning">@warning</div> }
    <div class="outsourced-hero"><div class="outsourced-hero-icon">✓</div><div><span>شماره پیگیری · <b dir="ltr">@Model.RequestNumber</b></span><h1>جزئیات سفارش خدمات برونسپاری</h1><p>اطلاعات ثبت‌شده و آخرین وضعیت گردش کار درخواست.</p></div><a class="btn btn-outline" href="/OutsourcedServices">بازگشت به فهرست</a></div>
    <section class="outsourced-detail-grid">
        <article><small>شرح خدمات درخواستی</small><p>@Model.ServiceDescription</p></article>
        <article><small>واحد سنجش و مقدار</small><strong>@Model.Quantity.ToString("0.###") @Model.UnitOfMeasure</strong></article>
        <article><small>تاریخ نیازمندی</small><strong>@HRPortal.Services.PersianDateService.Format(Model.NeedByDate)</strong></article>
        <article><small>اولویت</small><strong>@(ViewBag.PriorityTitle ?? Model.Priority)</strong></article>
        <article><small>درخواست‌کننده</small><strong>@(requester?.Name ?? "—")</strong><span>@(requester?.PersonnelNumber ?? "")</span></article>
        <article><small>تاریخ و زمان ثبت</small><strong>@HRPortal.Services.PersianDateService.FormatDateTime(HRPortal.Services.PersianDateService.ToTehran(Model.CreatedAtUtc))</strong></article>
    </section>
    <section class="outsourced-workflow-card"><h2>وضعیت گردش کار</h2>@if(workflow is null){<p>برای این فرم هنوز گردش کار فعالی تعریف نشده است یا گردش کار آغاز نشده است.</p><a href="/Workflow/MyRequests">مشاهده درخواست‌های من</a>}else{<div class="workflow-state-line"><strong>@(workflow.Status=="Completed"?"تکمیل‌شده":workflow.Status=="Approved"?"تأیید نهایی":workflow.Status=="Rejected"?"رد یا لغو شده":workflow.Status=="Returned"?"برگشت داده‌شده":"در حال گردش")</strong><span>@(string.IsNullOrWhiteSpace((string)workflow.StepTitle)?"مرحله جاری مشخص نشده":workflow.StepTitle)</span></div><a href="/Workflow/MyRequests">پیگیری در درخواست‌های من</a>}</section>
</div>