@model HRPortal.Models.ContractRenewalStageViewModel
@using HRPortal.Services
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "اقدام در تمدید قرارداد";
    var r = Model.Request;
    var currentScoreTotal = Model.CurrentScores.Sum(x => x.Score ?? 0m);
    var editingScores = Model.StageKind == "Evaluation";
    var viewingAllScores = Model.StageKind is "Security" or "HumanResources" or "CEO";
    var suggested = Model.SuggestedContractMonths ?? 0;
    var displayedFinalScore = Model.StageKind == "HumanResources" && !Model.IsHrDisciplinaryScoreDeductionEnabled && !Model.IsReadOnly
        ? r.OriginalEvaluationScore ?? r.FinalEvaluationScore
        : r.FinalEvaluationScore;
    string score(decimal? value) => value.HasValue ? value.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "—";
    string faDate(DateTime? value) => value.HasValue ? PersianDateService.Format(value.Value) : "سابقه‌ای ثبت نشده است";
    string securityDecisionTitle(string? value) => value switch
    {
        "ApproveFull" => "موافقت با تمدید قرارداد",
        "ApproveOneMonth" => "موافقت با تمدید یک‌ماهه قرارداد",
        "Reject" => "عدم موافقت با تمدید قرارداد",
        _ => "ثبت نشده"
    };
}
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }

<div class="page-head">
    <div>
        <h1>@Model.Task.WorkflowStep.Title</h1>
        <p>درخواست @r.RequestCode — @r.EmployeeNameSnapshot — شماره پرسنلی @r.PersonnelNumberSnapshot</p>
    </div>
    <div class="actions">
        @if (r.Status == "تکمیل شده" && r.CompletedAt.HasValue &&
            (User.HasClaim("IsAdmin", "1") || User.HasClaim("Permission", "ContractRenewal.Reports")))
        {
            <a class="btn btn-main" href="/EmployeeContracts/DownloadReport?id=@r.Id">دریافت خلاصه ارزشیابی PDF</a>
        }
        <a class="btn btn-outline" href="/Workflow/Inbox">بازگشت به کارتابل</a>
    </div>
</div>

<section class="contract-stage-summary">
    <div><span>وضعیت درخواست</span><strong>@r.Status</strong></div>
    <div><span>جایگاه / مرحله جاری</span><strong>@(Model.Task.AssignedPosition?.Title ?? Model.Task.WorkflowStep.Title)</strong></div>
    <div><span>تاریخ ثبت</span><strong>@PersianDateService.Format(r.CreatedAt)</strong></div>
    @if (viewingAllScores)
    {
        <div><span>امتیاز نهایی ارزشیابی</span><strong>@score(displayedFinalScore) از ۱۰۰</strong></div>
    }
    @if (Model.StageKind is "Security" or "HumanResources" or "CEO")
    {
        <div><span>مدت پیشنهادی سیستم بر اساس امتیاز نهایی</span><strong><span id="systemSuggestedMonths">@suggested</span> ماه</strong></div>
    }
    @if (Model.StageKind == "CEO")
    {
        <div><span>پیشنهاد مدت مدیر منابع انسانی</span><strong>@(r.HrProposedContractMonths.HasValue ? r.HrProposedContractMonths.Value + " ماه" : "ثبت نشده")</strong></div>
    }
</section>

@if (Model.Task.WorkflowInstance.Status == "InProgress" &&
    (User.HasClaim("IsAdmin", "1") || User.HasClaim("Permission", "Workflow.SkipStep")))
{
    <section class="card" style="margin-top:1rem;border:1px solid #fed7aa;background:#fffaf3">
        <div class="section-head"><div><h3>عبور از مرحله جاری</h3><span class="muted">این عملیات مرحله جاری را بدون حذف سوابق خاتمه می‌دهد و گردش کار را به مرحله بعد منتقل می‌کند.</span></div></div>
        <form method="post" action="/Workflow/SkipCurrentStep" class="form-stack"
              onsubmit="return confirm('از این مرحله ارزشیابی/تمدید قرارداد عبور شود؟ سابقه و علت عبور ثبت خواهد شد.');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="workflowInstanceId" value="@Model.Task.WorkflowInstanceId" />
            <label>علت عبور از مرحله جاری *
                <textarea name="reason" rows="3" maxlength="1000" required placeholder="علت عبور و مستند تصمیم را ثبت کنید."></textarea>
            </label>
            <div class="actions"><button class="btn btn-warning" type="submit">عبور از مرحله جاری و ادامه گردش</button></div>
        </form>
    </section>
}

<section class="card">
    <div class="section-head"><div><h3>اطلاعات اولیه کارمند</h3><span class="muted">اطلاعات ثبت‌شده توسط کارگزینی؛ این مرحله فقط خواندنی است.</span></div></div>
    <div class="contract-preview-grid">
        <div><span>نام و نام خانوادگی</span><strong>@r.EmployeeNameSnapshot</strong></div>
        <div><span>شماره پرسنلی</span><strong>@r.PersonnelNumberSnapshot</strong></div>
        <div><span>واحد سازمانی</span><strong>@r.OrganizationUnitSnapshot</strong></div>
        <div><span>سمت / پست سازمانی</span><strong>@r.PositionTitleSnapshot</strong></div>
        <div><span>تاریخ پایان قرارداد قبلی</span><strong>@faDate(r.PreviousContractEndDate)</strong></div>
        <div><span>سوابق تمدید سه دوره گذشته (ماه)</span><strong>@r.PreviousExtensionMonths1 / @r.PreviousExtensionMonths2 / @r.PreviousExtensionMonths3</strong></div>
        <div><span>اخطار کتبی انضباطی</span><strong>@(r.HasDisciplinaryWarnings ? $"بله، {r.DisciplinaryWarningCount} نوبت" : "خیر")</strong></div>
        <div><span>مصوبه کمیته انضباطی</span><strong>@(r.HasDisciplinaryCommitteeResolution ? $"بله، {r.DisciplinaryCommitteeResolutionCount} مورد" : "خیر")</strong></div>
        <div><span>مرخصی بدون حقوق</span><strong>@(r.HasUnpaidLeave ? $"{r.UnpaidLeaveDays} روز" : "ندارد")</strong></div>
        <div><span>مرخصی بیماری</span><strong>@(r.HasSickLeave ? $"{r.SickLeaveDays} روز" : "ندارد")</strong></div>
        <div><span>مرخصی حادثه</span><strong>@(r.HasAccidentLeave ? $"{r.AccidentLeaveDays} روز" : "ندارد")</strong></div>
        <div><span>سوابق تشویق</span><strong>@(r.HasCommendations ? $"{r.CommendationCount} نوبت" : "ندارد")</strong></div>
        <div><span>امتیاز آخرین دوره پیشین</span><strong>@score(r.PreviousPeriodScore1)@(r.PreviousPeriodScore1FromHistory ? " (سامانه)" : " (ورود دستی)")</strong></div>
        <div><span>امتیاز دوره قبل از آن</span><strong>@score(r.PreviousPeriodScore2)@(r.PreviousPeriodScore2FromHistory ? " (سامانه)" : " (ورود دستی)")</strong></div>
    </div>
</section>

@if (Model.StageKind == "IntakeApproval" && !Model.IsReadOnly)
{
    <section class="card">
        <div class="section-head">
            <div><h3>بررسی اطلاعات اولیه درخواست</h3><span class="muted">در صورت تأیید، درخواست وارد زنجیره ارزشیابی عملکرد می‌شود؛ در صورت برگشت، برای اصلاح به ثبت‌کننده ارسال خواهد شد.</span></div>
        </div>
        <form method="post" action="/ContractRenewalTask/Submit" class="form-stack">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Task.Id" />
            <input type="hidden" name="action" value="Approve" />
            <button class="btn btn-main" type="submit">تأیید اطلاعات و ارجاع به ارزشیابی</button>
        </form>
        <form method="post" action="/ContractRenewalTask/Submit" class="form-stack" style="margin-top:1rem">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Task.Id" />
            <input type="hidden" name="action" value="Return" />
            <label>توضیحات و موارد لازم برای اصلاح *
                <textarea name="comment" rows="4" maxlength="2000" required placeholder="مواردی را که ثبت‌کننده باید اصلاح یا تکمیل کند، مشخص کنید."></textarea>
            </label>
            <button class="btn btn-outline" type="submit">برگشت به ثبت‌کننده برای اصلاح</button>
        </form>
    </section>
}

@if (Model.StageKind == "RequesterEdit" && !Model.IsReadOnly && Model.ReturnedEdit is not null)
{
    var edit = Model.ReturnedEdit;
    string editScore(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    <section class="card">
        <div class="section-head"><div><h3>اصلاح اطلاعات اولیه درخواست</h3><span class="muted">درخواست برای اصلاح به حساب ثبت‌کننده بازگشته است. پس از ذخیره، دوباره برای تأیید به جایگاه سازمانی ارسال می‌شود.</span></div></div>
        @if (!string.IsNullOrWhiteSpace(Model.ReturnComment))
        {
            <div class="note"><strong>علت برگشت و موارد اصلاحی:</strong> @Model.ReturnComment</div>
        }
        <div class="note">کارمند موضوع درخواست: <strong>@r.EmployeeNameSnapshot</strong> — شماره پرسنلی @r.PersonnelNumberSnapshot. کارمند انتخاب‌شده قابل تغییر نیست.</div>
        <form method="post" action="/ContractRenewalTask/SaveReturnedRequest" class="form-stack">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Task.Id" />
            <div class="grid-3">
                <label>مدت تمدید دوره قبلی اول (ماه) *
                    <input name="PreviousExtensionMonths1" type="number" min="0" max="120" required value="@edit.PreviousExtensionMonths1" />
                </label>
                <label>مدت تمدید دوره قبلی دوم (ماه) *
                    <input name="PreviousExtensionMonths2" type="number" min="0" max="120" required value="@edit.PreviousExtensionMonths2" />
                </label>
                <label>مدت تمدید دوره قبلی سوم (ماه) *
                    <input name="PreviousExtensionMonths3" type="number" min="0" max="120" required value="@edit.PreviousExtensionMonths3" />
                </label>
            </div>
            <h4>سوابق انضباطی و حضور</h4>
            <div class="grid-2">
                <label class="inline-check"><input type="checkbox" name="HasDisciplinaryWarnings" value="true" checked="@edit.HasDisciplinaryWarnings" /> سابقه اخطار کتبی دارد</label>
                <label>تعداد اخطارها
                    <input name="DisciplinaryWarningCount" type="number" min="0" max="100000" value="@edit.DisciplinaryWarningCount" />
                </label>
                <label class="inline-check"><input type="checkbox" name="HasDisciplinaryCommitteeResolution" value="true" checked="@edit.HasDisciplinaryCommitteeResolution" /> مصوبه کمیته انضباطی دارد</label>
                <label>تعداد مصوبه‌ها
                    <input name="DisciplinaryCommitteeResolutionCount" type="number" min="0" max="100000" value="@edit.DisciplinaryCommitteeResolutionCount" />
                </label>
            </div>
            <h4>سوابق مرخصی</h4>
            <div class="grid-3">
                <label class="inline-check"><input type="checkbox" name="HasUnpaidLeave" value="true" checked="@edit.HasUnpaidLeave" /> مرخصی بدون حقوق دارد</label>
                <label>روزهای مرخصی بدون حقوق
                    <input name="UnpaidLeaveDays" type="number" min="0" max="100000" value="@edit.UnpaidLeaveDays" />
                </label>
                <label class="inline-check"><input type="checkbox" name="HasSickLeave" value="true" checked="@edit.HasSickLeave" /> مرخصی بیماری دارد</label>
                <label>روزهای مرخصی بیماری
                    <input name="SickLeaveDays" type="number" min="0" max="100000" value="@edit.SickLeaveDays" />
                </label>
                <label class="inline-check"><input type="checkbox" name="HasAccidentLeave" value="true" checked="@edit.HasAccidentLeave" /> مرخصی حادثه دارد</label>
                <label>روزهای مرخصی حادثه
                    <input name="AccidentLeaveDays" type="number" min="0" max="100000" value="@edit.AccidentLeaveDays" />
                </label>
            </div>
            <h4>سوابق تشویق</h4>
            <div class="grid-2">
                <label class="inline-check"><input type="checkbox" name="HasCommendations" value="true" checked="@edit.HasCommendations" /> سابقه تشویق دارد</label>
                <label>تعداد تشویق‌ها
                    <input name="CommendationCount" type="number" min="0" max="100000" value="@edit.CommendationCount" />
                </label>
            </div>
            <h4>امتیاز دو دوره پیشین</h4>
            <div class="grid-2">
                <label>امتیاز آخرین دوره پیشین
                    @if (edit.PreviousPeriodScore1FromHistory)
                    {
                        <input type="number" value="@editScore(edit.PreviousPeriodScore1)" readonly />
                        <small class="muted">از سابقه سامانه خوانده شده و قابل تغییر نیست.</small>
                    }
                    else
                    {
                        <input name="PreviousPeriodScore1" type="number" min="0" max="100" step="0.01" required value="@editScore(edit.PreviousPeriodScore1)" />
                    }
                </label>
                <label>امتیاز دوره قبل از آن
                    @if (edit.PreviousPeriodScore2FromHistory)
                    {
                        <input type="number" value="@editScore(edit.PreviousPeriodScore2)" readonly />
                        <small class="muted">از سابقه سامانه خوانده شده و قابل تغییر نیست.</small>
                    }
                    else
                    {
                        <input name="PreviousPeriodScore2" type="number" min="0" max="100" step="0.01" required value="@editScore(edit.PreviousPeriodScore2)" />
                    }
                </label>
            </div>
            <div class="actions"><button class="btn btn-main" type="submit">ذخیره اصلاحات و ارسال مجدد برای تأیید</button></div>
        </form>
    </section>
}

@if (editingScores)
{
    <section class="card">
        <div class="section-head">
            <div><h3>امتیازهای مرحله قبلی</h3><span class="muted">فقط امتیازهای ارزیاب بلافاصله قبل از شما نمایش داده می‌شوند.</span></div>
            @if (Model.PreviousStageScoreTotal.HasValue) { <span class="badge">مجموع مرحله قبل: @score(Model.PreviousStageScoreTotal) از @score(Model.CurrentQuestionCeilingTotal)</span> }
        </div>
        @if (Model.PreviousStageScores.Count == 0)
        {
            <div class="empty">این نخستین مرحله ارزیابی در مسیر این کارمند است؛ مرحله قبلی برای نمایش وجود ندارد.</div>
        }
        else
        {
            <div class="table-wrap"><table>
                <thead><tr><th>پرسش</th><th>سقف امتیاز</th><th>امتیاز ارزیاب مرحله قبل</th></tr></thead>
                <tbody>
                @foreach (var s in Model.PreviousStageScores)
                {
                    <tr><td>@s.QuestionTextSnapshot</td><td>@score(s.MaxScoreSnapshot)</td><td>@score(s.Score)</td></tr>
                }
                </tbody>
            </table></div>
            @if (!string.IsNullOrWhiteSpace(Model.PreviousStageComment))
            {
                <div class="note"><strong>توضیحات ارزیاب مرحله قبل:</strong> @Model.PreviousStageComment</div>
            }
            @if (Model.CanConfirmPreviousStageScores)
            {
                <div class="note" style="margin-top:.75rem">
                    امتیازهای ارزیاب قبلی به‌عنوان مقدار پیش‌فرض در جدول امتیازدهی شما قرار گرفته‌اند. می‌توانید آن‌ها را بررسی و تغییر دهید یا عین همان امتیازها را یک‌جا تأیید کنید.
                </div>
                <form method="post" action="/ContractRenewalTask/ConfirmPreviousScores" class="actions"
                      onsubmit="return confirm('تمام امتیازهای مرحله قبل بدون تغییر به نام شما ثبت و درخواست به مرحله بعد ارجاع شود؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Task.Id" />
                    <button class="btn btn-outline" type="submit">تأیید عین امتیازهای مرحله قبل</button>
                </form>
            }
        }
    </section>

    <section class="card">
        <div class="section-head"><div><h3>@(Model.IsReadOnly ? "امتیازهای ثبت‌شده این مرحله" : "امتیازدهی شما")</h3><span class="muted">برای هر پرسش امتیازی بین صفر و سقف امتیاز ثبت شده است. مجموع سقف پرسش‌ها ۱۰۰ است.</span></div><span class="badge">@(Model.IsReadOnly ? "سابقه ثبت‌شده" : "مرحله جاری")</span></div>
        <form method="post" action="/ContractRenewalTask/Submit" class="form-stack" id="contractEvaluationScoreForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Task.Id" />
            <div class="contract-score-live-summary" aria-live="polite">
                <div><span>امتیاز نهایی (جمع امتیازهای این مرحله)</span><strong id="contractScoreTotalTop">@score(currentScoreTotal)</strong></div>
                <small>جمع امتیاز پرسش‌ها به‌صورت لحظه‌ای محاسبه می‌شود.</small>
            </div>
            <div class="table-wrap"><table>
                <thead><tr><th>پرسش</th><th>راهنمای امتیازدهی</th><th>سقف امتیاز</th><th>امتیاز شما</th></tr></thead>
                <tbody>
                @foreach (var s in Model.CurrentScores)
                {
                    <tr>
                        <td>@s.QuestionTextSnapshot</td>
                        <td class="contract-score-guidance">@s.ScoringGuidanceSnapshot</td>
                        <td>@score(s.MaxScoreSnapshot)</td>
                        <td>
                            <input class="contract-score-input" type="number" inputmode="numeric" autocomplete="off" name="scores[@s.Id]" min="0" max="@score(s.MaxScoreSnapshot)" data-max-score="@score(s.MaxScoreSnapshot)" data-score-id="@s.Id" step="1" required value="@(s.Score.HasValue ? score(s.Score) : "")" aria-describedby="scoreError-@s.Id" disabled="@(Model.IsReadOnly)" />
                            <small class="contract-score-error" id="scoreError-@s.Id" aria-live="polite"></small>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><th colspan="2">مجموع سقف امتیاز</th><th>@score(Model.CurrentQuestionCeilingTotal)</th><th><span>امتیاز نهایی:</span> <strong id="contractScoreTotalBottom">@score(currentScoreTotal)</strong></th></tr></tfoot>
            </table></div>
            <label>توضیحات کلی این مرحله (مستقل از پرسش‌ها)
                <textarea name="comment" rows="4" maxlength="2000" disabled="@(Model.IsReadOnly)" placeholder="توضیح کلی درباره عملکرد کارمند، مستندات یا ملاحظات مرتبط با امتیازدهی">@Model.Task.Comment</textarea>
            </label>
            @if (!Model.IsReadOnly) { <div class="actions"><button class="btn btn-main" type="submit">ثبت امتیازها و ارجاع به جایگاه بعدی</button></div> }
        </form>
    </section>
}

@if (viewingAllScores)
{
    <section class="card">
        <div class="section-head"><div><h3>نتایج کامل ارزشیابی سازمانی</h3><span class="muted">اطلاعات ارزیاب‌ها فقط خواندنی است؛ امتیاز نهایی برابر امتیاز آخرین جایگاه پیش از مدیرعامل است.</span></div></div>
        @if (Model.AllScoreStages.Count == 0)
        {
            <div class="empty">هنوز نتایج مرحله‌ای برای نمایش وجود ندارد.</div>
        }
        else
        {
            @foreach (var stage in Model.AllScoreStages)
            {
                <div class="contract-score-stage">
                    <div class="section-head"><h4>@stage.StageTitle</h4><span class="badge">مجموع: @score(stage.ScoreTotal) از ۱۰۰</span></div>
                    <div class="table-wrap"><table>
                        <thead><tr><th>پرسش</th><th>سقف</th><th>امتیاز</th></tr></thead>
                        <tbody>@foreach (var s in stage.Scores) { <tr><td>@s.QuestionTextSnapshot</td><td>@score(s.MaxScoreSnapshot)</td><td>@score(s.Score)</td></tr> }</tbody>
                    </table></div>
                    @if (!string.IsNullOrWhiteSpace(stage.Comment))
                    {
                        <div class="note"><strong>توضیحات این مرحله:</strong> @stage.Comment</div>
                    }
                </div>
            }
        }
    </section>
}

@if (Model.IsReadOnly && Model.StageKind == "Security")
{
    <section class="card">
        <div class="section-head"><h3>سابقه تصمیم حراست</h3><span class="badge">ثبت‌شده</span></div>
        <div class="contract-preview-grid">
            <div><span>تصمیم</span><strong>@securityDecisionTitle(r.SecurityDecision)</strong></div>
            <div><span>توضیحات حراست</span><strong>@(string.IsNullOrWhiteSpace(r.SecurityComment) ? "توضیحی ثبت نشده است." : r.SecurityComment)</strong></div>
        </div>
    </section>
}
@if (Model.IsReadOnly && Model.StageKind == "HumanResources")
{
    <section class="card">
        <div class="section-head"><h3>سابقه پیشنهاد منابع انسانی</h3><span class="badge">ثبت‌شده</span></div>
        <div class="contract-preview-grid">
            <div><span>مدت پیشنهادی قرارداد</span><strong>@(r.HrProposedContractMonths?.ToString() ?? "ثبت نشده") ماه</strong></div>
            <div><span>توضیحات</span><strong>@(string.IsNullOrWhiteSpace(r.HrComment) ? "توضیحی ثبت نشده است." : r.HrComment)</strong></div>
        </div>
    </section>
}
@if (Model.IsReadOnly && Model.StageKind == "CEO")
{
    <section class="card">
        <div class="section-head"><h3>سابقه تصمیم نهایی مدیرعامل</h3><span class="badge">ثبت‌شده</span></div>
        <div class="contract-preview-grid">
            <div><span>مدت نهایی قرارداد</span><strong>@(r.FinalContractMonths?.ToString() ?? "ثبت نشده") ماه</strong></div>
