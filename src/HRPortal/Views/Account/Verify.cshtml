@{Layout=null;}<html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>تایید کد</title><link rel="stylesheet" href="~/css/site.css"></head><body class="login-page"><div class="login-card"><div class="brand">پورتال جامع منابع انسانی</div><h2>تایید کد ورود</h2><p>کد پنج رقمی ارسال‌شده را وارد کنید.</p>@if(TempData["DebugOtp"]!=null){<div class="alert success">کد آزمایشی محیط توسعه: <strong>@TempData["DebugOtp"]</strong></div>}@if(TempData["OtpError"]!=null){<div class="alert error">@TempData["OtpError"]</div>}<form method="post">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"><label>کد ورود<input name="code" inputmode="numeric" maxlength="5" autofocus></label><button class="btn btn-main">ورود</button></form><a class="back-link" href="/Account/Login">بازگشت</a></div></body></html>