@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ورود کارکنان از اکسل";
}
<div class="page-head"><div><h1>ورود کارکنان از اکسل</h1><p>ستون‌های اجباری: شماره پرسنلی، شناسه، کد ملی، نام، نام خانوادگی، موبایل، جنسیت. کد واحد/اداره/بخش اختیاری است. قالب فایل استاندارد را از همین صفحه دریافت کنید.</p></div><a class="btn btn-outline" href="/Employees">بازگشت</a></div>
@if(ViewBag.Success!=null){<div class="alert success">@ViewBag.Success</div>}
@if(ViewBag.Errors is IEnumerable<string> es && es.Any()){<div class="alert error"><strong>خطاها:</strong><ul>@foreach(var x in es){<li>@x</li>}</ul></div>}
<div class="card">
    <div class="section-head"><div><h3>فایل Excel</h3><span class="muted">از قالب استاندارد استفاده کنید.</span></div><a class="btn btn-outline" href="/Employees/Template">دانلود قالب استاندارد اکسل</a></div>
    <form method="post" enctype="multipart/form-data" class="filterbar">
        @Html.AntiForgeryToken()
        <input type="file" name="file" accept=".xlsx,.xls" required />
        <button class="btn btn-main" type="submit">بارگذاری و پردازش</button>
    </form>
</div>