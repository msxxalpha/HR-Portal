@model List<HRPortal.Models.SystemFormDefinition>
@{
    var codeManagedFormCodes = ViewBag.CodeManagedFormCodes as HashSet<string> ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "مدیریت فرم‌ها";
}
<div class="page-head">
    <div><h1>مدیریت فرم‌ها</h1><p>فهرست فرم‌های عملیاتی که از طریق پیاده‌سازی کدنویسی‌شده در سامانه شناسایی و ثبت شده‌اند.</p></div>
</div>
@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
<section class="card">
    <div class="section-head"><div><h3>فرم‌های شناسایی‌شده</h3><span class="muted">این فهرست به‌صورت خودکار از قرارداد فرم‌های پیاده‌سازی‌شده در کد سامانه همگام می‌شود.</span></div></div>
    @if (Model.Count == 0)
    {
        <div class="empty">هنوز فرم عملیاتی قابل ثبت در سامانه شناسایی نشده است.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>کد سیستمی</th><th>عنوان فرم</th><th>نوع اجرا</th><th>وضعیت</th><th>قابلیت گردش کار</th><th>توضیحات</th><th>عملیات</th></tr></thead>
                <tbody>
                @foreach (var form in Model)
                {
                    <tr>
                        <td><code>@form.Code</code></td>
                        <td><strong>@form.Title</strong></td>
                        <td>@(form.ImplementationType == "Custom" ? "اختصاصی و مستقل" : form.ImplementationType == "GenericWorkflow" ? "فرم اختصاصی متصل به موتور عمومی" : "مستقل")</td>
                        <td><span class="badge">@(form.IsActive ? "فعال" : "غیرفعال")</span></td>
                        <td>@(form.IsActive && form.ImplementationType == "GenericWorkflow" ? "قابل انتخاب در مدیریت گردش کار" : "ندارد")</td>
                        <td>@(string.IsNullOrWhiteSpace(form.Description) ? "—" : form.Description)</td>
                        <td>
                            @if (form.ImplementationType != "Custom" && !codeManagedFormCodes.Contains(form.Code))
                            {
                                <form asp-action="Delete" method="post" onsubmit="return confirm('فرم «@form.Title» حذف شود؟ این عملیات قابل بازگشت نیست.');" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@form.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted">سیستمی</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <div class="note" style="margin-top:1rem">
        <strong>نحوه افزودن فرم جدید:</strong>
        فرم‌ها مانند سایر بخش‌های سامانه به‌صورت اختصاصی کدنویسی می‌شوند. هنگام پیاده‌سازی، قرارداد مشترک اتصال به گردش کار را پیاده‌سازی می‌کنند و مشخصات آن‌ها در اجرای سامانه به‌طور خودکار در این فهرست قرار می‌گیرد. در این بخش نیازی به ساخت فرم، ورود دستی کد یا ثبت دستی مشخصات نیست.
    </div>
</section>
