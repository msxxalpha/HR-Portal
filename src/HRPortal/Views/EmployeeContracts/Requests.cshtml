@model List<HRPortal.Models.ContractRenewalRequestListItem>
@using HRPortal.Services
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "فهرست درخواست‌های ارزشیابی و تمدید قرارداد";
    string score(decimal? value) => value.HasValue ? value.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "—";
}
<div class="page-head">
    <div>
        <h1>فهرست درخواست‌های ارزشیابی و تمدید قرارداد</h1>
        <p>آخرین وضعیت هر درخواست، مرحله جاری و عملیات مجاز بر اساس سابقه ارزیابی</p>
    </div>
    <div class="actions">
        <a class="btn btn-outline" href="/EmployeeContracts">بازگشت به مدیریت قراردادهای کارکنان</a>
        <a class="btn btn-main" href="/EmployeeContracts/Renewal">ثبت درخواست جدید</a>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }

<section class="card">
    <div class="section-head">
        <div><h3>درخواست‌های ثبت‌شده</h3><span class="muted">@Model.Count درخواست در فهرست</span></div>
        <input id="contractRequestSearch" type="search" placeholder="جست‌وجو با کد درخواست، نام یا شماره پرسنلی" aria-label="جست‌وجوی درخواست‌ها" />
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty">درخواستی برای نمایش ثبت نشده است.</div>
    }
    else
    {
        <div class="table-wrap">
            <table id="contractRequestsTable">
                <thead>
                    <tr>
                        <th>کد درخواست</th><th>کارمند</th><th>شماره پرسنلی</th><th>تاریخ ثبت</th>
                        <th>آخرین وضعیت</th><th>مرحله جاری / وضعیت گردش</th><th>امتیاز نهایی</th><th>مدت نهایی</th><th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model)
                {
                    var r = row.Request;
                    <tr data-search="@($"{r.RequestCode} {r.EmployeeNameSnapshot} {r.PersonnelNumberSnapshot}".ToLowerInvariant())">
                        <td>@r.RequestCode</td>
                        <td>@r.EmployeeNameSnapshot</td>
                        <td>@r.PersonnelNumberSnapshot</td>
                        <td>@PersianDateService.Format(r.CreatedAt)</td>
                        <td><span class="contract-request-status">@row.LastStatus</span></td>
                        <td>@row.CurrentStageTitle</td>
                        <td>@score(r.FinalEvaluationScore)</td>
                        <td>@(r.FinalContractMonths.HasValue ? $"{r.FinalContractMonths.Value} ماه" : "—")</td>
                        <td>
                            <div class="contract-row-actions">
                                <a class="btn btn-outline btn-sm" href="/EmployeeContracts/History?id=@r.Id">سوابق</a>
                                @if (row.CanEditOrDelete)
                                {
                                    <a class="btn btn-outline btn-sm" href="/EmployeeContracts/Edit?id=@r.Id">ویرایش</a>
                                    <form method="post" action="/EmployeeContracts/DeleteRequest" onsubmit="return confirm('درخواست از فهرست فعال حذف نرم شود؟ سوابق و تاریخچه در سامانه باقی می‌ماند.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button class="btn btn-outline btn-sm danger" type="submit">حذف</button>
                                    </form>
                                }
                                @if (row.CanStop)
                                {
                                    <form method="post" action="/EmployeeContracts/StopRequest" onsubmit="return confirm('گردش این درخواست متوقف شود؟ امتیازها و تاریخچه حفظ می‌شوند.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <input type="hidden" name="reason" value="توقف توسط کاربر مجاز از فهرست درخواست‌ها" />
                                        <button class="btn btn-outline btn-sm danger" type="submit">توقف</button>
                                    </form>
                                }
                                @if (!row.CanEditOrDelete && !row.CanStop)
                                {
                                    <span class="muted">بدون عملیات — سوابق حفظ شده</span>
                                }
                            </div>
                            @if (row.HasAnyEvaluation && row.CanStop)
                            {
                                <small class="muted">ویرایش و حذف غیرفعال است؛ حداقل یک مرحله ارزیابی ثبت شده.</small>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
<script>
(function () {
    const input = document.getElementById("contractRequestSearch");
    const rows = Array.from(document.querySelectorAll("#contractRequestsTable tbody tr"));
    input?.addEventListener("input", function () {
        const q = (input.value || "").trim().toLocaleLowerCase();
        rows.forEach(function (row) {
            row.hidden = q.length > 0 && !(row.dataset.search || "").includes(q);
        });
    });
})();
</script>
}
