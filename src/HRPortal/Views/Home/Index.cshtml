@inject HRPortal.Services.AnnouncementService AnnouncementService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "داشبورد";
    var isAdmin = User.HasClaim("IsAdmin", "1");
    // Hide the muted portal-name caption in the shared top bar for non-admin users on this dashboard only.
    ViewData["HidePortalCaption"] = !isAdmin;
    var canCreateEmployee = isAdmin || User.HasClaim("Permission", "Employees.Create");
    var canViewEmployees = isAdmin || User.HasClaim("Permission", "Employees.View");
    var canViewOrg = isAdmin || User.HasClaim("Permission", "Organization.View");
    var canViewPayroll = isAdmin || User.HasClaim("Permission", "Payroll.View");
    var canViewSettings = isAdmin || User.HasClaim("Permission", "Settings.View");

}

@{
    var activeAnnouncements = ViewBag.Announcements as List<HRPortal.Models.Announcement> ?? [];
    var canViewWorkflowDashboard = (bool?)ViewBag.CanViewWorkflowDashboard ?? false;
    var dashboardCurrentTasks = ViewBag.WorkflowCurrentTasks as List<HRPortal.Models.WorkflowInboxRow> ?? [];
    var dashboardUpcomingTasks = ViewBag.WorkflowUpcomingTasks as List<HRPortal.Models.WorkflowInboxRow> ?? [];
    var dashboardCurrentTaskCount = (int?)ViewBag.WorkflowCurrentTaskCount ?? 0;
    var dashboardUpcomingTaskCount = (int?)ViewBag.WorkflowUpcomingTaskCount ?? 0;
    var dashboardRequests = ViewBag.DashboardRequests as List<HRPortal.Models.WorkflowInboxRow> ?? [];
    var dashboardRequestCount = (int?)ViewBag.DashboardRequestCount ?? 0;
}
@if (!isAdmin && !((bool?)ViewBag.HasPersonalPassword ?? true))
{
    <div class="alert warning" style="margin-bottom:16px;">
        <strong>رمز عبور شخصی خود را تعیین کنید.</strong>
        <div>برای ورودهای بعدی می‌توانید علاوه بر رمز یکبارمصرف، با نام کاربری و رمز شخصی نیز وارد سامانه شوید.</div>
        <a class="btn btn-main btn-sm" href="/Account/PersonalPassword" style="margin-top:10px;">تنظیم رمز شخصی</a>
    </div>
}

@await Html.PartialAsync("_AnnouncementsDashboard", activeAnnouncements)

@if (isAdmin)
{
    <div class="hero">
        <div>
            <div class="eyebrow">سامانه یکپارچه منابع انسانی</div>
            <h1>پورتال جامع منابع انسانی</h1>
            <p>مدیریت اطلاعات کارکنان، ساختار سازمانی و خدمات پرسنلی در یک محیط یکپارچه.</p>
        </div>
        @if (canCreateEmployee) { <a class="btn btn-main btn-hero" href="/Employees/Create">ثبت کارمند جدید</a> }
    </div>
}

@if (!isAdmin)
{
    <div class="employee-home-tiles">
        <a class="performance-quick-tile" href="/MonthlyPerformance/Mine">
            <span class="performance-tile-icon">▦</span>
            <span class="performance-tile-eyebrow">دسترسی سریع</span>
            <strong>داشبورد شخصی ارزیابی عملکرد</strong>
            <p>امتیازات دوره‌های ارزیابی، روند رشد، نقاط قوت و زمینه‌های قابل بهبود خود را مشاهده کنید.</p>
            <span class="performance-tile-cta">ورود به داشبورد شخصی ←</span>
        </a>
    </div>
}
@if (isAdmin)
{
<div class="stats">
    <div class="stat"><span>کل کارکنان</span><strong>@ViewBag.EmployeeCount</strong></div>
    <div class="stat"><span>کارکنان فعال</span><strong>@ViewBag.ActiveEmployeeCount</strong></div>
    <div class="stat"><span>نسخه‌های نهایی ساختار</span><strong>@ViewBag.RevisionCount</strong></div>
</div>
}

@if (canViewWorkflowDashboard)
{
    <section class="workflow-dashboard">
        <div class="workflow-dashboard-heading">
            <div>
                <span class="eyebrow">پیگیری گردش کار</span>
                <h2>کارتابل و درخواست‌ها</h2>
                <p>دسترسی سریع به کارهای منتظر اقدام و آخرین وضعیت درخواست‌ها</p>
            </div>
            <div class="workflow-dashboard-shortcuts">
                <a class="btn btn-outline" href="/Workflow/Inbox">ورود به کارتابل</a>
                <a class="btn btn-main" href="/Workflow/MyRequests">@(isAdmin ? "مدیریت درخواست‌ها" : "همه درخواست‌های من")</a>
            </div>
        </div>
        <div class="workflow-dashboard-grid">
            <section class="workflow-widget inbox-widget">
                <div class="workflow-widget-head">
                    <div class="workflow-widget-icon inbox-icon"><span>✓</span></div>
                    <div><h3>کارتابل من</h3><p>تفکیک وظایف قابل اقدام و مراحل آتی</p></div>
                </div>
                <div class="dashboard-inbox-tabs" role="tablist" aria-label="دسته‌بندی وظایف کارتابل داشبورد">
                    <button type="button" class="dashboard-inbox-tab active" role="tab" aria-selected="true" aria-controls="dashboardCurrentTasksPanel" data-dashboard-tab="dashboardCurrentTasksPanel">
                        وظایف جاری <span>@dashboardCurrentTaskCount</span>
                    </button>
                    <button type="button" class="dashboard-inbox-tab" role="tab" aria-selected="false" aria-controls="dashboardUpcomingTasksPanel" data-dashboard-tab="dashboardUpcomingTasksPanel">
                        وظایف آتی <span>@dashboardUpcomingTaskCount</span>
                    </button>
                </div>
                <div id="dashboardCurrentTasksPanel" class="dashboard-inbox-panel active" role="tabpanel">
                    @if (dashboardCurrentTasks.Count == 0)
                    {
                        <div class="workflow-empty"><span class="workflow-empty-mark">✓</span><strong>وظیفه جاری ندارید</strong><p>در حال حاضر موردی برای اقدام به شما ارجاع نشده است.</p></div>
                    }
                    else
                    {
                        <div class="workflow-widget-list">
                            @foreach (var item in dashboardCurrentTasks)
                            {
                                <article class="workflow-list-item">
                                    <div class="workflow-list-main">
                                        <strong>@item.WorkflowTitle</strong>
                                        <span>@item.StepTitle · @item.RequesterName</span>
                                        <small>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small>
                                    </div>
                                    <a class="workflow-open-link" href="/Workflow/Task/@item.TaskId" aria-label="مشاهده و اقدام">مشاهده و اقدام <span>←</span></a>
                                </article>
                            }
                        </div>
                    }
                    <a class="workflow-widget-footer" href="/Workflow/Inbox">مشاهده همه وظایف جاری <span>←</span></a>
                </div>
                <div id="dashboardUpcomingTasksPanel" class="dashboard-inbox-panel" role="tabpanel" hidden>
                    @if (dashboardUpcomingTasks.Count == 0)
                    {
                        <div class="workflow-empty"><span class="workflow-empty-mark">◷</span><strong>وظیفه آتی ندارید</strong><p>در حال حاضر مرحله آتی قابل‌شناسایی برای شما وجود ندارد.</p></div>
                    }
                    else
                    {
                        <div class="workflow-widget-list">
                            @foreach (var item in dashboardUpcomingTasks)
                            {
                                <article class="workflow-list-item dashboard-upcoming-item">
                                    <div class="workflow-list-main">
                                        <strong>@item.WorkflowTitle</strong>
                                        <span>@item.StepTitle · @item.RequesterName</span>
                                        <small>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm") · هنوز نوبت اقدام نیست</small>
                                    </div>
                                    @if (isAdmin || User.HasClaim("Permission", "Workflow.ViewOnly"))
                                    {
                                        <a class="workflow-open-link" href="/Workflow/Details/@item.WorkflowInstanceId" aria-label="مشاهده فقط">مشاهده فقط <span>←</span></a>
                                    }
                                    else
                                    {
                                        <span class="workflow-upcoming-label">صرفاً جهت اطلاع</span>
                                    }
                                </article>
                            }
                        </div>
                    }
                    <a class="workflow-widget-footer" href="/Workflow/Inbox">مشاهده همه وظایف آتی <span>←</span></a>
                </div>
            </section>
            <section class="workflow-widget requests-widget">
                <div class="workflow-widget-head">
                    <div class="workflow-widget-icon requests-icon"><span>↗</span></div>
                    <div><h3>@(isAdmin ? "درخواست‌های سامانه" : "درخواست‌های من")</h3><p>@(isAdmin ? "آخرین درخواست‌های ثبت‌شده در سامانه" : "پیگیری درخواست‌های ارسال‌شده توسط شما")</p></div>
                    <span class="workflow-widget-count">@dashboardRequestCount</span>
                </div>
                @if (dashboardRequests.Count == 0)
                {
                    <div class="workflow-empty"><span class="workflow-empty-mark">↗</span><strong>درخواستی برای نمایش وجود ندارد</strong><p>درخواست‌های گردش کار پس از ثبت در این بخش قابل پیگیری هستند.</p></div>
                }
                else
                {
                    <div class="workflow-widget-list">
                        @foreach (var item in dashboardRequests)
                        {
                            var statusTitle = item.Status switch
                            {
                                "Approved" => "تأیید نهایی",
                                "Completed" => "پایان‌یافته",
                                "CompletedBySkip" => "پایان با عبور از مرحله",
                                "Rejected" => "رد شده",
                                "Returned" => "برگشت داده شده",
                                "Stopped" => "متوقف شده",
                                "Deleted" => "حذف شده",
                                "Cancelled" => "لغو شده",
                                _ => "در حال گردش"
                            };
                            var statusClass = item.Status switch
                            {
                                "Approved" or "Completed" => "done",
                                "CompletedBySkip" => "skipped",
                                "Rejected" => "rejected",
                                "Returned" => "returned",
                                "Stopped" => "stopped",
                                "Deleted" => "deleted",
                                "Cancelled" => "cancelled",
                                _ => "pending"
                            };
                            <article class="workflow-list-item">
                                <div class="workflow-list-main">
                                    <strong>@item.WorkflowTitle</strong>
                                    <span>@(isAdmin ? item.RequesterName : item.EntityType + " #" + item.EntityId) · @item.StepTitle</span>
                                    <small>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small>
                                </div>
                                <div class="workflow-list-actions">
                                    <span class="workflow-status @statusClass">@statusTitle</span>
                                    <a class="workflow-open-link" href="/Workflow/Details/@item.WorkflowInstanceId" aria-label="مشاهده درخواست">جزئیات <span>←</span></a>
                                </div>
                            </article>
                        }
                    </div>
                }
                <a class="workflow-widget-footer" href="/Workflow/MyRequests">@(isAdmin ? "مدیریت همه درخواست‌ها" : "مشاهده همه درخواست‌های من") <span>←</span></a>
            </section>
        </div>
    </section>
}

@if ((bool?)ViewBag.CanViewSuggestionReports == true)
{
    <section class="home-suggestion-summary">
        <div class="home-suggestion-heading">
            <div><span class="eyebrow">نظام پیشنهادات کارکنان</span><h2>نمای کلی پیشنهادها</h2><p>وضعیت ثبت و پیگیری ایده‌های بهبود در سامانه</p></div>
            <a class="btn btn-outline" href="/SuggestionsReports">مشاهده داشبورد و گزارش‌ها</a>
        </div>
        <div class="home-suggestion-kpis">
            <div><span>کل پیشنهادها</span><strong>@ViewBag.SuggestionTotalCount</strong></div>
            <div><span>پیش‌نویس</span><strong>@ViewBag.SuggestionDraftCount</strong></div>
            <div><span>ثبت و ارسال‌شده</span><strong>@ViewBag.SuggestionSubmittedCount</strong></div>
            <div><span>وضعیت‌های پس از ثبت</span><strong>@ViewBag.SuggestionInEvaluationCount</strong></div>
        </div>
    </section>
}

<script>
(function () {
    document.querySelectorAll(".dashboard-inbox-tabs").forEach(tabList => {
        const tabs = [...tabList.querySelectorAll(".dashboard-inbox-tab")];
        tabs.forEach(tab => tab.addEventListener("click", () => {
            tabs.forEach(item => {
                const active = item === tab;
                item.classList.toggle("active", active);
                item.setAttribute("aria-selected", active ? "true" : "false");
                const panel = document.getElementById(item.dataset.dashboardTab);
                if (panel) {
                    panel.hidden = !active;
                    panel.classList.toggle("active", active);
                }
            });
        }));
    });
})();
</script>

<div class="module-grid">
    @if (canViewEmployees) { <a class="module" href="/Employees"><b>01</b><h3>مدیریت کارکنان</h3><p>ثبت، ویرایش، غیرفعال‌سازی، جستجو، فیلتر و تبادل Excel.</p></a> }
    @if (canViewOrg) { <a class="module" href="/Organization"><b>02</b><h3>ساختار سازمانی</h3><p>ساختار درختی، بازنگری، نسخه‌بندی و تاریخچه تغییرات.</p></a> }
    @if (canViewPayroll) { <a class="module" href="/Payroll/Payslip"><b>03</b><h3>فیش حقوقی</h3><p>نمایش فیش حقوقی بر اساس ماه و شماره پرسنلی حساب کاربر.</p></a> }
    @if (canViewSettings) { <a class="module" href="/SystemSettings"><b>04</b><h3>تنظیمات محیط سامانه</h3><p>تنظیمات عمومی، ظاهر، OTP، پیامک و SSRS.</p></a> }
    @if (isAdmin || User.HasClaim("Permission", "Suggestions.Submit") || User.HasClaim("Permission", "Suggestions.ViewAll") || User.HasClaim("Permission", "Suggestions.Manage")) { <a class="module" href="/Suggestions"><b>05</b><h3>نظام پیشنهادات</h3><p>ثبت، پیگیری، مدیریت و گزارش ایده‌های بهبود سازمانی.</p></a> }
</div>
<style>
.employee-home-tiles{display:grid;grid-template-columns:minmax(0,1fr);align-items:stretch;gap:18px;margin:20px 0}
.employee-announcements-empty{background:#fff;border:1px solid #e2e8f0;padding:22px;border-radius:16px;height:100%}
.performance-quick-tile{display:flex;flex-direction:column;gap:15px;justify-content:center;min-height:240px;
border-radius:18px;padding:26px;text-decoration:none;background:linear-gradient(135deg,#133254,#1a6681);
color:#fff;box-shadow:0 10px 24px #0f27472b}
.performance-quick-tile strong{font-size:1.35rem;color:#fff;line-height:1.65}
.performance-quick-tile p{font-size:.9rem;color:#daebf4;line-height:1.95;margin:0}
.performance-tile-icon{font-size:2.4rem;opacity:.8}
.performance-tile-eyebrow{font-size:.82rem;color:#9bdbe3}
.performance-tile-cta{margin-top:8px;border-radius:8px;background:#ffffff1f;padding:12px;font-weight:700}
.performance-quick-tile:hover{filter:brightness(1.06);color:#fff}
.dashboard-inbox-tabs{display:flex;gap:6px;border-bottom:1px solid #dbe3ec;margin:8px 0 12px;flex-wrap:wrap}
.dashboard-inbox-tab{border:0;border-bottom:3px solid transparent;background:transparent;padding:9px 12px;color:#526174;font:inherit;font-weight:800;cursor:pointer}
.dashboard-inbox-tab.active{color:#173b60;border-bottom-color:#173b60}
.dashboard-inbox-tab span{display:inline-flex;min-width:22px;justify-content:center;margin-right:5px;padding:1px 7px;border-radius:20px;background:#edf2f7;font-size:.78rem}
.dashboard-inbox-tab:focus-visible{outline:2px solid #93c5fd;outline-offset:2px}
.dashboard-inbox-panel[hidden]{display:none!important}
.dashboard-upcoming-item{background:#fbfcfe}
.workflow-upcoming-label{font-size:.78rem;color:#9a3412;white-space:nowrap}
@@media(max-width:880px){.employee-home-tiles{grid-template-columns:1fr}}
@@media(max-width:560px){.dashboard-inbox-tab{padding:8px 9px}.workflow-list-item{gap:8px}.workflow-upcoming-label{white-space:normal}}
</style>
