@model HRPortal.Models.OrganizationNode
<div class="tree-node"><div class="node-main"><span class="rank">@Model.RankType</span><strong>@Model.Title</strong><small>@Model.Code</small></div><details><summary>عملیات</summary><form method="post" action="/Organization/EditNode" class="mini-form grid-4">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><input name="code" value="@Model.Code"><input name="title" value="@Model.Title"><select name="rankType"><option selected="@(Model.RankType=="مدیریت")">مدیریت</option><option selected="@(Model.RankType=="ریاست")">ریاست</option><option selected="@(Model.RankType=="سرپرستی")">سرپرستی</option></select><input name="sortOrder" type="number" value="@Model.SortOrder"><button class="btn btn-outline">ذخیره</button></form><form method="post" action="/Organization/DeleteNode">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="link danger">حذف</button></form><form method="post" action="/Organization/AddNode" class="mini-form">@Html.AntiForgeryToken()<input type="hidden" name="revisionId" value="@Model.OrganizationStructureRevisionId"><input type="hidden" name="parentId" value="@Model.Id"><input name="code" placeholder="کد زیرگره" required><input name="title" placeholder="عنوان زیرگره" required><select name="rankType"><option>مدیریت</option><option>ریاست</option><option>سرپرستی</option></select><button class="btn btn-outline">افزودن زیرگره</button></form></details>@if(Model.Children.Any()){<div class="children">@foreach(var child in Model.Children.OrderBy(x=>x.SortOrder).ThenBy(x=>x.Title)){<partial name="_Node" model="child"/>}</div>}</div>