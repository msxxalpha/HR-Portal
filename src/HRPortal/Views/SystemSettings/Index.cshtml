@model HRPortal.Models.SystemSettingsViewModel
@{ViewData["Title"]="تنظیمات محیط سامانه";}
<div class="page-head"><div><h1>تنظیمات محیط سامانه</h1><p>پیکربندی عمومی، ظاهر، امنیت، پیامک، فیش حقوقی و نگهداری</p></div><a class="btn btn-outline" asp-controller="Home" asp-action="Index">بازگشت</a></div>
@if(TempData["Success"]!=null){<div class="alert success">@TempData["Success"]</div>}
<form method="post" asp-action="Save">@Html.AntiForgeryToken()
<div class="tabs">
<button type="button" class="tab active" onclick="openTab(event,'t1')">عمومی</button><button type="button" class="tab" onclick="openTab(event,'t2')">ظاهر و برند</button><button type="button" class="tab" onclick="openTab(event,'t3')">امنیت و OTP</button><button type="button" class="tab" onclick="openTab(event,'t4')">پیامک</button><button type="button" class="tab" onclick="openTab(event,'t5')">فیش حقوقی</button><button type="button" class="tab" onclick="openTab(event,'t6')">نگهداری</button>
</div>
<div id="t1" class="tab-panel active"><div class="grid-3"><label>نام سامانه<input asp-for="System.ApplicationName"></label><label>نام سازمان<input asp-for="System.OrganizationName"></label><label>زبان<input asp-for="System.DefaultLanguage"></label><label>تقویم<select asp-for="System.Calendar"><option value="Persian">شمسی</option><option value="Gregorian">میلادی</option></select></label><label>منطقه زمانی<input asp-for="System.TimeZone"></label><label>رکورد در صفحه<input asp-for="System.ItemsPerPage" type="number"></label></div></div>
<div id="t2" class="tab-panel"><div class="grid-3"><label>تم<input asp-for="System.Theme"></label><label>رنگ اصلی<input asp-for="System.PrimaryColor" type="color"></label><label>رنگ ثانویه<input asp-for="System.SecondaryColor" type="color"></label><label class="wide">مسیر لوگو<input asp-for="System.LogoUrl"></label></div></div>
<div id="t3" class="tab-panel"><div class="grid-3"><label>طول OTP<input asp-for="Otp.Length" type="number"></label><label>اعتبار OTP (ثانیه)<input asp-for="Otp.ValiditySeconds" type="number"></label><label>حداکثر تلاش<input asp-for="Otp.MaxAttempts" type="number"></label></div><label class="switch"><input asp-for="Otp.Enabled"> فعال بودن ورود با OTP</label><label class="switch"><input asp-for="System.AllowUserSelfService"> فعال بودن خدمات کاربری</label><label class="switch"><input asp-for="System.EnableAuditLog"> ثبت رویدادهای سامانه</label></div>
<div id="t4" class="tab-panel"><div class="grid-2"><label>ارائه‌دهنده<input asp-for="Sms.ProviderName"></label><label>آدرس سرویس<input asp-for="Sms.ServiceUrl"></label><label>نام کاربری سرویس<input asp-for="Sms.Username"></label><label>رمز/کلید سرویس<input asp-for="Sms.Password" type="password"></label><label>شماره ارسال‌کننده<input asp-for="Sms.SenderNumber"></label><label>API Key<input asp-for="Sms.ApiKey" type="password"></label><label class="wide">متن OTP<input asp-for="Sms.OtpTemplate"></label></div><label class="switch"><input asp-for="Sms.Enabled"> فعال بودن ارسال پیامک</label></div>
<div id="t5" class="tab-panel"><div class="grid-2"><label>آدرس Report Server<input asp-for="Payroll.ReportServerUrl"></label><label>مسیر گزارش RDL<input asp-for="Payroll.ReportPath"></label><label>پارامتر سال/ماه<input asp-for="Payroll.YearParameter"></label><label>پارامتر شماره پرسنلی<input asp-for="Payroll.PersonnelParameter"></label><label>فرمت گزارش<input asp-for="Payroll.ReportFormat"></label></div><label class="switch"><input asp-for="Payroll.Enabled"> فعال بودن فیش حقوقی</label><label class="switch"><input asp-for="Payroll.UseIntegratedSecurity"> استفاده از احراز هویت یکپارچه SSRS</label></div>
<div id="t6" class="tab-panel"><label class="switch"><input asp-for="System.MaintenanceMode"> فعال کردن حالت تعمیر و نگهداری</label><label>پیام نگهداری<textarea asp-for="System.MaintenanceMessage"></textarea></label><div class="note">اطلاعات محرمانه سرویس پیامک را در مخزن Git قرار ندهید؛ مقادیر واقعی فقط در محیط اجرا وارد شوند.</div></div>
<div class="form-actions"><button class="btn btn-main">ذخیره همه تنظیمات</button></div>
</form>
@section Scripts{<script>function openTab(e,id){document.querySelectorAll('.tab-panel').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');e.currentTarget.classList.add('active')}</script>}