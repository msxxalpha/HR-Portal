@if (Model.StageKind == "HumanResources" && Model.IsHrDisciplinaryScoreDeductionEnabled && !Model.IsReadOnly)
{
<script>
(function () {
    const summary = document.getElementById("hrScoreSummary");
    const deduction = document.getElementById("disciplinaryDeductionPercent");
    const suggestion = document.getElementById("systemSuggestedMonths");
    const finalScoreDisplay = document.getElementById("liveFinalScore");
    const months = document.getElementById("hrContractMonths");
    if (!summary || !deduction || !suggestion || !finalScoreDisplay || !months) return;
    const original = Number(summary.dataset.originalScore || 0);
    const maxAllowedMonths = @Model.MaximumAllowedContractMonths;
    let monthsTouched = false;
    months.addEventListener("input", function () { monthsTouched = true; });
    function suggestedMonths(score) {
        if (score < 30) return 0;
        if (score <= 35) return 1;
        if (score <= 52) return 3;
        if (score <= 70) return 6;
        if (score <= 87) return 9;
        return 12;
    }
    function refresh() {
        const percent = Math.min(100, Math.max(0, Number(deduction.value || 0)));
        const finalScore = Math.round((original * (100 - percent) / 100) * 100) / 100;
        const monthsSuggested = Math.min(suggestedMonths(finalScore), maxAllowedMonths);
        finalScoreDisplay.textContent = finalScore.toLocaleString("en-US", { maximumFractionDigits: 2 });
        suggestion.textContent = String(monthsSuggested);
        if (!monthsTouched) months.value = String(monthsSuggested);
    }
    deduction.addEventListener("input", refresh);
    refresh();
})();
</script>
}

<script>
(function () {
    const allInputs = [...document.querySelectorAll(".contract-score-input")];
    const editableInputs = allInputs.filter(input => !input.disabled);
    const topTotal = document.getElementById("contractScoreTotalTop");
    const bottomTotal = document.getElementById("contractScoreTotalBottom");
    if (allInputs.length === 0) return;

    function messageNode(input) {
        return document.getElementById("scoreError-" + input.dataset.scoreId);
    }

    function validateInput(input, showEmptyError) {
        const raw = input.value.trim();
        const value = raw === "" ? null : Number(raw);
        const max = Number(input.dataset.maxScore);
        let error = "";
        if (raw === "" && showEmptyError) {
            error = "برای این پرسش امتیاز وارد کنید.";
        } else if (raw !== "" && (!Number.isFinite(value) || !Number.isInteger(value))) {
            error = "امتیاز این پرسش باید عدد صحیح و بدون اعشار باشد.";
        } else if (raw !== "" && (value < 0 || value > max)) {
            error = "امتیاز باید بین صفر و سقف " + max + " باشد.";
        }

        input.setCustomValidity(error);
        input.classList.toggle("is-invalid", Boolean(error));
        input.dataset.invalid = error ? "true" : "false";
        input.setAttribute("aria-invalid", error ? "true" : "false");

        const message = messageNode(input);
        if (message) {
            message.classList.remove("is-hint");
            message.textContent = error;
        }
        return !error;
    }

    function showRejectedCharacterHint(input) {
        const message = messageNode(input);
        if (message && input.dataset.invalid !== "true") {
            message.textContent = "ورود اعشار و نویسه‌های غیرعددی مجاز نیست؛ فقط عدد صحیح وارد کنید.";
            message.classList.add("is-hint");
        }
    }

    function refreshTotal() {
        let total = 0;
        allInputs.forEach(input => {
            const raw = input.value.trim();
            if (!input.disabled && input.dataset.touched === "true")
                validateInput(input, false);
            const value = raw === "" ? 0 : Number(raw);
            if (Number.isFinite(value) && (input.disabled || input.dataset.invalid !== "true"))
                total += value;
        });
        const formatted = total.toLocaleString("fa-IR", { maximumFractionDigits: 0 });
        if (topTotal) topTotal.textContent = formatted;
        if (bottomTotal) bottomTotal.textContent = formatted;
    }

    function rejectExitFromInvalid(input, event) {
        if (input.dataset.invalid !== "true") return false;
        event?.preventDefault();
        input.focus();
        return true;
    }

    const blockedKeys = new Set([".", ",", "٫", "٬", "e", "E", "+", "-", "Decimal", "NumpadDecimal"]);
    editableInputs.forEach(input => {
        input.dataset.touched = "false";
        input.addEventListener("keydown", event => {
            if (blockedKeys.has(event.key)) {
                event.preventDefault();
                showRejectedCharacterHint(input);
                return;
            }

            if (event.key === "Tab" || event.key === "ArrowDown" || event.key === "Enter") {
                input.dataset.touched = "true";
                if (!validateInput(input, true)) {
                    rejectExitFromInvalid(input, event);
                    return;
                }
                if (event.key === "ArrowDown") {
                    const next = editableInputs[editableInputs.indexOf(input) + 1];
                    if (next) {
                        event.preventDefault();
                        next.focus();
                    }
                }
            }
        });

        input.addEventListener("beforeinput", event => {
            if (event.data && /[.,٫٬eE+-]/.test(event.data)) {
                event.preventDefault();
                showRejectedCharacterHint(input);
            }
        });

        input.addEventListener("paste", event => {
            const pasted = (event.clipboardData?.getData("text") || "").trim();
            if (pasted && !/^[0-9۰-۹٠-٩]+$/.test(pasted)) {
                event.preventDefault();
                showRejectedCharacterHint(input);
            }
        });

        input.addEventListener("input", () => {
            input.dataset.touched = "true";
            validateInput(input, false);
            refreshTotal();
        });
        input.addEventListener("change", () => {
            input.dataset.touched = "true";
            validateInput(input, true);
            refreshTotal();
        });
        input.addEventListener("blur", () => {
            input.dataset.touched = "true";
            validateInput(input, true);
            refreshTotal();
        });
    });

    document.addEventListener("focusin", event => {
        const firstInvalid = editableInputs.find(input =>
            input !== event.target && input.dataset.touched === "true" &&
            !validateInput(input, true));
        if (firstInvalid) {
            event.stopImmediatePropagation();
            firstInvalid.focus();
        }
    }, true);

    const form = document.getElementById("contractEvaluationScoreForm");
    form?.addEventListener("submit", event => {
        editableInputs.forEach(input => {
            input.dataset.touched = "true";
            validateInput(input, true);
        });
        refreshTotal();
        if (!form.checkValidity()) {
            event.preventDefault();
            const firstInvalid = editableInputs.find(input => input.dataset.invalid === "true");
            firstInvalid?.focus();
            form.reportValidity();
        }
    });

    refreshTotal();
})();
</script>

