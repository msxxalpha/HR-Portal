@model HRPortal.Models.WorkflowInstance
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "جزئیات گردش کار";
    var history = ViewBag.History as List<HRPortal.Models.WorkflowHistory> ?? [];
    var renewal = ViewBag.ContractRenewalRequest as HRPortal.Models.ContractRenewalRequest;
    var suggestion = ViewBag.WorkflowSuggestion as HRPortal.Models.Suggestion;
    var outsourcedService = ViewBag.WorkflowOutsourcedServiceRequest as HRPortal.Models.OutsourcedServiceRequest;
    var renewalSteps = ViewBag.ContractRenewalSteps as List<HRPortal.Models.WorkflowStep> ?? [];
    var renewalTasks = ViewBag.ContractRenewalTasks as List<HRPortal.Models.WorkflowTask> ?? [];
    var renewalScores = ViewBag.ContractRenewalScores as List<HRPortal.Models.EmployeePerformanceEvaluationScore> ?? [];
    var statusTitle = Model.Status switch
    {
        "Approved" => "تأیید نهایی",
        "Rejected" => "رد شده",
        "Returned" => "برگشت داده شده",
        _ => "در حال گردش"
    };
}
<div class="page-head">
    <div><h1>@Model.WorkflowDefinition.Title</h1><p>@Model.EntityType #@Model.EntityId</p></div>
    <div class="actions">
        @if (renewal != null && renewal.Status == "تکمیل شده" && renewal.CompletedAt.HasValue)
        {
            <a class="btn btn-main" href="/Workflow/DownloadContractRenewalPdf/@Model.Id">دریافت گزارش نهایی PDF</a>
        }
        <a class="btn btn-outline" href="/Workflow/MyRequests">بازگشت به درخواست‌های من</a>
    </div>
</div>
<section class="workflow-detail-grid">
    <div class="card">
        <div class="section-head"><h3>وضعیت درخواست</h3></div>
        <dl class="detail-list">
            <dt>گردش کار</dt><dd>@Model.WorkflowDefinition.Title</dd>
            <dt>نوع فرم</dt><dd>@Model.EntityType</dd>
            <dt>شناسه</dt><dd>@Model.EntityId</dd>
            <dt>وضعیت</dt><dd><span class="badge">@statusTitle</span></dd>
            <dt>مرحله جاری</dt><dd>@(Model.CurrentStep?.Title ?? "پایان گردش")</dd>
            <dt>جایگاه مرحله</dt><dd>@(Model.CurrentStep?.OrganizationNode?.Title ?? "—")</dd>
            <dt>شروع</dt><dd>@Model.StartedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
        </dl>
    </div>
    <div class="card">
        <div class="section-head"><h3>تاریخچه</h3></div>
        <div class="workflow-history">
        @foreach (var item in history)
        {
            <div class="workflow-history-item">
                <div><strong>@item.Action</strong><span>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span></div>
                <p>@(item.ActorEmployee == null ? "سیستم" : item.ActorEmployee.FirstName + " " + item.ActorEmployee.LastName) — @(item.Comment ?? "بدون توضیح")</p>
            </div>
        }
        </div>
    </div>
</section>

@if (suggestion != null)
{
    <section class="card" style="margin-top:1rem">
        <div class="section-head"><div><h3>اطلاعات پیشنهاد</h3><span class="muted">@suggestion.SuggestionNumber · @suggestion.Category</span></div></div>
        <h4>@suggestion.Title</h4>
        <dl class="detail-list">
            <dt>حوزه مرتبط</dt><dd>@(suggestion.RelatedArea ?? "—")</dd>
            <dt>شرح کوتاه</dt><dd>@suggestion.ShortDescription</dd>
            <dt>شرح مسئله</dt><dd>@suggestion.ProblemDescription</dd>
            <dt>راه‌حل پیشنهادی</dt><dd>@suggestion.ProposedSolution</dd>
            <dt>منافع مورد انتظار</dt><dd>@string.Join("، ", System.Text.Json.JsonSerializer.Deserialize<List<string>>(suggestion.BenefitsJson) ?? new List<string>())</dd>
            <dt>جزئیات منافع</dt><dd>@(suggestion.BenefitDetails ?? "—")</dd>
            <dt>دامنه اجرا</dt><dd>@(suggestion.ImplementationScope ?? "—")</dd>
            <dt>روش اجرا</dt><dd>@(suggestion.ImplementationMethod ?? "—")</dd>
            <dt>منابع موردنیاز</dt><dd>@string.Join("، ", System.Text.Json.JsonSerializer.Deserialize<List<string>>(suggestion.ResourceTypesJson) ?? new List<string>())</dd>
            <dt>توضیحات منابع</dt><dd>@(suggestion.ResourceDetails ?? "—")</dd>
            <dt>اعضای گروه</dt><dd>@(suggestion.Members.Count == 0 ? "فقط پیشنهاددهنده" : string.Join("، ", suggestion.Members.Select(x => x.EmployeeNameSnapshot)))</dd>
            <dt>پیوست‌ها</dt><dd>@(suggestion.Attachments.Count == 0 ? "بدون پیوست" : string.Join("، ", suggestion.Attachments.Select(x => x.OriginalFileName)))</dd>
        </dl>
    </section>
}


@if (outsourcedService != null)
{
    var outsourcedPriority = outsourcedService.Priority switch { "Emergency" => "اضطراری", "Urgent" => "فوری", _ => "عادی" };
    <section class="card" style="margin-top:1rem">
        <div class="section-head"><div><h3>مشخصات سفارش خدمات برونسپاری</h3><span class="muted">@outsourcedService.RequestNumber</span></div>
            <a class="btn btn-outline" href="/OutsourcedServices/Details/@outsourcedService.Id">مشاهده صفحه درخواست</a>
        </div>
        <dl class="detail-list">
            <dt>شرح خدمات درخواستی</dt><dd>@outsourcedService.ServiceDescription</dd>
            <dt>مقدار و واحد سنجش</dt><dd>@outsourcedService.Quantity.ToString("0.###") @outsourcedService.UnitOfMeasure</dd>
            <dt>تاریخ نیازمندی</dt><dd>@HRPortal.Services.PersianDateService.Format(outsourcedService.NeedByDate)</dd>
            <dt>اولویت</dt><dd>@outsourcedPriority</dd>
            <dt>تاریخ ثبت</dt><dd>@HRPortal.Services.PersianDateService.FormatDateTime(HRPortal.Services.PersianDateService.ToTehran(outsourcedService.CreatedAtUtc))</dd>
        </dl>
    </section>
}

@if (renewal != null)
{
    <section class="card" style="margin-top:1rem">
        <div class="section-head"><div><h3>گزارش کامل درخواست تمدید قرارداد</h3><span class="muted">تمام مراحل گردش کار، امتیازها و تصمیم‌های ثبت‌شده</span></div></div>
        <dl class="detail-list">
            <dt>کد درخواست</dt><dd>@renewal.RequestCode</dd>
            <dt>کارمند</dt><dd>@renewal.EmployeeNameSnapshot (@renewal.PersonnelNumberSnapshot)</dd>
            <dt>واحد سازمانی</dt><dd>@renewal.OrganizationUnitSnapshot</dd>
            <dt>عنوان جایگاه</dt><dd>@renewal.PositionTitleSnapshot</dd>
            <dt>وضعیت کسب‌وکاری</dt><dd>@renewal.Status</dd>
            <dt>تاریخ ثبت</dt><dd>@renewal.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
            <dt>تاریخ تکمیل</dt><dd>@(renewal.CompletedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</dd>
            <dt>پایان قرارداد قبلی</dt><dd>@(renewal.PreviousContractEndDate?.ToString("yyyy/MM/dd") ?? "—")</dd>
            <dt>تمدیدهای قبلی</dt><dd>@renewal.PreviousExtensionMonths1 ماه، @renewal.PreviousExtensionMonths2 ماه، @renewal.PreviousExtensionMonths3 ماه</dd>
            <dt>امتیاز دوره قبلی اول</dt><dd>@renewal.PreviousPeriodScore1.ToString("0.##") @(renewal.PreviousPeriodScore1FromHistory ? "(از سوابق)" : "")</dd>
            <dt>امتیاز دوره قبلی دوم</dt><dd>@renewal.PreviousPeriodScore2.ToString("0.##") @(renewal.PreviousPeriodScore2FromHistory ? "(از سوابق)" : "")</dd>
        </dl>
    </section>

    <section class="card" style="margin-top:1rem">
        <div class="section-head"><div><h3>جزئیات همه مراحل</h3><span class="muted">مراحل به ترتیب واقعی گردش کار نمایش داده می‌شوند؛ از ارزشیابی عملکرد تا تصمیم مدیرعامل</span></div></div>
        <div class="workflow-history">
        @foreach (var step in renewalSteps)
        {
            var stepTasks = renewalTasks.Where(t => t.WorkflowStepId == step.Id).ToList();
            var stepScores = renewalScores.Where(s => s.WorkflowStepId == step.Id).ToList();
            var completed = stepTasks.Any(t => t.Status == "Completed");
            <article class="workflow-history-item" style="padding:1rem;margin-bottom:.8rem;border:1px solid var(--border-color,#ddd);border-radius:10px">
                <div>
                    <strong>@step.Title</strong>
                    <span class="badge">@(completed ? "انجام‌شده" : stepTasks.Any(t => t.Status == "Pending") ? "در انتظار اقدام" : "بدون اقدام ثبت‌شده")</span>
                </div>
                <p class="muted">جایگاه: @(step.OrganizationNode?.Title ?? (step.AssignedEmployeeId.HasValue ? "کارمند مشخص" : step.AssignmentType == "Hierarchy" ? "مسیر سلسله‌مراتبی" : "—"))</p>
                @if (renewal is not null && step.Code == "Security")
                {
                    <div class="note"><strong>تصمیم مدیر حراست:</strong> @(renewal.SecurityDecision switch { "ApproveFull" => "موافقت با تمدید قرارداد", "ApproveOneMonth" => "موافقت با تمدید یک‌ماهه", "Reject" => "عدم موافقت", _ => "ثبت نشده" })<p><strong>توضیحات:</strong> @(string.IsNullOrWhiteSpace(renewal.SecurityComment) ? "ثبت نشده" : renewal.SecurityComment)</p></div>
                }
                @if (renewal is not null && step.Code == "HumanResources")
                {
                    <div class="note"><strong>درصد کسر انضباطی:</strong> @renewal.HrDisciplinaryDeductionPercent.ToString("0.##")٪ — <strong>امتیاز نهایی:</strong> @(renewal.FinalEvaluationScore?.ToString("0.##") ?? "ثبت نشده") از ۱۰۰ — <strong>مدت پیشنهادی سیستم:</strong> @HRPortal.Services.ContractRenewalWorkflowService.SuggestedContractMonths(renewal.FinalEvaluationScore) ماه — <strong>پیشنهاد منابع انسانی:</strong> @(renewal.HrProposedContractMonths?.ToString() ?? "ثبت نشده") ماه<p><strong>توضیحات منابع انسانی:</strong> @(string.IsNullOrWhiteSpace(renewal.HrComment) ? "ثبت نشده" : renewal.HrComment)</p></div>
                }
                @if (stepScores.Count > 0)
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>پرسش</th><th>راهنمای امتیازدهی</th><th>سقف</th><th>امتیاز ثبت‌شده</th><th>ارزیاب</th></tr></thead>
                            <tbody>
                            @foreach (var score in stepScores)
                            {
                                <tr>
                                    <td>@score.QuestionTextSnapshot</td>
                                    <td>@score.ScoringGuidanceSnapshot</td>
                                    <td>@score.MaxScoreSnapshot.ToString("0.##")</td>
                                    <td>@(score.Score?.ToString("0.##") ?? "ثبت نشده")</td>
                                    <td>@(score.EvaluatorEmployee == null ? "—" : score.EvaluatorEmployee.FirstName + " " + score.EvaluatorEmployee.LastName)</td>
                                </tr>
                            }
                            <tr><th colspan="3">مجموع امتیاز مرحله</th><th colspan="2">@((stepScores.All(x => x.Score.HasValue) ? stepScores.Sum(x => x.Score!.Value).ToString("0.##") : "ناقص")) از @stepScores.Sum(x => x.MaxScoreSnapshot).ToString("0.##")</th></tr>
                            </tbody>
                        </table>
                    </div>
                }
                @foreach (var task in stepTasks)
                {
                    <div class="workflow-history-item">
                        <p><strong>اقدام:</strong> @(task.Action ?? (task.Status == "Completed" ? "تکمیل" : task.Status)) — <strong>مسئول:</strong> @(task.AssignedEmployee == null ? task.AssignedPosition?.Title ?? "—" : task.AssignedEmployee.FirstName + " " + task.AssignedEmployee.LastName)</p>
                        <p><strong>زمان ثبت:</strong> @((task.CompletedAt ?? task.CreatedAt).ToLocalTime().ToString("yyyy/MM/dd HH:mm"))</p>
                        <p><strong>نظر ثبت‌شده:</strong> @(string.IsNullOrWhiteSpace(task.Comment) ? "نظری ثبت نشده است." : task.Comment)</p>
                    </div>
                }
            </article>
        }
        </div>
    </section>

    <section class="card" style="margin-top:1rem">
        <div class="section-head"><h3>جمع‌بندی تصمیم‌های نهایی</h3></div>
        <dl class="detail-list">
            <dt>امتیاز اولیه ارزشیابی</dt><dd>@((renewal.OriginalEvaluationScore ?? renewal.FinalEvaluationScore)?.ToString("0.##") ?? "ثبت نشده") از ۱۰۰</dd>
            <dt>درصد کسر سوابق انضباطی</dt><dd>@renewal.HrDisciplinaryDeductionPercent.ToString("0.##")٪</dd>
            <dt>امتیاز نهایی پس از کسر</dt><dd>@(renewal.FinalEvaluationScore?.ToString("0.##") ?? "ثبت نشده") از ۱۰۰</dd>
            <dt>مدت پیشنهادی سیستم</dt><dd>@HRPortal.Services.ContractRenewalWorkflowService.SuggestedContractMonths(renewal.FinalEvaluationScore) ماه</dd>
            <dt>تصمیم حراست</dt><dd>@(renewal.SecurityDecision switch { "ApproveFull" => "موافقت", "ApproveOneMonth" => "موافقت با تمدید یک‌ماهه", "Reject" => "عدم موافقت", _ => "ثبت نشده" })</dd>
            <dt>نظر مدیر حراست</dt><dd>@(string.IsNullOrWhiteSpace(renewal.SecurityComment) ? "ثبت نشده" : renewal.SecurityComment)</dd>
            <dt>پیشنهاد مدت قرارداد منابع انسانی و خدمات پشتیبانی</dt><dd>@(renewal.HrProposedContractMonths.HasValue ? renewal.HrProposedContractMonths.Value + " ماه" : "ثبت نشده")</dd>
            <dt>نظر مدیر منابع انسانی و خدمات پشتیبانی</dt><dd>@(string.IsNullOrWhiteSpace(renewal.HrComment) ? "ثبت نشده" : renewal.HrComment)</dd>
            <dt>مدت نهایی مصوب مدیرعامل</dt><dd>@(renewal.FinalContractMonths.HasValue ? renewal.FinalContractMonths.Value + " ماه" : "ثبت نشده")</dd>
            <dt>نظر مدیرعامل</dt><dd>@(string.IsNullOrWhiteSpace(renewal.CeoComment) ? "ثبت نشده" : renewal.CeoComment)</dd>
            <dt>سوابق انضباطی</dt><dd>@(renewal.HasDisciplinaryWarnings ? $"دارای اخطار ({renewal.DisciplinaryWarningCount})" : "بدون اخطار ثبت‌شده")</dd>
            <dt>آرای کمیته انضباطی</dt><dd>@(renewal.HasDisciplinaryCommitteeResolution ? renewal.DisciplinaryCommitteeResolutionCount.ToString() : "۰")</dd>
            <dt>مرخصی بدون حقوق</dt><dd>@(renewal.HasUnpaidLeave ? renewal.UnpaidLeaveDays + " روز" : "۰ روز")</dd>
            <dt>مرخصی استعلاجی</dt><dd>@(renewal.HasSickLeave ? renewal.SickLeaveDays + " روز" : "۰ روز")</dd>
            <dt>مرخصی حادثه</dt><dd>@(renewal.HasAccidentLeave ? renewal.AccidentLeaveDays + " روز" : "۰ روز")</dd>
            <dt>تقدیرنامه</dt><dd>@(renewal.HasCommendations ? renewal.CommendationCount.ToString() : "۰")</dd>
        </dl>
    </section>
}
