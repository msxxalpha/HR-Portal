@model IReadOnlyList<Suggestion>
@{var canManage=(bool)(ViewBag.CanManageSuggestions??false);var canSubmit=(bool)(ViewBag.CanSubmitSuggestions??false);var canViewAll=(bool)(ViewBag.CanViewAllSuggestions??false);var currentEmployeeId=(int)(ViewBag.CurrentEmployeeId??0);ViewData["Title"]=canManage||canViewAll||ViewBag.CurrentEmployeeId==0?"فهرست پیشنهادها":"پیشنهادهای من";}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>پیشنهادهای ثبت‌شده و پیش‌نویس‌ها را مشاهده و پیگیری کنید.</p></div>@if(canSubmit){<a class="btn btn-primary" href="/Suggestions/Create">＋ ثبت پیشنهاد جدید</a>}</div>
<div class="card sugg-list">@if(Model.Count==0){<div class="empty-state"><strong>هنوز پیشنهادی ثبت نکرده‌اید</strong><p>ایده‌های خود را برای بهبود محیط و فرایندهای کاری ثبت کنید.</p>@if(canSubmit){<a class="btn btn-primary" href="/Suggestions/Create">شروع ثبت پیشنهاد</a>}</div>}else{<div class="table-wrap"><table class="data-table"><thead><tr><th>شماره پیگیری</th><th>عنوان</th><th>دسته‌بندی</th><th>وضعیت</th><th>آخرین تغییر</th><th>عملیات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td dir="ltr">@x.SuggestionNumber</td><td>@x.Title</td><td>@x.Category</td><td>@(x.Status=="Draft"?"پیش‌نویس":"ثبت‌شده")</td><td>@x.UpdatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@if(x.Status=="Draft"&&(canManage||x.ProposerEmployeeId==currentEmployeeId)){<a href="/Suggestions/Create/@x.Id">ادامه تکمیل</a>}else{<a href="/Suggestions/Details/@x.Id">مشاهده</a>}</td></tr>}</tbody></table></div>}</div>