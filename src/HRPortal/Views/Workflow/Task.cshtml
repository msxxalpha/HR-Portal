@model HRPortal.Models.WorkflowTask
@using HRPortal.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "اقدام در گردش کار";
    var history = ViewBag.History as List<WorkflowHistory> ?? [];
    var groups = ViewBag.FieldGroups as List<WorkflowTaskFieldGroup> ?? [];
    var suggestion = ViewBag.WorkflowSuggestion as Suggestion;
    var outsourcedService = ViewBag.WorkflowOutsourcedServiceRequest as HRPortal.Models.OutsourcedServiceRequest;
    var workflowPositions = ViewBag.WorkflowPositions as List<OrganizationNode> ?? [];
}
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
<div class="page-head">
    <div><h1>@Model.WorkflowStep.Title</h1><p>@Model.WorkflowInstance.WorkflowDefinition.Title — درخواست @Model.WorkflowInstance.EntityType #@Model.WorkflowInstance.EntityId</p></div>
    <a class="btn btn-outline" href="/Workflow/Inbox">بازگشت به کارتابل</a>
</div>
<section class="workflow-detail-grid">
    <div class="card">
        <div class="section-head"><h3>مشخصات درخواست</h3></div>
        <dl class="detail-list">
            <dt>درخواست‌کننده</dt><dd>@Model.WorkflowInstance.RequesterEmployee.FirstName @Model.WorkflowInstance.RequesterEmployee.LastName</dd>
            <dt>شماره پرسنلی</dt><dd>@Model.WorkflowInstance.RequesterEmployee.PersonnelNumber</dd>
            <dt>نوع فرم</dt><dd>@Model.WorkflowInstance.EntityType</dd>
            <dt>شناسه درخواست</dt><dd>@Model.WorkflowInstance.EntityId</dd>
            <dt>مرحله جاری</dt><dd>@Model.WorkflowStep.Title</dd>
            <dt>جایگاه سازمانی مسئول</dt><dd>@Model.AssignedPosition?.Title</dd>
        </dl>
    </div>
</section>

@if (suggestion != null)
{
    @if (Model.WorkflowStep.AssignmentType == "Requester" && Model.WorkflowInstance.RequesterEmployeeId == Model.AssignedEmployeeId)
    {
        <section class="card" style="margin-top:1rem">
            <div class="section-head"><div><h3>اصلاح اطلاعات پیشنهاد</h3><span class="muted">این درخواست برای اصلاح به پیشنهاددهنده برگشت داده شده است.</span></div>
                <a class="btn btn-main" href="/Suggestions/Create?id=@suggestion.Id">ویرایش فرم پیشنهاد</a>
            </div>
            <p class="muted">پس از ذخیره اصلاحات، به همین کارتابل بازگردید و اقدام «تأیید» را برای ارسال مجدد انجام دهید.</p>
        </section>
    }
    <section class="card form-stack" style="margin-top:1rem">
        <div class="section-head"><div><h3>متن پیشنهاد ثبت‌شده</h3><span class="muted">@suggestion.SuggestionNumber · @suggestion.Category</span></div></div>
        <h4>@suggestion.Title</h4>
        <dl class="detail-list">
            <dt>حوزه مرتبط</dt><dd>@(suggestion.RelatedArea ?? "—")</dd>
            <dt>شرح کوتاه</dt><dd>@suggestion.ShortDescription</dd>
            <dt>شرح مسئله</dt><dd>@suggestion.ProblemDescription</dd>
            <dt>راه‌حل پیشنهادی</dt><dd>@suggestion.ProposedSolution</dd>
            <dt>منافع مورد انتظار</dt><dd>@string.Join("، ", System.Text.Json.JsonSerializer.Deserialize<List<string>>(suggestion.BenefitsJson) ?? new List<string>())</dd>
            <dt>جزئیات منافع</dt><dd>@(suggestion.BenefitDetails ?? "—")</dd>
            <dt>دامنه اجرا</dt><dd>@(suggestion.ImplementationScope ?? "—")</dd>
            <dt>روش اجرا</dt><dd>@(suggestion.ImplementationMethod ?? "—")</dd>
            <dt>منابع موردنیاز</dt><dd>@string.Join("، ", System.Text.Json.JsonSerializer.Deserialize<List<string>>(suggestion.ResourceTypesJson) ?? new List<string>())</dd>
            <dt>توضیحات منابع</dt><dd>@(suggestion.ResourceDetails ?? "—")</dd>
            <dt>اعضای گروه</dt><dd>@(suggestion.Members.Count == 0 ? "فقط پیشنهاددهنده" : string.Join("، ", suggestion.Members.Select(x => x.EmployeeNameSnapshot)))</dd>
            <dt>پیوست‌ها</dt><dd>@(suggestion.Attachments.Count == 0 ? "بدون پیوست" : string.Join("، ", suggestion.Attachments.Select(x => x.OriginalFileName)))</dd>
        </dl>
    </section>
}


@if (outsourcedService != null)
{
    var outsourcedPriority = outsourcedService.Priority switch { "Emergency" => "اضطراری", "Urgent" => "فوری", _ => "عادی" };
    <section class="card form-stack" style="margin-top:1rem">
        <div class="section-head"><div><h3>مشخصات سفارش خدمات برونسپاری</h3><span class="muted">@outsourcedService.RequestNumber</span></div>
            @if (User.HasClaim("IsAdmin", "1") || User.HasClaim("Permission", "OutsourcedServices.ViewAll") || User.HasClaim("Permission", "OutsourcedServices.Reports") || User.HasClaim("Permission", "OutsourcedServices.Create")) { <a class="btn btn-outline" href="/OutsourcedServices/Details/@outsourcedService.Id">مشاهده صفحه درخواست</a> }
        </div>
        <dl class="detail-list">
            <dt>شرح خدمات درخواستی</dt><dd>@outsourcedService.ServiceDescription</dd>
            <dt>مقدار و واحد سنجش</dt><dd>@outsourcedService.Quantity.ToString("0.###") @outsourcedService.UnitOfMeasure</dd>
            <dt>تاریخ نیازمندی</dt><dd>@HRPortal.Services.PersianDateService.Format(outsourcedService.NeedByDate)</dd>
            <dt>اولویت</dt><dd>@outsourcedPriority</dd>
            <dt>تاریخ ثبت</dt><dd>@HRPortal.Services.PersianDateService.FormatDateTime(HRPortal.Services.PersianDateService.ToTehran(outsourcedService.CreatedAtUtc))</dd>
        </dl>
    </section>
}

@if (groups.Count > 0)
{
    <section class="card form-stack">
        <div class="section-head"><div><h3>اطلاعات فرم</h3><p class="muted">فیلدهای مراحل قبل فقط در صورت مجاز بودن ویرایش در تنظیمات این مرحله قابل تغییر هستند.</p></div></div>
        <form method="post" action="/Workflow/Act" class="form-stack" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            @foreach (var group in groups)
            {
                <section class="card">
                    <div class="section-head"><h3>@group.StepTitle</h3><span class="badge">@(group.IsCurrentStep ? "مرحله جاری" : group.IsEditable ? "مرحله قبل — ویرایش مجاز" : "فقط خواندنی")</span></div>
                    <div class="grid-2">
                    @foreach (var field in group.Fields)
                    {
                        <div class="form-field">
                            <label for="wf_@(group.WorkflowStepId)_@(field.FieldDefinitionId)">@field.Title @(group.IsCurrentStep && field.IsRequired ? "*" : "")</label>
                            @if (!group.IsEditable)
                            {
                                <div class="readonly-field" id="wf_@(group.WorkflowStepId)_@(field.FieldDefinitionId)">
                                    @if (field.FieldType == "Checkbox")
                                    {
                                        @(field.Value == "true" ? "بله" : "خیر")
                                    }
                                    else
                                    {
                                        @(field.FieldType == "PositionPicker" && int.TryParse(field.Value, out var positionId) ? workflowPositions.FirstOrDefault(p => p.Id == positionId)?.Title ?? "جایگاه نامعتبر/غیرفعال" : string.IsNullOrWhiteSpace(field.Value) ? "—" : field.Value)
                                    }
                                </div>
                            }
                            else if (field.FieldType == "TextArea")
                            {
                                <textarea id="wf_@(group.WorkflowStepId)_@(field.FieldDefinitionId)" name="@(group.IsCurrentStep ? $"values[{field.Code}]" : $"previousValues[{field.FieldDefinitionId}]")" rows="3" maxlength="@(field.MaxLength ?? 4000)" required="@(group.IsCurrentStep && field.IsRequired)">@field.Value</textarea>
                            }
                            else if (field.FieldType == "PositionPicker")
                            {
                                <select id="wf_@(group.WorkflowStepId)_@(field.FieldDefinitionId)" name="@(group.IsCurrentStep ? $"values[{field.Code}]" : $"previousValues[{field.FieldDefinitionId}]")" required="@(group.IsCurrentStep && field.IsRequired)" disabled="@(!group.IsEditable)">
                                    <option value="">انتخاب جایگاه سازمانی</option>
                                    @foreach (var position in workflowPositions)
                                    {
                                        <option value="@position.Id" selected="@(field.Value == position.Id.ToString())">@position.Title — @position.RankType</option>
                                    }
                                </select>
                            }
                            else if (field.FieldType == "Select")
                            {
                                <select id="wf_@(group.WorkflowStepId)_@(field.FieldDefinitionId)" name="@(group.IsCurrentStep ? $"values[{field.Code}]" : $"previousValues[{field.FieldDefinitionId}]")" required="@(group.IsCurrentStep && field.IsRequired)">
                                    <option value="">انتخاب کنید</option>
                                    @foreach (var option in (field.Options ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <option value="@option" selected="@(field.Value == option)">@option</option>
                                    }
                                </select>
                            }
                            else if (field.FieldType == "Checkbox" && group.IsCurrentStep)
                            {
                                <input type="checkbox" id="wf_@(group.WorkflowStepId)_@(field.FieldDefinitionId)" name="values[@field.Code]" value="true" checked="@(field.Value == "true")" />
                            }
                            else if (field.FieldType == "Checkbox")
                            {
                                <select id="wf_@(group.WorkflowStepId)_@(field.FieldDefinitionId)" name="previousValues[@field.FieldDefinitionId]">
                                    <option value="">بدون تغییر</option>
                                    <option value="true" selected="@(field.Value == "true")">بله</option>
                                    <option value="false" selected="@(field.Value == "false")">خیر</option>
                                </select>
                            }
                            else
                            {
                                var inputType = field.FieldType == "Number" ? "number" : field.FieldType == "Date" ? "date" : "text";
                                <input id="wf_@(group.WorkflowStepId)_@(field.FieldDefinitionId)" name="@(group.IsCurrentStep ? $"values[{field.Code}]" : $"previousValues[{field.FieldDefinitionId}]")" type="@inputType" value="@field.Value" maxlength="@(field.MaxLength ?? 4000)" required="@(group.IsCurrentStep && field.IsRequired)" />
                            }
                            @if (!string.IsNullOrWhiteSpace(field.HelpText))
                            {
                                <small class="muted">@field.HelpText</small>
                            }
                        </div>
                    }
                    </div>
                </section>
            }
            <section class="card">
                <div class="section-head"><h3>اقدام و توضیحات</h3></div>
                <label>ملاحظات @(Model.WorkflowStep.RequireNotes ? "*" : "")
                    <textarea name="comment" rows="4" required="@Model.WorkflowStep.RequireNotes" placeholder="@(Model.WorkflowStep.RequireNotes ? "ثبت ملاحظات این مرحله الزامی است." : "در صورت نیاز توضیح خود را ثبت کنید.")"></textarea>
                </label>
                <div class="actions">
                    <button class="btn btn-outline" name="action" value="SaveDraft" type="submit">ذخیره پیش‌نویس</button>
                    @if (Model.WorkflowStep.AllowReturn) { <button class="btn btn-outline" name="action" value="Return" type="submit">برگشت</button> }
                    @if (Model.WorkflowStep.AllowReject) { <button class="btn danger" name="action" value="Reject" type="submit">رد درخواست</button> }
                    @if (Model.WorkflowStep.AllowApprove) { <button class="btn btn-main" name="action" value="Approve" type="submit">ذخیره اطلاعات و تأیید</button> }
                </div>
            </section>
        </form>
    </section>
}
else
{
    <section class="card">
        <div class="section-head"><h3>اقدام</h3></div>
        <form method="post" action="/Workflow/Act" class="form-stack">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <label>ملاحظات @(Model.WorkflowStep.RequireNotes ? "*" : "")<textarea name="comment" rows="5" required="@Model.WorkflowStep.RequireNotes" placeholder="@(Model.WorkflowStep.RequireNotes ? "ثبت ملاحظات این مرحله الزامی است." : "در صورت نیاز توضیح خود را ثبت کنید.")"></textarea></label>
            <div class="actions">
                <button class="btn btn-outline" name="action" value="SaveDraft" type="submit">ذخیره پیش‌نویس</button>
                @if (Model.WorkflowStep.AllowReturn) { <button class="btn btn-outline" name="action" value="Return" type="submit">برگشت</button> }
                @if (Model.WorkflowStep.AllowReject) { <button class="btn danger" name="action" value="Reject" type="submit">رد درخواست</button> }
                @if (Model.WorkflowStep.AllowApprove) { <button class="btn btn-main" name="action" value="Approve" type="submit">تأیید</button> }
            </div>
        </form>
    </section>
}
<section class="card">
    <div class="section-head"><h3>تاریخچه گردش کار</h3></div>
    <div class="workflow-history">
    @foreach (var item in history)
    {
        <div class="workflow-history-item">
            <div><strong>@item.Action</strong><span>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span></div>
            <p>@(item.ActorEmployee == null ? "سیستم" : item.ActorEmployee.FirstName + " " + item.ActorEmployee.LastName) — @(item.Comment ?? "بدون توضیح")</p>
        </div>
    }
    </div>
</section>
