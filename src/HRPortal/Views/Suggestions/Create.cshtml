@model SuggestionFormVm
@{ViewData["Title"]="ثبت پیشنهاد";var cats=(string[])ViewBag.Categories;var bens=(string[])ViewBag.Benefits;var ress=(string[])ViewBag.Resources;var canManage=(bool)ViewBag.CanManageSuggestions;var proposer=ViewBag.Proposer as SuggestionEmployeeOption;}
<div class="suggestion-wizard"><aside class="suggestion-guide"><div class="guide-icon">✦</div><small>راهنمای ثبت پیشنهاد</small><h2>ایده‌های کوچک، تغییرهای بزرگ</h2><p>پیشنهاد خوب، مسئله‌ای واقعی را به راه‌حلی روشن و قابل اجرا تبدیل می‌کند. لازم نیست همه جزئیات فنی یا مالی را از ابتدا بدانید.</p><div class="guide-step"><b>۱</b><span><strong>موضوع و همکاران</strong><small>عنوان، حوزه و اعضای گروه را مشخص کنید.</small></span></div><div class="guide-step"><b>۲</b><span><strong>شرح و راه‌حل</strong><small>مسئله، ایده و نتایج مورد انتظار را توضیح دهید.</small></span></div><div class="guide-tips"><strong>چند نکته مفید</strong><ul><li>روشن و کوتاه بنویسید.</li><li>روی بهبود قابل مشاهده تمرکز کنید.</li><li>اگر عدد دقیقی ندارید، تخمین مالی وارد نکنید.</li><li>فایل کمکی را در صورت نیاز پیوست کنید.</li></ul></div><a href="/Suggestions">← پیشنهادهای من</a></aside>
<section class="suggestion-panel"><header><div><small>سامانه پیشنهادات کارکنان</small><h1>@ViewData["Title"]</h1><p>فرم را در دو گام ساده تکمیل کنید.</p></div><span>حدود ۳ تا ۵ دقیقه</span></header><div class="wizard-progress"><b class="active" id="progress1">۱ · اطلاعات اولیه و گروه</b><i></i><b id="progress2">۲ · شرح پیشنهاد</b></div>
@if(!ViewData.ModelState.IsValid){<div class="alert alert-danger">لطفاً خطاهای فرم را بررسی کنید.</div>}
<form asp-action="Save" method="post" enctype="multipart/form-data" id="suggForm">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><input type="hidden" asp-for="CurrentStep" value="1"/>
<div data-pane="1" style="@(Model.CurrentStep==1?"":"display:none")"><h3>۱. موضوع پیشنهاد</h3><div class="sugg-grid"><label>عنوان پیشنهاد *<input asp-for="Title" maxlength="200" placeholder="مثلاً کاهش زمان توقف خط تولید"/><span asp-validation-for="Title"></span></label><label>دسته‌بندی *<select asp-for="Category"><option value="">انتخاب کنید</option>@foreach(var c in cats){<option>@c</option>}</select><span asp-validation-for="Category"></span></label><label>حوزه یا واحد مرتبط <small>(اختیاری)</small><input asp-for="RelatedArea" maxlength="100" placeholder="مثلاً تولید یا فناوری اطلاعات"/></label><label class="wide">خلاصه پیشنهاد *<textarea asp-for="ShortDescription" rows="3" maxlength="500" placeholder="در دو یا سه جمله بگویید چه چیزی را می‌خواهید بهتر کنید؟"></textarea><span asp-validation-for="ShortDescription"></span></label></div>
@if(canManage){<h3>پیشنهاددهنده اصلی</h3><div class="sugg-proposer-box"><div><strong id="proposerName">@(proposer?.Name??"هنوز انتخاب نشده است")</strong><small id="proposerMeta">@(proposer is null?"برای ثبت پیشنهاد، پیشنهاددهنده را از کارکنان فعال انتخاب کنید.":proposer.PersonnelNumber+" · "+proposer.Organization)</small></div></div><label class="sugg-proposer-search">جست‌وجوی پیشنهاددهنده<input id="proposerSearch" type="search" placeholder="نام یا شماره پرسنلی را وارد کنید..."/></label><div id="proposerResults" hidden></div><input type="hidden" asp-for="ProposerEmployeeId"/><span asp-validation-for="ProposerEmployeeId"></span>}else{<input type="hidden" asp-for="ProposerEmployeeId"/><div class="owner-card"><b>شما</b><span>پیشنهاددهنده اصلی و مسئول پیگیری</span><strong id="memberCount">۱ از ۵ نفر</strong></div>}<h3>۲. اعضای گروه پیشنهاد <small>حداکثر ۵ نفر با احتساب پیشنهاددهنده</small></h3><label class="employee-search">افزودن همکار از فهرست کارکنان<input id="employeeSearch" type="search" placeholder="نام، نام خانوادگی یا شماره پرسنلی را جست‌وجو کنید..."/></label><div id="employeeResults" hidden></div><div id="selectedMembers">@foreach(var p in Model.EmployeeOptions){<div class="member-chip" data-id="@p.Id">@p.Name · @p.PersonnelNumber · @p.Organization <button type="button">×</button><input type="hidden" name="SelectedEmployeeIds" value="@p.Id"/></div>}</div><small>فقط کارکنان فعال قابل انتخاب هستند؛ انتخاب تکراری و انتخاب خودتان امکان‌پذیر نیست.</small></div>
<div data-pane="2" style="@(Model.CurrentStep==2?"":"display:none")"><h3>۳. مسئله و راه‌حل پیشنهادی</h3><div class="sugg-grid"><label class="wide">مسئله یا فرصت موجود *<textarea asp-for="ProblemDescription" rows="4" placeholder="وضعیت فعلی چیست و چه مشکلی وجود دارد؟"></textarea><span asp-validation-for="ProblemDescription"></span></label><label class="wide">راه‌حل پیشنهادی *<textarea asp-for="ProposedSolution" rows="4" placeholder="ایده شما برای رفع مسئله یا استفاده از فرصت چیست؟"></textarea><span asp-validation-for="ProposedSolution"></span></label></div>
<h3>۴. منافع مورد انتظار</h3><div class="sugg-checks">@foreach(var b in bens){<label><input type="checkbox" name="Benefits" value="@b" checked="@Model.Benefits.Contains(b)"/>@b</label>}</div><label class="wide">توضیح یا برآورد تقریبی منافع <small>(اختیاری)</small><textarea asp-for="BenefitDetails" rows="2" maxlength="1000" placeholder="عدد دقیق الزامی نیست."></textarea></label>
<h3>۵. نحوه اجرا و منابع موردنیاز</h3><div class="sugg-grid"><label>دامنه اجرا<select asp-for="ImplementationScope"><option value="">انتخاب کنید</option><option>کل شرکت</option><option>معاونت یا مدیریت</option><option>اداره یا بخش</option><option>یک فرایند مشخص</option><option>چند واحد سازمانی</option></select></label><label>روش پیشنهادی اجرا<input asp-for="ImplementationMethod" placeholder="خلاصه گام‌های اجرا"/></label><div class="wide"><b>منابع احتمالی موردنیاز</b><div class="sugg-checks">@foreach(var r in ress){<label><input type="checkbox" name="ResourceTypes" value="@r" checked="@Model.ResourceTypes.Contains(r)"/>@r</label>}</div></div><label class="wide">توضیح منابع موردنیاز <small>(اختیاری)</small><textarea asp-for="ResourceDetails" rows="2" maxlength="1500"></textarea></label><label class="wide">پیوست‌ها <small>(اختیاری · هر فایل حداکثر ۱۰ مگابایت)</small><input type="file" name="files" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg"/><small>PDF، Word، Excel و تصویر</small>@if(Model.Attachments.Count>0){<ul>@foreach(var a in Model.Attachments){<li><a href="/Suggestions/Download/@a.Id">@a.OriginalFileName</a></li>}</ul>}</label></div><div class="review-note">پیش از ثبت نهایی، اطلاعات را مرور کنید. پس از ثبت، شماره پیگیری صادر می‌شود.</div></div>
<footer>@if(!(bool)(ViewBag.IsAdminEditingSubmitted??false)){<button type="submit" name="submit" value="false" class="btn btn-outline">ذخیره پیش‌نویس</button>}<span></span><button type="button" id="backStep" class="btn btn-light" hidden>مرحله قبل</button><button type="button" id="nextStep" class="btn btn-primary">ادامه ←</button><button type="submit" name="submit" value="true" id="submitSuggestion" class="btn btn-primary" hidden>@( (bool)(ViewBag.IsAdminEditingSubmitted??false) ? "ذخیره اصلاحات" : "ثبت نهایی پیشنهاد")</button></footer></form></section></div>
@section Scripts{<script>(()=>{const f=document.getElementById('suggForm'),panes=[...f.querySelectorAll('[data-pane]')],back=document.getElementById('backStep'),next=document.getElementById('nextStep'),submit=document.getElementById('submitSuggestion'),step=f.querySelector('[name=CurrentStep]');function show(n){panes.forEach(p=>p.hidden=p.dataset.pane!=n);panes.forEach(p=>p.style.display=p.dataset.pane==n?'':'none');step.value=n;back.hidden=n==1;next.hidden=n==2;submit.hidden=n==1;document.getElementById('progress1').classList.toggle('active',n==1);document.getElementById('progress2').classList.toggle('active',n==2);window.scrollTo(0,0)}next.onclick=()=>{const t=f.querySelector('[name=Title]'),c=f.querySelector('[name=Category]'),s=f.querySelector('[name=ShortDescription]');if(!t.value.trim()){t.focus();return}if(!c.value){c.focus();return}if(!s.value.trim()){s.focus();return}show(2)};back.onclick=()=>show(1);const selected=document.getElementById('selectedMembers'),results=document.getElementById('employeeResults'),search=document.getElementById('employeeSearch'),count=document.getElementById('memberCount');function upd(){if(count)count.textContent=(selected.querySelectorAll('.member-chip').length+1)+' از ۵ نفر'}selected.onclick=e=>{if(e.target.tagName==='BUTTON'){e.target.parentElement.remove();upd()}};let timer;search.oninput=()=>{clearTimeout(timer);let q=search.value.trim();if(q.length<2){results.hidden=true;return}timer=setTimeout(async()=>{let r=await fetch('/Suggestions/SearchEmployees?term='+encodeURIComponent(q)),people=await r.json();results.replaceChildren();people.filter(p=>p.id!==Number(document.getElementById("ProposerEmployeeId")?.value||0)&&!selected.querySelector('[data-id="'+p.id+'"]')&&selected.querySelectorAll('.member-chip').length<4).forEach(p=>{let b=document.createElement('button');b.type='button';b.textContent=p.name+' · '+p.personnelNumber+' · '+p.organization;b.onclick=()=>{let d=document.createElement('div');d.className='member-chip';d.dataset.id=p.id;d.append(document.createTextNode(b.textContent+' '));let x=document.createElement('button');x.type='button';x.textContent='×';d.append(x);let h=document.createElement('input');h.type='hidden';h.name='SelectedEmployeeIds';h.value=p.id;d.append(h);selected.append(d);results.hidden=true;search.value='';upd()};results.append(b)});results.hidden=false},250)};upd();
const canManage = @(canManage ? "true" : "false");
if(canManage){
const proposerSearch=document.getElementById('proposerSearch'),proposerResults=document.getElementById('proposerResults'),proposerId=document.getElementById('ProposerEmployeeId');let proposerTimer;
proposerSearch.oninput=()=>{clearTimeout(proposerTimer);const q=proposerSearch.value.trim();if(q.length<2){proposerResults.hidden=true;return}proposerTimer=setTimeout(async()=>{const people=await(await fetch('/Suggestions/SearchEmployees?term='+encodeURIComponent(q))).json();proposerResults.replaceChildren();people.forEach(p=>{const b=document.createElement('button');b.type='button';b.textContent=p.name+' · '+p.personnelNumber+' · '+p.organization;b.onclick=()=>{proposerId.value=p.id;document.getElementById('proposerName').textContent=p.name;document.getElementById('proposerMeta').textContent=p.personnelNumber+' · '+p.organization;proposerResults.hidden=true;proposerSearch.value=''};proposerResults.append(b)});proposerResults.hidden=false},250)};
}
show(@Model.CurrentStep);})();</script>}
