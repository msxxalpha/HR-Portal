@inject HRPortal.Services.AnnouncementService AnnouncementService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "داشبورد";
    var isAdmin = User.HasClaim("IsAdmin", "1");
    var canCreateEmployee = isAdmin || User.HasClaim("Permission", "Employees.Create");
    var canViewEmployees = isAdmin || User.HasClaim("Permission", "Employees.View");
    var canViewOrg = isAdmin || User.HasClaim("Permission", "Organization.View");
    var canViewPayroll = isAdmin || User.HasClaim("Permission", "Payroll.View");
    var canViewSettings = isAdmin || User.HasClaim("Permission", "Settings.View");

}

@{
    var activeAnnouncements = ViewBag.Announcements as List<HRPortal.Models.Announcement> ?? [];
    var canViewWorkflowDashboard = (bool?)ViewBag.CanViewWorkflowDashboard ?? false;
    var dashboardInbox = ViewBag.WorkflowInbox as List<HRPortal.Models.WorkflowInboxRow> ?? [];
    var dashboardRequests = ViewBag.DashboardRequests as List<HRPortal.Models.WorkflowInboxRow> ?? [];
    var dashboardRequestCount = (int?)ViewBag.DashboardRequestCount ?? 0;
    var dashboardInboxCount = (int?)ViewBag.WorkflowInboxCount ?? 0;
}
@if (!isAdmin && !((bool?)ViewBag.HasPersonalPassword ?? true))
{
    <div class="alert warning" style="margin-bottom:16px;">
        <strong>رمز عبور شخصی خود را تعیین کنید.</strong>
        <div>برای ورودهای بعدی می‌توانید علاوه بر رمز یکبارمصرف، با نام کاربری و رمز شخصی نیز وارد سامانه شوید.</div>
        <a class="btn btn-main btn-sm" href="/Account/PersonalPassword" style="margin-top:10px;">تنظیم رمز شخصی</a>
    </div>
}

<div class="hero">
    <div>
        <div class="eyebrow">سامانه یکپارچه منابع انسانی</div>
        <h1>پورتال جامع منابع انسانی</h1>
        <p>مدیریت اطلاعات کارکنان، ساختار سازمانی و خدمات پرسنلی در یک محیط یکپارچه.</p>
    </div>
    @if (canCreateEmployee) { <a class="btn btn-main btn-hero" href="/Employees/Create">ثبت کارمند جدید</a> }
</div>

<div class="stats">
    <div class="stat"><span>کل کارکنان</span><strong>@ViewBag.EmployeeCount</strong></div>
    <div class="stat"><span>کارکنان فعال</span><strong>@ViewBag.ActiveEmployeeCount</strong></div>
    <div class="stat"><span>نسخه‌های نهایی ساختار</span><strong>@ViewBag.RevisionCount</strong></div>
</div>

@if (canViewWorkflowDashboard)
{
    <section class="workflow-dashboard">
        <div class="workflow-dashboard-heading">
            <div>
                <span class="eyebrow">پیگیری گردش کار</span>
                <h2>کارتابل و درخواست‌ها</h2>
                <p>دسترسی سریع به کارهای منتظر اقدام و آخرین وضعیت درخواست‌ها</p>
            </div>
            <div class="workflow-dashboard-shortcuts">
                <a class="btn btn-outline" href="/Workflow/Inbox">ورود به کارتابل</a>
                <a class="btn btn-main" href="/Workflow/MyRequests">@(isAdmin ? "مدیریت درخواست‌ها" : "همه درخواست‌های من")</a>
            </div>
        </div>
        <div class="workflow-dashboard-grid">
            <section class="workflow-widget inbox-widget">
                <div class="workflow-widget-head">
                    <div class="workflow-widget-icon inbox-icon"><span>✓</span></div>
                    <div><h3>کارتابل من</h3><p>موارد منتظر اقدام شما</p></div>
                    <span class="workflow-widget-count">@dashboardInboxCount</span>
                </div>
                @if (dashboardInbox.Count == 0)
                {
                    <div class="workflow-empty"><span class="workflow-empty-mark">✓</span><strong>کارتابل شما به‌روز است</strong><p>در حال حاضر موردی برای اقدام نمایش داده نمی‌شود.</p></div>
                }
                else
                {
                    <div class="workflow-widget-list">
                        @foreach (var item in dashboardInbox)
                        {
                            <article class="workflow-list-item">
                                <div class="workflow-list-main">
                                    <strong>@item.WorkflowTitle</strong>
                                    <span>@item.StepTitle · @item.RequesterName</span>
                                    <small>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small>
                                </div>
                                <a class="workflow-open-link" href="/Workflow/Task/@item.TaskId" aria-label="مشاهده و اقدام">بررسی <span>←</span></a>
                            </article>
                        }
                    </div>
                }
                <a class="workflow-widget-footer" href="/Workflow/Inbox">مشاهده همه موارد کارتابل <span>←</span></a>
            </section>
            <section class="workflow-widget requests-widget">
                <div class="workflow-widget-head">
                    <div class="workflow-widget-icon requests-icon"><span>↗</span></div>
                    <div><h3>@(isAdmin ? "درخواست‌های سامانه" : "درخواست‌های من")</h3><p>@(isAdmin ? "آخرین درخواست‌های ثبت‌شده در سامانه" : "پیگیری درخواست‌های ارسال‌شده توسط شما")</p></div>
                    <span class="workflow-widget-count">@dashboardRequestCount</span>
                </div>
                @if (dashboardRequests.Count == 0)
                {
                    <div class="workflow-empty"><span class="workflow-empty-mark">↗</span><strong>درخواستی برای نمایش وجود ندارد</strong><p>درخواست‌های گردش کار پس از ثبت در این بخش قابل پیگیری هستند.</p></div>
                }
                else
                {
                    <div class="workflow-widget-list">
                        @foreach (var item in dashboardRequests)
                        {
                            var statusTitle = item.Status switch
                            {
                                "Approved" => "تأیید نهایی",
                                "Rejected" => "رد شده",
                                "Returned" => "برگشت داده شده",
                                _ => "در حال گردش"
                            };
                            var statusClass = item.Status switch { "Approved" => "done", "Rejected" => "rejected", "Returned" => "returned", _ => "pending" };
                            <article class="workflow-list-item">
                                <div class="workflow-list-main">
                                    <strong>@item.WorkflowTitle</strong>
                                    <span>@(isAdmin ? item.RequesterName : item.EntityType + " #" + item.EntityId) · @item.StepTitle</span>
                                    <small>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small>
                                </div>
                                <div class="workflow-list-actions">
                                    <span class="workflow-status @statusClass">@statusTitle</span>
                                    <a class="workflow-open-link" href="/Workflow/Details/@item.WorkflowInstanceId" aria-label="مشاهده درخواست">جزئیات <span>←</span></a>
                                </div>
                            </article>
                        }
                    </div>
                }
                <a class="workflow-widget-footer" href="/Workflow/MyRequests">@(isAdmin ? "مدیریت همه درخواست‌ها" : "مشاهده همه درخواست‌های من") <span>←</span></a>
            </section>
        </div>
    </section>
}

@if (activeAnnouncements.Count > 0)
{
    <section class="announcement-dashboard">
        <div class="announcement-dashboard-head">
            <div>
                <span class="eyebrow">اطلاعیه‌های سامانه</span>
                <h2>آخرین اطلاعیه‌ها</h2>
            </div>
            <span class="announcement-count">@activeAnnouncements.Count مورد معتبر</span>
        </div>
        <div class="announcement-dashboard-list">
            @foreach (var item in activeAnnouncements)
            {
                var priorityClass = item.Priority switch
                {
                    "urgent" => "urgent",
                    "important" => "important",
                    _ => "normal"
                };
                <article class="announcement-card @priorityClass @(item.IsPinned ? "pinned" : "")">
                    <div class="announcement-card-top">
                        <span class="announcement-category">@item.Category?.Title</span>
                        @if (item.IsPinned)
                        {
                            <span class="announcement-pin">سنجاق‌شده</span>
                        }
                        <span class="announcement-priority">@(
                            item.Priority == "urgent" ? "فوری" :
                            item.Priority == "important" ? "مهم" : "اطلاعیه")</span>
                    </div>
                    <h3>@item.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(item.Summary))
                    {
                        <p class="announcement-summary">@item.Summary</p>
                    }
                    <div class="announcement-body">@Html.Raw(System.Net.WebUtility.HtmlEncode(item.Body).Replace("\n", "<br />"))</div>
                    <div class="announcement-meta">
                        <span>اعتبار تا @(await AnnouncementService.FormatLocal(item.EndAtUtc))</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

<div class="module-grid">
    @if (canViewEmployees) { <a class="module" href="/Employees"><b>01</b><h3>مدیریت کارکنان</h3><p>ثبت، ویرایش، غیرفعال‌سازی، جستجو، فیلتر و تبادل Excel.</p></a> }
    @if (canViewOrg) { <a class="module" href="/Organization"><b>02</b><h3>ساختار سازمانی</h3><p>ساختار درختی، بازنگری، نسخه‌بندی و تاریخچه تغییرات.</p></a> }
    @if (canViewPayroll) { <a class="module" href="/Payroll/Payslip"><b>03</b><h3>فیش حقوقی</h3><p>نمایش فیش حقوقی بر اساس ماه و شماره پرسنلی حساب کاربر.</p></a> }
    @if (canViewSettings) { <a class="module" href="/SystemSettings"><b>04</b><h3>تنظیمات محیط سامانه</h3><p>تنظیمات عمومی، ظاهر، OTP، پیامک و SSRS.</p></a> }
</div>