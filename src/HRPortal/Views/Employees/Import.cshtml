@{ViewData["Title"]="ورود کارکنان از اکسل";}<div class="page-head"><div><h1>ورود کارکنان از اکسل</h1><p>ستون‌های اجباری: شماره پرسنلی، کد ملی، نام، نام خانوادگی، موبایل، جنسیت. کد واحد/اداره/بخش اختیاری است.</p></div><a class="btn btn-outline" href="/Employees">بازگشت</a></div>@if(ViewBag.Success!=null){<div class="alert success">@ViewBag.Success</div>}@if(ViewBag.Errors is IEnumerable<string> es && es.Any()){<div class="alert error"><strong>خطاها:</strong><ul>@foreach(var x in es){<li>@x</li>}</ul></div>}<div class="card"><a class="btn btn-outline" href="/Employees/Template">دانلود قالب استاندارد اکسل</a><hr><form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="file" name="file" accept=".xlsx,.xls"><button class="btn btn-main">بارگذاری و پردازش</button></form></div>