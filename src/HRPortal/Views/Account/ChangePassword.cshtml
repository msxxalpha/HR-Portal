@model HRPortal.Controllers.AccountController.ChangePasswordVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تغییر رمز عبور مدیر";
}
<div class="narrow-page">
    <div class="page-head">
        <div><h1>تغییر رمز عبور مدیر</h1><p>رمز عبور حساب مدیر سامانه را تغییر دهید.</p></div>
    </div>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert error">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        { <div>@e.ErrorMessage</div> }
        </div>
    }
    <div class="card">
        <form method="post" class="form-stack">
            @Html.AntiForgeryToken()
            <label>رمز عبور فعلی<input asp-for="CurrentPassword" type="password" autocomplete="current-password" required /></label>
            <label>رمز عبور جدید<input asp-for="NewPassword" type="password" autocomplete="new-password" required /></label>
            <label>تکرار رمز عبور جدید<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required /></label>
            <div class="note">رمز عبور جدید باید حداقل ۸ کاراکتر داشته باشد.</div>
            <div class="form-actions"><button class="btn btn-main" type="submit">ذخیره رمز جدید</button></div>
        </form>
    </div>
</div>