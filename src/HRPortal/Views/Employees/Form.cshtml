@model HRPortal.Controllers.EmployeesController.FormVm
@{var edit=Model.Employee.Id>0;ViewData["Title"]=edit?"ویرایش کارمند":"کارمند جدید";}
<div class="page-head"><div><h1>@ViewData["Title"]</h1></div><a class="btn btn-outline" href="/Employees">بازگشت</a></div>
<form method="post" asp-action="@(edit?"Edit":"Create")"><input type="hidden" asp-for="Employee.Id">@Html.AntiForgeryToken()<div class="card"><div class="grid-3"><label>شماره پرسنلی*<input asp-for="Employee.PersonnelNumber" required></label><label>کد ملی*<input asp-for="Employee.NationalId" required></label><label>نام*<input asp-for="Employee.FirstName" required></label><label>نام خانوادگی*<input asp-for="Employee.LastName" required></label><label>موبایل*<input asp-for="Employee.Mobile" required></label><label>جنسیت*<select asp-for="Employee.Gender" required><option value="">انتخاب</option><option>مرد</option><option>زن</option></select></label><label>واحد سازمانی<select asp-for="Employee.OrganizationUnitId"><option value="">انتخاب</option>@foreach(var n in Model.Units){<option value="@n.Id">@n.Title (@n.Code)</option>}</select></label><label>اداره<select asp-for="Employee.OrganizationDepartmentId"><option value="">انتخاب</option>@foreach(var n in Model.Departments){<option value="@n.Id">@n.Title (@n.Code)</option>}</select></label><label>بخش<select asp-for="Employee.OrganizationSectionId"><option value="">انتخاب</option>@foreach(var n in Model.Sections){<option value="@n.Id">@n.Title (@n.Code)</option>}</select></label><label>سمت<input asp-for="Employee.PositionTitle"></label><label>نوع استخدام<input asp-for="Employee.EmploymentType"></label><label>ایمیل<input asp-for="Employee.Email"></label><label>نام پدر<input asp-for="Employee.FatherName"></label><label>وضعیت<select asp-for="Employee.Status"><option>فعال</option><option>غیرفعال</option></select></label></div></div><div class="form-actions"><button class="btn btn-main">ذخیره</button></div></form>