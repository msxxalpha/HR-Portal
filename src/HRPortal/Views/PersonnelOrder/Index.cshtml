@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "حکم کارگزینی";
}
<div class="page-head">
    <div>
        <h1>حکم کارگزینی</h1>
        <p>شناسه آخرین حکم کارگزینی به صورت خودکار از کوئری «حکم کارگزینی» دریافت و برای گزارش SSRS ارسال می‌شود.</p>
    </div>
</div>
@if(ViewBag.Message!=null)
{
    <div class="alert @(ViewBag.MessageType ?? "error")">@ViewBag.Message</div>
}
@if(ViewBag.PersonnelNumber!=null)
{
    <div class="card">
        <div class="report-user-row">
            <div class="report-user">
                <span>کاربر جاری</span>
                <strong>@ViewBag.EmployeeName</strong>
                <small>شماره پرسنلی: @ViewBag.PersonnelNumber</small>
            </div>
        </div>
    </div>
    @if(ViewBag.ReportEndpoint!=null)
    {
        var allowPrint = (bool?)ViewBag.ReportAllowPrint ?? true;
        var allowDownload = (bool?)ViewBag.ReportAllowDownload ?? true;
        var showToolbar = allowPrint || allowDownload;
        <div class="report-container">
            @if (showToolbar)
            {
                <div class="report-toolbar">
                    <div>
                        <strong>ابزارهای گزارش</strong>
                        <span>امکانات نمایش مطابق تنظیمات سامانه فعال شده‌اند.</span>
                    </div>
                    <div class="actions">
                        @if (allowPrint)
                        {
                            <a class="btn btn-outline" href="@Url.Action("Print", "PersonnelOrder")" target="_blank" rel="noopener">چاپ گزارش</a>
                        }
                        @if (allowDownload)
                        {
                            <a class="btn btn-main" href="@Url.Action("Download", "PersonnelOrder")">ذخیره PDF</a>
                        }
                    </div>
                </div>
            }
            <div class="report-frame"><iframe src="@ViewBag.ReportEndpoint#toolbar=0&navpanes=0&scrollbar=1&view=FitH" title="گزارش حکم کارگزینی"></iframe></div>
        </div>
    }
}

@section Scripts
{
    <script>
        (() => {
            const blockProtectedActions = (event) => {
                event.preventDefault();
                event.stopPropagation();
            };

            document.addEventListener("contextmenu", blockProtectedActions, true);

            const isScreenCaptureShortcut = (event) =>
                event.code === "PrintScreen" ||
                event.key === "PrintScreen" ||
                event.keyCode === 44 ||
                (event.metaKey && event.shiftKey && event.code === "KeyS");

            document.addEventListener("keydown", (event) => {
                if (isScreenCaptureShortcut(event)) {
                    blockProtectedActions(event);
                }
            }, true);

            document.addEventListener("keyup", (event) => {
                if (event.code === "PrintScreen" || event.key === "PrintScreen" || event.keyCode === 44) {
                    blockProtectedActions(event);
                }
            }, true);
        })();
    </script>
}
